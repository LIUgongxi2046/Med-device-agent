{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:medical:source-upload-view:1.0.0",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "actor", "tenant_id", "project_id", "item_id", "batch_id", "file_sha256", "size_bytes", "declaration_sha256", "upload_id", "requests"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "actor": {"$ref": "urn:medical:source-uploads:1.0.0#/$defs/Id"},
    "tenant_id": {"$ref": "urn:medical:source-uploads:1.0.0#/$defs/Id"},
    "project_id": {"$ref": "urn:medical:source-uploads:1.0.0#/$defs/Id"},
    "item_id": {"$ref": "urn:medical:source-uploads:1.0.0#/$defs/Id"},
    "batch_id": {"$ref": "urn:medical:source-uploads:1.0.0#/$defs/Id"},
    "file_sha256": {"$ref": "urn:medical:source-uploads:1.0.0#/$defs/Hash"},
    "size_bytes": {"$ref": "urn:medical:source-uploads:1.0.0#/$defs/PositiveUnsigned"},
    "declaration_sha256": {"$ref": "urn:medical:source-uploads:1.0.0#/$defs/Hash"},
    "upload_id": {"$ref": "urn:medical:source-uploads:1.0.0#/$defs/NullableId"},
    "requests": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/Request"}}
  },
  "$defs": {
    "Request": {
      "type": "object", "additionalProperties": false,
      "required": ["operation", "key", "context", "body_sha256", "part_no", "size_bytes", "sha256", "expected_revision"],
      "properties": {
        "operation": {"enum": ["KN-01", "KN-02", "KN-03"]},
        "key": {"$ref": "urn:medical:source-uploads:1.0.0#/$defs/Id"},
        "context": {"$ref": "urn:medical:budgets:1.0.0#/$defs/Context"},
        "body_sha256": {"$ref": "urn:medical:source-uploads:1.0.0#/$defs/Hash"},
        "part_no": {"type": ["integer", "null"], "minimum": 1, "maximum": 4294967295},
        "size_bytes": {"anyOf": [{"$ref": "urn:medical:source-uploads:1.0.0#/$defs/PositiveUnsigned"}, {"type": "null"}]},
        "sha256": {"anyOf": [{"$ref": "urn:medical:source-uploads:1.0.0#/$defs/Hash"}, {"type": "null"}]},
        "expected_revision": {"anyOf": [{"$ref": "urn:medical:source-uploads:1.0.0#/$defs/PositiveUnsigned"}, {"type": "null"}]}
      },
      "oneOf": [
        {"properties": {"operation": {"const": "KN-01"}, "part_no": {"type": "null"}, "size_bytes": {"type": "null"}, "sha256": {"type": "null"}, "expected_revision": {"type": "null"}}},
        {"properties": {"operation": {"const": "KN-02"}, "part_no": {"type": "integer"}, "size_bytes": {"type": "string"}, "sha256": {"type": "string"}, "expected_revision": {"type": "null"}}},
        {"properties": {"operation": {"const": "KN-03"}, "part_no": {"type": "null"}, "size_bytes": {"type": "null"}, "sha256": {"type": "null"}, "expected_revision": {"type": "string"}}}
      ]
    }
  }
}
