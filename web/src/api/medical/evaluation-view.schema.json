{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:medical:evaluation-view:1.0.0",
  "$defs": {
    "Id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f-]{36}$"
    },
    "Read": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "evaluation_id",
        "content_sha256",
        "status",
        "revision",
        "score_history",
        "result",
        "result_sha256",
        "production_eligible",
        "allowed_actions",
        "definition"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "evaluation_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f-]{36}$"
        },
        "content_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "status": {
          "enum": [
            "QUEUED",
            "RUNNING",
            "COMPLETED",
            "FAILED",
            "INSUFFICIENT_EVIDENCE"
          ]
        },
        "revision": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,19}$"
        },
        "score_history": {
          "type": "array",
          "maxItems": 50000,
          "items": {
            "$ref": "urn:medical:evaluation-results:1.0.0#/$defs/Score"
          }
        },
        "result": {
          "anyOf": [
            {
              "$ref": "urn:medical:evaluation-results:1.0.0#/$defs/Result"
            },
            {
              "type": "null"
            }
          ]
        },
        "result_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "production_eligible": {
          "const": false
        },
        "allowed_actions": {
          "type": "array",
          "maxItems": 0
        },
        "definition": {
          "$ref": "urn:medical:evaluation-results:1.0.0#/$defs/Definition"
        }
      }
    },
    "Scores": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "evaluation_id",
        "content_sha256",
        "status",
        "revision",
        "score_history",
        "result",
        "result_sha256",
        "production_eligible",
        "allowed_actions"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "evaluation_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f-]{36}$"
        },
        "content_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "status": {
          "enum": [
            "QUEUED",
            "RUNNING",
            "COMPLETED",
            "FAILED",
            "INSUFFICIENT_EVIDENCE"
          ]
        },
        "revision": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,19}$"
        },
        "score_history": {
          "type": "array",
          "maxItems": 50000,
          "items": {
            "$ref": "urn:medical:evaluation-results:1.0.0#/$defs/Score"
          }
        },
        "result": {
          "anyOf": [
            {
              "$ref": "urn:medical:evaluation-results:1.0.0#/$defs/Result"
            },
            {
              "type": "null"
            }
          ]
        },
        "result_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "production_eligible": {
          "const": false
        },
        "allowed_actions": {
          "type": "array",
          "maxItems": 0
        }
      }
    },
    "Pending": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actor",
        "tenant_id",
        "context",
        "key",
        "operation",
        "target_id",
        "project_id",
        "expected_revision",
        "definition_sha256",
        "body_sha256"
      ],
      "properties": {
        "actor": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f-]{36}$"
        },
        "tenant_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f-]{36}$"
        },
        "context": {
          "$ref": "urn:medical:identity#/$defs/Context"
        },
        "key": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f-]{36}$"
        },
        "operation": {
          "enum": [
            "EV-01",
            "EV-02",
            "EV-03"
          ]
        },
        "target_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid",
              "pattern": "^[0-9a-f-]{36}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "project_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid",
              "pattern": "^[0-9a-f-]{36}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "expected_revision": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,19}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "definition_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "body_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
