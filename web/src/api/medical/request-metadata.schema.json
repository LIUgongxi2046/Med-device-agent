{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:medical:request-metadata:1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["actor", "tenant_id", "operation", "target_id", "resource_id", "scope_id", "key", "context", "body_sha256", "state"],
  "properties": {
    "actor": {"$ref": "#/$defs/Id"},
    "tenant_id": {"$ref": "#/$defs/Id"},
    "operation": {"enum": ["KN-14-S04", "KN-RIGHTS-01", "KN-EXACT-PUBLISH", "KN-14-EXACT", "EX-01", "EX-04"]},
    "target_id": {"$ref": "#/$defs/Id"},
    "resource_id": {"$ref": "#/$defs/Id"},
    "scope_id": {"$ref": "#/$defs/Id"},
    "key": {"$ref": "#/$defs/Id"},
    "context": {"$ref": "urn:medical:projects:1.0.0#/$defs/Context"},
    "body_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "state": {"enum": ["PENDING", "EXPIRED"]}
  },
  "$defs": {"Id": {"type": "string", "format": "uuid", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"}}
}
