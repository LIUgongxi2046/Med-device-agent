{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:medical:framework-form:1.0.0",
  "$defs": {
    "Form": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "description": {
          "type": "string",
          "maxLength": 2000
        },
        "fields": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "key": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,63}$"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "type": {
                "enum": [
                  "TEXT",
                  "NUMBER",
                  "BOOLEAN",
                  "DATE",
                  "SELECT"
                ]
              },
              "required": {
                "type": "boolean"
              },
              "options": {
                "type": "array",
                "maxItems": 40,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120
                }
              }
            },
            "required": [
              "key",
              "label",
              "type",
              "required",
              "options"
            ]
          }
        }
      },
      "required": [
        "schema_version",
        "title",
        "description",
        "fields"
      ]
    },
    "Draft": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "form": {
          "$ref": "#/$defs/Form"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      },
      "required": [
        "form",
        "reason"
      ]
    },
    "Approve": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "content_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "schema_artifact_id": {
          "type": "string",
          "format": "uuid"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      },
      "required": [
        "content_sha256",
        "schema_artifact_id",
        "reason"
      ]
    },
    "Response": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "request_id": {
          "type": "string",
          "format": "uuid"
        },
        "resource_revision": {
          "const": "1"
        },
        "data": {
          "oneOf": [
            {
              "$ref": "#/$defs/View"
            },
            {
              "$ref": "#/$defs/List"
            }
          ]
        }
      },
      "required": [
        "schema_version",
        "request_id",
        "resource_revision",
        "data"
      ]
    },
    "View": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "form_id": {
          "type": "string",
          "format": "uuid"
        },
        "content_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "schema_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "created_by": {
          "type": "string",
          "format": "uuid"
        },
        "status": {
          "enum": [
            "DRAFT",
            "DRAFT_VIEW",
            "PUBLISHED"
          ]
        },
        "form": {
          "$ref": "#/$defs/Form"
        },
        "approval_id": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "form_id",
        "content_sha256",
        "schema_sha256",
        "created_by",
        "status",
        "form"
      ]
    },
    "List": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "items": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "form_id": {
                "type": "string",
                "format": "uuid"
              },
              "content_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "created_by": {
                "type": "string",
                "format": "uuid"
              },
              "created_at": {},
              "status": {
                "enum": [
                  "DRAFT",
                  "PUBLISHED"
                ]
              }
            },
            "required": [
              "form_id",
              "content_sha256",
              "created_by",
              "created_at",
              "status"
            ]
          }
        },
        "limit": {
          "const": 100
        },
        "schema_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "items",
        "limit",
        "schema_sha256"
      ]
    }
  }
}
