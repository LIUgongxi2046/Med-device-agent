  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:prod": "vite build",
    "build:medical": "npm run check:medical-schemas && npm run check:medical-consumers && node --max-old-space-size=4096 node_modules/vite/bin/vite.js build --mode medical",
    "build:stage": "vite build --mode staging",
    "preview": "vite preview",
    "dev:medical": "vite --mode medical --host 127.0.0.1 --port 18083 --strictPort",
    "typecheck:medical": "npm run check:medical-schemas && npm run check:medical-consumers && vue-tsc --noEmit -p tsconfig.medical.json",
    "check:medical-consumers": "node scripts/audit-schema-consumers.mjs",
    "check:medical-schemas": "node scripts/check-medical-schemas.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://gitee.com/y_project/RuoYi-Vue.git"
  },
  "dependencies": {
    "@element-plus/icons-vue": "2.3.2",
    "@js-temporal/polyfill": "0.5.1",
    "@vueup/vue-quill": "1.2.0",
    "@vueuse/core": "14.1.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "axios": "1.20.0",
    "clipboard": "2.0.11",
    "docx-preview": "0.4.1",
    "dompurify": "3.4.17",
    "echarts": "6.1.0",
    "element-plus": "2.13.1",
    "eventsource-parser": "4.1.1",
    "exceljs": "4.4.0",
    "file-saver": "2.0.5",
    "fuse.js": "7.1.0",
    "js-beautify": "1.15.4",
    "js-cookie": "3.0.8",
    "jsencrypt": "3.3.2",
    "json-canonicalize": "3.0.1",
    "json-custom-numbers": "3.1.1",
    "jsonc-parser": "3.3.1",
    "katex": "0.19.0",
    "lossless-json": "4.3.0",
    "markdown-it": "15.0.2",
    "nprogress": "0.2.0",
    "papaparse": "5.7.0",
    "pinia": "3.0.4",
    "pptx-preview": "1.0.7",
    "vue": "3.5.26",
    "vue-cropper": "1.1.1",
