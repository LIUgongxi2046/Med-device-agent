{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"], "types": ["vite/client"], "strict": true,
    "noUncheckedIndexedAccess": true, "exactOptionalPropertyTypes": true,
    "noFallthroughCasesInSwitch": true, "verbatimModuleSyntax": true,
    "allowJs": true, "checkJs": false, "resolveJsonModule": true,
    "skipLibCheck": true, "noEmit": true,
    "baseUrl": ".", "paths": {"@/*": ["src/*"]}
  },
  "include": ["src/api/medical/**/*.ts", "src/views/medical/**/*.vue", "src/views/system/user/profile/**/*.vue", "src/medical.d.ts", "tests/source-file-upload/**/*.ts", "tests/source-file-upload/**/*.vue", "tests/source-reader/**/*.ts", "tests/source-reader/**/*.vue", "tests/request-metadata/**/*.ts", "tests/document-selection/**/*.ts", "tests/document-selection/**/*.vue", "tests/template-fields/**/*.ts", "tests/source-rights/**/*.ts", "node_modules/vue-cropper/shims-vue.d.ts"]
}
