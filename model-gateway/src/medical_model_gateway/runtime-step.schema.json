{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:medical:runtime-step:1.0.0",
  "$defs": {
    "StepEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "execution_kind",
        "tenant_id",
        "project_id",
        "initiator_id",
        "principal_id",
        "task_id",
        "task_revision",
        "run_id",
        "step_id",
        "role_version",
        "snapshot_id",
        "plan_revision",
        "input_manifest_id",
        "budget_revision",
        "trace_id",
        "input_manifest_sha256",
        "agent_release_id",
        "runtime_manifest_sha256",
        "node_kind",
        "action_scope",
        "lease_generation",
        "deadline_at",
        "input"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "execution_kind": {
          "const": "TASK"
        },
        "tenant_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
        },
        "project_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
        },
        "initiator_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
        },
        "principal_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
        },
        "task_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
        },
        "task_revision": {
          "type": "string",
          "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
        },
        "run_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
        },
        "step_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
        },
        "role_version": {
          "type": "string",
          "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
        },
        "snapshot_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
        },
        "plan_revision": {
          "type": "string",
          "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
        },
        "input_manifest_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
        },
        "budget_revision": {
          "type": "string",
          "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
        },
        "trace_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
        },
        "input_manifest_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "agent_release_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
        },
        "runtime_manifest_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "node_kind": {
          "enum": [
            "N00_INPUT_INTEGRITY"
          ]
        },
        "action_scope": {
          "type": "array",
          "uniqueItems": true,
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "lease_generation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "deadline_at": {
          "type": "string",
          "format": "date-time"
        },
        "input": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "artifact_id",
            "sha256",
            "schema_ref"
          ],
          "properties": {
            "artifact_id": {
              "type": "string",
              "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "schema_ref": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          }
        }
      }
    },
    "StepResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "run_id",
        "step_id",
        "input_manifest_sha256",
        "lease_generation",
        "outcome",
        "artifact_ids",
        "candidate_ids",
        "invocation_ids",
        "missing_requirements",
        "error_code",
        "technical_only",
        "node_kind",
        "checked_input_sha256",
        "runtime_manifest_sha256"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "run_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
        },
        "step_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
        },
        "input_manifest_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "lease_generation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "outcome": {
          "const": "SUCCEEDED"
        },
        "artifact_ids": {
          "type": "array",
          "maxItems": 0
        },
        "candidate_ids": {
          "type": "array",
          "maxItems": 0
        },
        "invocation_ids": {
          "type": "array",
          "maxItems": 0
        },
        "missing_requirements": {
          "type": "array",
          "maxItems": 0
        },
        "error_code": {
          "type": "null"
        },
        "technical_only": {
          "const": true
        },
        "node_kind": {
          "const": "N00_INPUT_INTEGRITY"
        },
        "checked_input_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "runtime_manifest_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  }
}
