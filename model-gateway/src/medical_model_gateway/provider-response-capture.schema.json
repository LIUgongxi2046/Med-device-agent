{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:medical:provider-response-capture:1.0.0",
  "$ref": "#/$defs/CaptureArtifact",
  "$defs": {
    "Id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "Hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "Count": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$"
    },
    "BoundedIdentity": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    },
    "Descriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "profile",
        "invocation_id",
        "dispatch_attempt_id",
        "receipt_id",
        "sha256",
        "size_bytes",
        "observed_bytes",
        "canonical_request_body_sha256",
        "request_body_sha256",
        "provider_request_id",
        "request_id_source",
        "http_status",
        "transport_terminal",
        "capture_complete",
        "provider_finish_reason",
        "provider_response_id",
        "response_model",
        "response_eof_observed",
        "content_policy_status"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "profile": {
          "const": "PROVIDER_HTTP_RESPONSE_ENTITY"
        },
        "invocation_id": {
          "$ref": "#/$defs/Id"
        },
        "dispatch_attempt_id": {
          "$ref": "#/$defs/Id"
        },
        "receipt_id": {
          "$ref": "#/$defs/Id"
        },
        "sha256": {
          "$ref": "#/$defs/Hash"
        },
        "size_bytes": {
          "$ref": "#/$defs/Count"
        },
        "observed_bytes": {
          "$ref": "#/$defs/Count"
        },
        "canonical_request_body_sha256": {
          "anyOf": [
            {
              "$ref": "#/$defs/Hash"
            },
            {
              "type": "null"
            }
          ]
        },
        "request_body_sha256": {
          "anyOf": [
            {
              "$ref": "#/$defs/Hash"
            },
            {
              "type": "null"
            }
          ]
        },
        "provider_request_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[!-~]{1,256}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "request_id_source": {
          "enum": [
            "HTTP_X_REQUEST_ID",
            null
          ]
        },
        "http_status": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 100,
              "maximum": 599
            },
            {
              "type": "null"
            }
          ]
        },
        "transport_terminal": {
          "enum": [
            "NOT_STARTED",
            "COMPLETE_EOF",
            "EARLY_CLOSE",
            "BYTE_LIMIT",
            "TIME_LIMIT",
            "TRANSPORT_ERROR",
            "CANCELLED",
            "UNSUPPORTED_ENCODING",
            "FORBIDDEN_PROVIDER_CONTENT"
          ]
        },
        "capture_complete": {
          "type": "boolean"
        },
        "provider_finish_reason": {
          "enum": [
            "stop",
            "length",
            "tool_calls",
            "content_filter",
            "insufficient_system_resource",
            "aborted",
            null
          ]
        },
        "provider_response_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/BoundedIdentity"
            },
            {
              "type": "null"
            }
          ]
        },
        "response_model": {
          "anyOf": [
            {
              "$ref": "#/$defs/BoundedIdentity"
            },
            {
              "type": "null"
            }
          ]
        },
        "response_eof_observed": {
          "type": "boolean"
        },
        "content_policy_status": {
          "enum": [
            "VERIFIED_NO_INTERNAL_REASONING",
            "INCOMPLETE_RESPONSE",
            "FORBIDDEN_INTERNAL_REASONING",
            "UNVERIFIABLE_RESPONSE"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "capture_complete": {
                "const": true
              }
            },
            "required": [
              "capture_complete"
            ]
          },
          "then": {
            "properties": {
              "transport_terminal": {
                "const": "COMPLETE_EOF"
              },
              "response_eof_observed": {
                "const": true
              },
              "content_policy_status": {
                "const": "VERIFIED_NO_INTERNAL_REASONING"
              },
              "canonical_request_body_sha256": {
                "$ref": "#/$defs/Hash"
              },
              "request_body_sha256": {
                "$ref": "#/$defs/Hash"
              },
              "http_status": {
                "type": "integer",
                "minimum": 100,
                "maximum": 599
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "provider_request_id": {
                "type": "null"
              }
            },
            "required": [
              "provider_request_id"
            ]
          },
          "then": {
            "properties": {
              "request_id_source": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "request_id_source": {
                "const": "HTTP_X_REQUEST_ID"
              }
            }
          }
        }
      ]
    },
    "CaptureArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "media_type",
        "encoding",
        "metadata",
        "body_base64"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "media_type": {
          "const": "application/octet-stream"
        },
        "encoding": {
          "const": "base64"
        },
        "metadata": {
          "$ref": "#/$defs/Descriptor"
        },
        "body_base64": {
          "type": "string",
          "maxLength": 44739244,
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
        }
      }
    }
  }
}
