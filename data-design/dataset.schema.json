{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SourceDataset",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "dataset_version", "created_at", "sources", "records"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "dataset_version": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "sources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/source"}},
    "records": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/record"}}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 128},
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["source_id", "source_ref", "owner", "official_url", "publisher_version", "sha256", "size_bytes", "format", "nature", "parent_source_id", "license", "allowed_use", "sensitivity", "retention", "production_status"],
      "properties": {
        "source_id": {"$ref": "#/$defs/id"},
        "source_ref": {"type": "string", "minLength": 1},
        "owner": {"type": "string", "minLength": 1},
        "official_url": {"type": ["string", "null"], "format": "uri"},
        "publisher_version": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/hash"},
        "size_bytes": {"type": "integer", "minimum": 1},
        "format": {"enum": ["PDF", "DOCX", "XLSX", "CSV", "TXT", "MARKDOWN", "PPTX", "DOC_REFERENCE"]},
        "nature": {"enum": ["OFFICIAL_ORIGINAL", "DERIVED_PREVIEW", "DERIVED_TEXT", "PROJECT_SPECIFICATION"]},
        "parent_source_id": {"type": ["string", "null"]},
        "license": {"type": "string", "minLength": 1},
        "allowed_use": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["LOCAL_DESIGN_REVIEW", "LOCAL_PARSER_CHECK", "APPROVED_PRODUCTION", "APPROVED_EXTERNAL_PROCESSING"]}},
        "sensitivity": {"enum": ["PUBLIC", "INTERNAL", "RESTRICTED", "PERSONAL_HEALTH"]},
        "retention": {"type": "string", "minLength": 1},
        "production_status": {"enum": ["PENDING_APPROVAL", "APPROVED", "DISABLED"]}
      }
    },
    "record": {
      "type": "object", "additionalProperties": false,
      "required": ["record_id", "source_id", "source_version", "parse_version", "chunk_id", "section_title", "text", "quote_hash", "locator", "checks", "formal_evidence_eligible"],
      "properties": {
        "record_id": {"$ref": "#/$defs/id"},
        "source_id": {"$ref": "#/$defs/id"},
        "source_version": {"$ref": "#/$defs/hash"},
        "parse_version": {"type": "string", "minLength": 1},
        "chunk_id": {"$ref": "#/$defs/id"},
        "section_title": {"type": "string", "minLength": 1},
        "text": {"type": "string", "minLength": 1},
        "quote_hash": {"$ref": "#/$defs/hash"},
        "locator": {"$ref": "#/$defs/locator"},
        "checks": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "formal_evidence_eligible": {"type": "boolean"}
      }
    },
    "locator": {
      "oneOf": [
        {"$ref": "#/$defs/pdf"}, {"$ref": "#/$defs/docx"}, {"$ref": "#/$defs/xlsx"},
        {"$ref": "#/$defs/csv"}, {"$ref": "#/$defs/text"}, {"$ref": "#/$defs/markdown"}, {"$ref": "#/$defs/pptx"}
      ]
    },
    "pdf": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "page_index", "page_basis", "printed_label", "region"],
      "properties": {
        "kind": {"const": "PDF"}, "page_index": {"type": "integer", "minimum": 0},
        "page_basis": {"enum": ["ORIGINAL", "CONVERTED_PREVIEW"]},
        "printed_label": {"type": ["string", "null"]},
        "region": {"oneOf": [
          {"type": "object", "additionalProperties": false, "required": ["kind"], "properties": {"kind": {"const": "WHOLE_PAGE"}}},
          {"type": "object", "additionalProperties": false, "required": ["kind", "x0", "y0", "x1", "y1", "coordinate_system", "rotation"], "properties": {
            "kind": {"const": "BOX"}, "x0": {"type": "number", "minimum": 0, "maximum": 1}, "y0": {"type": "number", "minimum": 0, "maximum": 1},
            "x1": {"type": "number", "minimum": 0, "maximum": 1}, "y1": {"type": "number", "minimum": 0, "maximum": 1},
            "coordinate_system": {"const": "CROPBOX_TOP_LEFT_NORMALIZED"}, "rotation": {"enum": [0, 90, 180, 270]}
          }}
        ]}
      }
    },
    "docx": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "part", "address"],
      "properties": {
        "kind": {"const": "DOCX"}, "part": {"type": "string", "minLength": 1},
        "address": {"oneOf": [
          {"type": "object", "additionalProperties": false, "required": ["kind", "paragraph_index"], "properties": {"kind": {"const": "PARAGRAPH"}, "paragraph_index": {"type": "integer", "minimum": 0}}},
          {"type": "object", "additionalProperties": false, "required": ["kind", "table_index", "row_index", "column_index"], "properties": {"kind": {"const": "CELL"}, "table_index": {"type": "integer", "minimum": 0}, "row_index": {"type": "integer", "minimum": 0}, "column_index": {"type": "integer", "minimum": 0}}},
          {"type": "object", "additionalProperties": false, "required": ["kind", "node_id", "node_hash", "structural_path"], "properties": {"kind": {"const": "NODE"}, "node_id": {"$ref": "#/$defs/id"}, "node_hash": {"$ref": "#/$defs/hash"}, "structural_path": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 0}}}}
        ]}
      }
    },
    "xlsx": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "sheet_id", "sheet_name", "cell_range", "value_basis", "calculation_artifact_id"],
      "properties": {
        "kind": {"const": "XLSX"}, "sheet_id": {"$ref": "#/$defs/id"}, "sheet_name": {"type": "string", "minLength": 1},
        "cell_range": {"type": "string", "pattern": "^[A-Z]+[1-9][0-9]*(:[A-Z]+[1-9][0-9]*)?$"},
        "value_basis": {"enum": ["LITERAL", "FORMULA", "CACHED_RESULT", "VERIFIED_CALCULATION"]},
        "calculation_artifact_id": {"type": ["string", "null"]}
      }
    },
    "csv": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "table_id", "dialect_version", "record_index", "column_indices", "header_record_count"],
      "properties": {
        "kind": {"const": "CSV"}, "table_id": {"$ref": "#/$defs/id"}, "dialect_version": {"$ref": "#/$defs/id"},
        "record_index": {"type": "integer", "minimum": 0}, "header_record_count": {"type": "integer", "minimum": 0},
        "column_indices": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 0}}
      }
    },
    "text": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "encoding", "newline_policy", "char_start", "char_end", "line_start", "line_end"],
      "properties": {
        "kind": {"const": "TXT"}, "encoding": {"const": "UTF-8"}, "newline_policy": {"const": "PRESERVE"},
        "char_start": {"type": "integer", "minimum": 0}, "char_end": {"type": "integer", "minimum": 1},
        "line_start": {"type": "integer", "minimum": 1}, "line_end": {"type": "integer", "minimum": 1}
      }
    },
    "markdown": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "node_index", "line_start", "line_end", "heading_path"],
      "properties": {
        "kind": {"const": "MARKDOWN"}, "node_index": {"type": "integer", "minimum": 0},
        "line_start": {"type": "integer", "minimum": 1}, "line_end": {"type": "integer", "minimum": 1},
        "heading_path": {"type": "array", "items": {"type": "string"}}
      }
    },
    "pptx": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "slide_id", "slide_index", "shape_id", "paragraph_index", "table_cell"],
      "properties": {
        "kind": {"const": "PPTX"}, "slide_id": {"$ref": "#/$defs/id"}, "slide_index": {"type": "integer", "minimum": 0},
        "shape_id": {"$ref": "#/$defs/id"}, "paragraph_index": {"type": ["integer", "null"], "minimum": 0},
        "table_cell": {"type": ["object", "null"], "additionalProperties": false, "required": ["row_index", "column_index"], "properties": {"row_index": {"type": "integer", "minimum": 0}, "column_index": {"type": "integer", "minimum": 0}}}
      }
    },
    "EvidenceRef": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "tenant_id", "project_id", "source_id", "source_version", "parse_version", "chunk_id", "locator_kind", "locator", "quote_hash", "approval_revision"],
      "properties": {
        "schema_version": {"const": "1.0.0"}, "tenant_id": {"$ref": "#/$defs/id"}, "project_id": {"$ref": "#/$defs/id"},
        "source_id": {"$ref": "#/$defs/id"}, "source_version": {"$ref": "#/$defs/id"}, "parse_version": {"$ref": "#/$defs/id"}, "chunk_id": {"$ref": "#/$defs/id"},
        "locator_kind": {"enum": ["PDF", "DOCX", "XLSX", "CSV", "TXT", "MARKDOWN", "PPTX"]},
        "locator": {"$ref": "#/$defs/locator"}, "quote_hash": {"$ref": "#/$defs/hash"}, "approval_revision": {"$ref": "#/$defs/id"}
      }
    }
  }
}
