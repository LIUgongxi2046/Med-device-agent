{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:medical:task-run-stage:2.0.0",
  "$defs": {
    "Id": {
      "type": "string",
      "format": "uuid"
    },
    "Hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "WorkflowReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "tenant_id",
        "project_id",
        "run_id",
        "input_manifest_id",
        "policy_revision",
        "execution_kind",
        "input_sha256",
        "deadline_epoch_millis",
        "maximum_commands",
        "maximum_steps",
        "maximum_parallel_steps",
        "read_timeout_millis",
        "step_timeout_millis",
        "schedule_timeout_millis",
        "control_task_queue",
        "professional_task_queue"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "tenant_id": {
          "$ref": "#/$defs/Id"
        },
        "project_id": {
          "$ref": "#/$defs/Id"
        },
        "run_id": {
          "$ref": "#/$defs/Id"
        },
        "input_manifest_id": {
          "$ref": "#/$defs/Id"
        },
        "policy_revision": {
          "$ref": "#/$defs/Id"
        },
        "execution_kind": {
          "const": "TASK"
        },
        "input_sha256": {
          "$ref": "#/$defs/Hash"
        },
        "deadline_epoch_millis": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "maximum_commands": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "maximum_steps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "maximum_parallel_steps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "read_timeout_millis": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "step_timeout_millis": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "schedule_timeout_millis": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "control_task_queue": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,199}$"
        },
        "professional_task_queue": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,199}$"
        }
      }
    },
    "Output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "sha256",
        "schema_ref"
      ],
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/Id"
        },
        "sha256": {
          "$ref": "#/$defs/Hash"
        },
        "schema_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "Dispatch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "step_id",
        "action_id",
        "command_id",
        "step_envelope_artifact_id",
        "input_sha256",
        "lease_generation",
        "step_envelope_sha256"
      ],
      "properties": {
        "run_id": {
          "$ref": "#/$defs/Id"
        },
        "step_id": {
          "$ref": "#/$defs/Id"
        },
        "action_id": {
          "$ref": "#/$defs/Id"
        },
        "command_id": {
          "$ref": "#/$defs/Id"
        },
        "step_envelope_artifact_id": {
          "$ref": "#/$defs/Id"
        },
        "input_sha256": {
          "$ref": "#/$defs/Hash"
        },
        "lease_generation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "step_envelope_sha256": {
          "$ref": "#/$defs/Hash"
        }
      }
    },
    "Completion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "step_id",
        "result_artifact_id",
        "input_sha256",
        "result_sha256",
        "lease_generation",
        "status"
      ],
      "properties": {
        "run_id": {
          "$ref": "#/$defs/Id"
        },
        "step_id": {
          "$ref": "#/$defs/Id"
        },
        "result_artifact_id": {
          "$ref": "#/$defs/Id"
        },
        "input_sha256": {
          "$ref": "#/$defs/Hash"
        },
        "result_sha256": {
          "$ref": "#/$defs/Hash"
        },
        "lease_generation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "status": {
          "enum": [
            "SUCCEEDED",
            "WAITING_INPUT",
            "FAILED"
          ]
        }
      }
    },
    "Receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "step_id",
        "input_sha256",
        "lease_generation",
        "status",
        "receipt_id",
        "waiting_item_id",
        "outputs"
      ],
      "properties": {
        "step_id": {
          "$ref": "#/$defs/Id"
        },
        "input_sha256": {
          "$ref": "#/$defs/Hash"
        },
        "lease_generation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "status": {
          "enum": [
            "QUEUED",
            "WAITING_INPUT",
            "SUCCEEDED",
            "FAILED",
            "CANCELLED"
          ]
        },
        "receipt_id": {
          "$ref": "#/$defs/Id"
        },
        "waiting_item_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/Id"
            },
            {
              "type": "null"
            }
          ]
        },
        "outputs": {
          "type": "array",
          "maxItems": 4096,
          "items": {
            "$ref": "#/$defs/Output"
          }
        }
      }
    },
    "Command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command_id",
        "command_sha256",
        "run_id",
        "kind",
        "decision_receipt_id"
      ],
      "properties": {
        "command_id": {
          "$ref": "#/$defs/Id"
        },
        "command_sha256": {
          "$ref": "#/$defs/Hash"
        },
        "run_id": {
          "$ref": "#/$defs/Id"
        },
        "kind": {
          "enum": [
            "RESOLVE_WAITING",
            "REQUEST_CANCEL",
            "TERMINATION_PROOF"
          ]
        },
        "decision_receipt_id": {
          "$ref": "#/$defs/Id"
        }
      }
    },
    "FieldCompletion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "stage_kind",
        "target_kind",
        "run_id",
        "step_id",
        "command_id",
        "input_id",
        "input_sha256",
        "action_id",
        "lease_generation",
        "result_id",
        "result_sha256",
        "producer_receipt_sha256"
      ],
      "properties": {
        "schema_version": {
          "const": "2.0.0"
        },
        "stage_kind": {
          "const": "N03"
        },
        "target_kind": {
          "const": "FIELD_TARGET"
        },
        "run_id": {
          "$ref": "#/$defs/Id"
        },
        "step_id": {
          "$ref": "#/$defs/Id"
        },
        "command_id": {
          "$ref": "#/$defs/Id"
        },
        "input_id": {
          "$ref": "#/$defs/Id"
        },
        "input_sha256": {
          "$ref": "#/$defs/Hash"
        },
        "action_id": {
          "$ref": "#/$defs/Id"
        },
        "lease_generation": {
          "type": "integer",
          "minimum": 1
        },
        "result_id": {
          "$ref": "#/$defs/Id"
        },
        "result_sha256": {
          "$ref": "#/$defs/Hash"
        },
        "producer_receipt_sha256": {
          "$ref": "#/$defs/Hash"
        }
      }
    }
  },
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "operation",
        "reference",
        "stage_kind",
        "command_id"
      ],
      "properties": {
        "schema_version": {
          "const": "2.0.0"
        },
        "operation": {
          "const": "EXECUTE_STAGE"
        },
        "reference": {
          "$ref": "#/$defs/WorkflowReference"
        },
        "stage_kind": {
          "const": "N03"
        },
        "command_id": {
          "$ref": "#/$defs/Id"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "operation",
        "reference",
        "completion"
      ],
      "properties": {
        "schema_version": {
          "const": "2.0.0"
        },
        "operation": {
          "const": "COMMIT_STAGE"
        },
        "reference": {
          "$ref": "#/$defs/WorkflowReference"
        },
        "completion": {
          "$ref": "#/$defs/FieldCompletion"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "operation",
        "reference",
        "stage_kind",
        "command_id"
      ],
      "properties": {
        "schema_version": {
          "const": "2.0.0"
        },
        "operation": {
          "const": "RECOVER_STAGE"
        },
        "reference": {
          "$ref": "#/$defs/WorkflowReference"
        },
        "stage_kind": {
          "const": "N03"
        },
        "command_id": {
          "$ref": "#/$defs/Id"
        }
      }
    }
  ]
}
