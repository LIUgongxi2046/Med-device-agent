<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.medical.persistence.mapper.TenantWatermarkMapper">
    <resultMap id="watermarks" type="com.ruoyi.medical.persistence.TenantWatermarks">
        <constructor>
            <arg column="auth_epoch" javaType="java.math.BigInteger"/>
            <arg column="governance_epoch" javaType="java.math.BigInteger"/>
        </constructor>
    </resultMap>
    <select id="lockCurrentTenant" resultMap="watermarks" useCache="false" flushCache="true">
        SELECT auth_epoch, governance_epoch FROM tenant t FOR UPDATE
    </select>
</mapper>
