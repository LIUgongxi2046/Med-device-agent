<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.medical.persistence.mapper.FormalAgentAcceptanceMapper">
<resultMap id="acceptance" type="com.ruoyi.medical.persistence.mapper.FormalAgentAcceptanceMapper$Acceptance"><constructor><arg column="tenant_id" javaType="java.lang.String"/><arg column="project_id" javaType="java.lang.String"/><arg column="acceptance_id" javaType="java.lang.String"/><arg column="candidate_version_id" javaType="java.lang.String"/><arg column="candidate_sha256" javaType="java.lang.String"/><arg column="evaluation_id" javaType="java.lang.String"/><arg column="evaluation_sha256" javaType="java.lang.String"/><arg column="release_id" javaType="java.lang.String"/><arg column="manifest_sha256" javaType="java.lang.String"/><arg column="content_sha256" javaType="java.lang.String"/><arg column="decision" javaType="java.lang.String"/><arg column="schema_version" javaType="java.lang.String"/><arg column="schema_manifest_sha256" javaType="java.lang.String"/><arg column="created_by" javaType="java.lang.String"/><arg column="created_at" javaType="java.time.LocalDateTime"/><arg column="classification" javaType="java.lang.String"/></constructor></resultMap>
<select id="acceptance" resultMap="acceptance" useCache="false" flushCache="true">SELECT a.* FROM formal_agent_acceptance a JOIN version_registry v ON v.tenant_id=a.tenant_id AND v.version_id=a.acceptance_id AND v.content_sha256=a.content_sha256 AND v.entity_kind='AGENT_PUBLICATION_RECORD' AND v.owner_project_id &lt;=&gt; a.project_id WHERE a.acceptance_id=#{acceptanceId}</select>
<insert id="insertAcceptance">INSERT INTO formal_agent_acceptance(project_id,acceptance_id,candidate_version_id,candidate_sha256,evaluation_id,evaluation_sha256,release_id,manifest_sha256,content_sha256,decision,journal_kind,schema_version,schema_manifest_sha256,created_by,created_at,classification) VALUES(#{projectId},#{acceptanceId},#{candidateVersionId},#{candidateSha256},#{evaluationId},#{evaluationSha256},#{releaseId},#{manifestSha256},#{contentSha256},#{decision},'ACCEPTANCE','1.0.0',#{manifest},#{userId},#{now},#{classification})</insert>
<update id="decideCandidate">UPDATE agent_version SET status=#{status},evaluation_id=#{evaluationId},revision=revision+1,updated_at=#{now} WHERE project_id &lt;=&gt; #{projectId} AND agent_version_id=#{candidateVersionId} AND content_sha256=#{candidateSha256} AND revision=#{expectedRevision} AND status IN ('DRAFT','VALIDATING','EVALUATING','REVIEW_PENDING')</update>
</mapper>
