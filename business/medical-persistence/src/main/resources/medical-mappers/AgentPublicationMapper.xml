<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.medical.persistence.mapper.AgentPublicationMapper">
<resultMap id="Journal" type="com.ruoyi.medical.persistence.mapper.AgentPublicationMapper$Journal"><constructor>
<arg column="tenant_id" javaType="java.lang.String"/>
<arg column="project_id" javaType="java.lang.String"/>
<arg column="record_id" javaType="java.lang.String"/>
<arg column="kind" javaType="java.lang.String"/>
<arg column="resource_id" javaType="java.lang.String"/>
<arg column="operation_id" javaType="java.lang.String"/>
<arg column="idempotency_key" javaType="java.lang.String"/>
<arg column="request_sha256" javaType="java.lang.String"/>
<arg column="request_json" javaType="java.lang.String"/>
<arg column="content_json" javaType="java.lang.String"/>
<arg column="content_sha256" javaType="java.lang.String"/>
<arg column="authorizations_json" javaType="java.lang.String"/>
<arg column="authorizations_sha256" javaType="java.lang.String"/>
<arg column="receipt_json" javaType="java.lang.String"/>
<arg column="receipt_sha256" javaType="java.lang.String"/>
<arg column="audit_id" javaType="java.lang.String"/>
<arg column="event_id" javaType="java.lang.String"/>
<arg column="schema_version" javaType="java.lang.String"/>
<arg column="schema_manifest_sha256" javaType="java.lang.String"/>
<arg column="created_by" javaType="java.lang.String"/>
<arg column="created_at" javaType="java.time.LocalDateTime"/>
<arg column="classification" javaType="java.lang.String"/>
</constructor></resultMap>
<select id="journal" resultMap="Journal" useCache="false" flushCache="true">SELECT * FROM agent_publication_record WHERE record_id=#{recordId}</select>
<select id="journalByKey" resultMap="Journal" useCache="false" flushCache="true">SELECT * FROM agent_publication_record WHERE created_by=#{creatorId} AND kind=#{kind} AND idempotency_key=#{key}</select>
<select id="operation" resultMap="com.ruoyi.medical.persistence.mapper.TenantSelectionMapper.operation" useCache="false" flushCache="true">SELECT operation_id,request_sha256,state,http_status,response_ref,target_id,schema_version,schema_manifest_sha256 FROM operation_record WHERE subject_id=#{creatorId} AND operation_name=#{operationName} AND idempotency_key=#{key} FOR UPDATE</select>
<select id="audit" resultType="java.lang.String" useCache="false" flushCache="true">SELECT resource_ref FROM audit_event WHERE audit_id=#{row.auditId} AND subject_id=#{row.createdBy} AND created_by=#{row.createdBy} AND project_id &lt;=&gt; #{row.projectId} AND action=CONCAT('agent.publication.',LOWER(#{row.kind})) AND request_id=#{row.operationId} AND trace_id=#{row.operationId} AND result='SUCCESS' AND reason_code IS NULL AND schema_version='1.0.0' AND schema_manifest_sha256=#{row.schemaManifest} AND classification=#{row.classification}</select>
<select id="event" resultType="java.lang.String" useCache="false" flushCache="true">SELECT payload FROM outbox_event WHERE event_id=#{row.eventId} AND aggregate_id=#{row.recordId} AND aggregate_revision=1 AND event_type=CONCAT('agent.publication.',LOWER(#{row.kind}))</select>
<insert id="insertJournal">INSERT INTO agent_publication_record(project_id,record_id,kind,resource_id,operation_id,idempotency_key,request_sha256,request_json,content_json,content_sha256,authorizations_json,authorizations_sha256,receipt_json,receipt_sha256,audit_id,event_id,schema_version,schema_manifest_sha256,created_by,created_at,classification) VALUES(#{row.projectId},#{row.recordId},#{row.kind},#{row.resourceId},#{row.operationId},#{row.idempotencyKey},#{row.requestSha256},#{row.requestJson},#{row.contentJson},#{row.contentSha256},#{row.authorizationsJson},#{row.authorizationsSha256},#{row.receiptJson},#{row.receiptSha256},#{row.auditId},#{row.eventId},#{row.schemaVersion},#{row.schemaManifest},#{row.createdBy},#{row.createdAt},#{row.classification})</insert>
<insert id="insertOperation">INSERT INTO operation_record(operation_id,subject_id,operation_name,idempotency_key,request_sha256,state,http_status,response_ref,target_id,schema_version,schema_manifest_sha256,created_by,created_at,classification,revision,updated_at) VALUES(#{row.operationId},#{row.createdBy},#{operationName},#{row.idempotencyKey},#{row.requestSha256},'COMPLETED',201,#{row.receiptJson},#{row.recordId},'1.0.0',#{row.schemaManifest},#{row.createdBy},#{row.createdAt},#{row.classification},1,#{row.createdAt})</insert>
<insert id="insertVersion">INSERT INTO version_registry(version_id,owner_project_id,entity_kind,content_sha256) VALUES(#{versionId},#{projectId},#{entityKind},#{contentHash})</insert>
<insert id="insertHead">INSERT INTO configuration_head(project_id,config_id,kind,name,current_version,status,created_by,created_at,classification,revision,updated_at) VALUES(#{projectId},#{configId},#{headKind},#{name},NULL,'DRAFT',#{userId},#{now},#{classification},1,#{now})</insert>
<insert id="insertAgent">INSERT INTO agent_version(project_id,agent_version_id,agent_id,configuration_kind,name,status,dependency_manifest,limits,evaluation_id,content_sha256,schema_version,schema_manifest_sha256,created_by,created_at,classification,revision,updated_at) VALUES(#{projectId},#{versionId},#{configId},#{headKind},#{name},'DRAFT',#{dependencyManifest},#{limits},NULL,#{contentHash},'1.0.0',#{manifest},#{userId},#{now},#{classification},1,#{now})</insert>
<update id="initializeHead">UPDATE configuration_head SET current_version=#{versionId} WHERE config_id=#{configId} AND kind=#{headKind} AND status='DRAFT' AND current_version IS NULL AND revision=1</update>
<insert id="insertLineage">INSERT INTO lineage_edge(consumer_version_id,upstream_version_id,relation_kind,actor_id,decision_ref,created_at) VALUES(#{versionId},#{upstreamId},#{relation},#{userId},NULL,#{now})</insert>
<resultMap id="Agent" type="com.ruoyi.medical.persistence.mapper.AgentPublicationMapper$Agent"><constructor><arg column="tenant_id" javaType="java.lang.String"/><arg column="project_id" javaType="java.lang.String"/><arg column="agent_id" javaType="java.lang.String"/><arg column="agent_version_id" javaType="java.lang.String"/><arg column="name" javaType="java.lang.String"/><arg column="dependency_manifest" javaType="java.lang.String"/><arg column="limits" javaType="java.lang.String"/><arg column="evaluation_id" javaType="java.lang.String"/><arg column="content_sha256" javaType="java.lang.String"/><arg column="status" javaType="java.lang.String"/><arg column="schema_version" javaType="java.lang.String"/><arg column="schema_manifest_sha256" javaType="java.lang.String"/><arg column="created_by" javaType="java.lang.String"/><arg column="created_at" javaType="java.time.LocalDateTime"/><arg column="classification" javaType="java.lang.String"/><arg column="revision" javaType="java.math.BigInteger"/></constructor></resultMap>
<select id="agent" resultMap="Agent" useCache="false" flushCache="true">SELECT * FROM agent_version WHERE agent_version_id=#{versionId} FOR UPDATE</select>
<select id="version" resultMap="com.ruoyi.medical.persistence.mapper.ArtifactRegistryMapper.version" useCache="false" flushCache="true">SELECT version_id,owner_project_id,entity_kind,content_sha256 FROM version_registry WHERE version_id=#{recordId}</select>
<select id="policyDecision" resultMap="Journal" useCache="false" flushCache="true">SELECT r.* FROM evaluation_acceptance_policy_decision d JOIN agent_publication_record r ON r.tenant_id=d.tenant_id AND r.record_id=d.decision_id WHERE d.draft_id=#{draftId} AND d.draft_resource_id=d.draft_id AND d.draft_kind='POLICY_DRAFT' AND d.decision_kind='POLICY' AND r.kind=d.decision_kind AND r.resource_id=d.draft_id AND d.project_id &lt;=&gt; r.project_id AND d.schema_version=r.schema_version AND d.schema_manifest_sha256=r.schema_manifest_sha256 AND d.created_by=r.created_by AND d.created_at=r.created_at AND d.classification=r.classification</select>
<insert id="insertPolicyDecision">INSERT INTO evaluation_acceptance_policy_decision(project_id,draft_id,draft_resource_id,draft_kind,decision_kind,decision_id,schema_version,schema_manifest_sha256,created_by,created_at,classification) VALUES(#{row.projectId},#{row.resourceId},#{row.resourceId},'POLICY_DRAFT','POLICY',#{row.recordId},#{row.schemaVersion},#{row.schemaManifest},#{row.createdBy},#{row.createdAt},#{row.classification})</insert>
<select id="capabilityAuthor" resultMap="Journal" useCache="false" flushCache="true">SELECT * FROM agent_publication_record WHERE kind='FORMAL_CAPABILITY_AUTHOR' AND resource_id=#{versionId}</select>
<insert id="insertCapability">INSERT INTO capability_version(project_id,capability_version,config_id,configuration_kind,kind,input_schema_ref,output_schema_ref,tool_scope,artifact_digest,content_sha256,status,schema_version,schema_manifest_sha256,created_by,created_at,classification,revision,updated_at) VALUES(#{projectId},#{versionId},#{configId},'CAPABILITY',#{kind},#{inputSchema},#{outputSchema},#{toolScope},#{artifactDigest},#{contentHash},'DRAFT','1.0.0',#{manifest},#{userId},#{now},#{classification},1,#{now})</insert>
<select id="candidateRecords" resultType="java.lang.String" useCache="false" flushCache="true">SELECT record_id FROM agent_publication_record WHERE kind=#{kind}<if test="afterId != null"> AND record_id &gt; #{afterId}</if> ORDER BY record_id LIMIT 51</select>
<select id="packageArtifact" resultMap="com.ruoyi.medical.persistence.mapper.ArtifactRegistryMapper.artifact" useCache="false" flushCache="true">SELECT tenant_id,project_id,artifact_id,artifact_kind,object_ref,object_key,object_version,sha256,size_bytes,media_type,dependency_access_set_id,content_sha256,schema_version,schema_manifest_sha256,classification FROM artifact WHERE artifact_id=#{recordId}</select>
<select id="packageBinding" resultMap="com.ruoyi.medical.persistence.mapper.ArtifactRegistryMapper.binding" useCache="false" flushCache="true">SELECT tenant_id,project_id,artifact_id,resource_kind,resource_id,schema_ref,schema_document_sha256,dependency_access_set_id,dependency_manifest_sha256 FROM artifact_content_binding WHERE artifact_id=#{recordId}</select>
</mapper>
