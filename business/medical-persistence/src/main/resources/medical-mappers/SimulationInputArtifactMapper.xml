<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.medical.persistence.mapper.SimulationInputArtifactMapper">
  <select id="lockFixture" resultType="java.lang.String" useCache="false" flushCache="true">
    SELECT case_receipt_id FROM simulation_fixture_registration WHERE case_id=#{caseId}
      AND model_config_revision=#{configRevision} AND project_id &lt;=&gt; #{projectId} FOR UPDATE
  </select>
  <resultMap id="linkRow" type="com.ruoyi.medical.persistence.SimulationInputArtifactService$Link">
    <constructor>
      <arg column="tenant_id" javaType="java.lang.String"/><arg column="project_id" javaType="java.lang.String"/>
      <arg column="case_id" javaType="java.lang.String"/><arg column="model_config_revision" javaType="java.lang.String"/>
      <arg column="input_source_version" javaType="java.lang.String"/><arg column="input_rights_revision" javaType="java.lang.String"/>
      <arg column="artifact_id" javaType="java.lang.String"/>
    </constructor>
  </resultMap>
  <select id="link" resultMap="linkRow" useCache="false" flushCache="true">
    SELECT tenant_id,project_id,case_id,model_config_revision,input_source_version,input_rights_revision,artifact_id
    FROM simulation_fixture_input_artifact WHERE case_id=#{caseId} AND model_config_revision=#{configRevision}
      AND project_id &lt;=&gt; #{projectId}
  </select>
  <insert id="insertArtifact">
    INSERT INTO artifact(project_id,artifact_id,artifact_kind,object_ref,object_key,object_version,sha256,size_bytes,media_type,
      dependency_access_set_id,content_sha256,schema_version,schema_manifest_sha256,created_by,created_at,classification)
    VALUES(#{projectId},#{artifactId},'SIMULATION_EXACT_INPUT',#{storedObject},#{reference.objectKey},#{reference.objectVersion},
      #{reference.sha256},#{reference.sizeBytes},#{reference.mediaType},#{accessId},#{reference.sha256},'1.0.0',#{schemaHash},#{userId},#{now},#{classification})
  </insert>
  <insert id="insertBinding">
    INSERT INTO artifact_content_binding(project_id,artifact_id,resource_kind,resource_id,schema_ref,schema_document_sha256,
      dependency_access_set_id,dependency_manifest_sha256,created_by,created_at,classification)
    VALUES(#{projectId},#{artifactId},'CONFIGURATION',#{configId},#{schemaRef},#{schemaHash},#{accessId},#{dependencyHash},#{userId},#{now},#{classification})
  </insert>
  <insert id="insertLink">
    INSERT INTO simulation_fixture_input_artifact(project_id,case_id,model_config_revision,input_source_version,input_rights_revision,
      artifact_id,created_by,created_at,classification)
    VALUES(#{projectId},#{caseId},#{configRevision},#{inputSourceVersion},#{inputRightsRevision},#{artifactId},#{userId},#{now},#{classification})
  </insert>
  <resultMap id="operationRow" type="com.ruoyi.medical.persistence.SimulationInputArtifactService$Operation">
    <constructor>
      <arg column="tenant_id" javaType="java.lang.String"/><arg column="actor_id" javaType="java.lang.String"/>
      <arg column="idempotency_key" javaType="java.lang.String"/><arg column="request_sha256" javaType="java.lang.String"/>
      <arg column="receipt_json" javaType="java.lang.String"/><arg column="schema_manifest_sha256" javaType="java.lang.String"/>
      <arg column="schema_version" javaType="java.lang.String"/><arg column="created_by" javaType="java.lang.String"/>
      <arg column="canonical_request_json" javaType="java.lang.String"/><arg column="request_body_sha256" javaType="java.lang.String"/>
    </constructor>
  </resultMap>
  <select id="operation" resultMap="operationRow" useCache="false" flushCache="true">
    SELECT tenant_id,actor_id,idempotency_key,request_sha256,receipt_json,schema_manifest_sha256,schema_version,created_by,canonical_request_json,request_body_sha256
    FROM simulation_input_artifact_operation WHERE actor_id=#{userId} AND idempotency_key=#{key}
  </select>
  <insert id="insertOperation">
    INSERT INTO simulation_input_artifact_operation(actor_id,idempotency_key,request_sha256,receipt_json,
      schema_manifest_sha256,schema_version,created_by,canonical_request_json,request_body_sha256,created_at,classification)
    VALUES(#{userId},#{key},#{requestHash},#{receipt},#{operationSchema},'1.0.0',#{userId},#{canonicalRequest},#{bodyHash},#{now},#{classification})
  </insert>
</mapper>
