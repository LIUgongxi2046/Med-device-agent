<select id="journal" resultMap="Journal" useCache="false" flushCache="true">SELECT tenant_id,project_id,record_id,kind,qualification_id,operation_id,idempotency_key,request_sha256,request_body_sha256,request_json,request_context,request_session,content_json,content_sha256,authorizations_json,authorizations_sha256,receipt_json,receipt_sha256,audit_id,event_id,schema_version,schema_manifest_sha256,created_by,created_at,classification FROM expert_qualification_record WHERE record_id=#{recordId}</select>
