<insert id="insertHead">INSERT INTO expert_qualification_state(project_id,qualification_id,status,revision,decision_id,decision_kind,schema_version,schema_manifest_sha256,created_by,created_at,classification,updated_at) VALUES(#{head.projectId},#{head.qualificationId},#{head.status},#{head.revision},#{head.decisionId},#{head.decisionKind},#{head.schemaVersion},#{head.schemaManifest},#{head.createdBy},#{head.createdAt},#{head.classification},#{head.updatedAt})</insert>
<insert id="insertScoreBinding">INSERT INTO expert_score_binding(project_id,binding_id,binding_sha256,qualification_id,qualification_sha256,approval_id,approval_sha256,evaluation_id,definition_sha256,score_id,score_sha256,sample_id,candidate_id,dimension,repeat_index,scorer_id,score_created_at,schema_version,schema_manifest_sha256,created_by,created_at,classification,record_kind,approval_kind) VALUES(#{binding.projectId},#{binding.bindingId},#{binding.bindingHash},#{binding.qualificationId},#{binding.qualificationHash},#{binding.approvalId},#{binding.approvalHash},#{binding.evaluationId},#{binding.definitionHash},#{binding.scoreId},#{binding.scoreHash},#{binding.sampleId},#{binding.candidateId},#{binding.dimension},#{binding.repeatIndex},#{binding.scorerId},#{binding.scoreCreatedAt},#{binding.schemaVersion},#{binding.schemaManifest},#{binding.createdBy},#{binding.createdAt},#{binding.classification},'SCORE_BIND','APPROVE')</insert>
<insert id="insertScoreAuthority">INSERT INTO expert_score_authority_witness(project_id,score_id,evaluation_id,sample_id,candidate_id,dimension,repeat_index,score_sha256,definition_sha256,original_operation_id,authority_json,authority_sha256,audit_id,event_id,schema_version,schema_manifest_sha256,created_by,created_at,classification) VALUES(#{witness.projectId},#{witness.scoreId},#{witness.evaluationId},#{witness.sampleId},#{witness.candidateId},#{witness.dimension},#{witness.repeatIndex},#{witness.scoreHash},#{witness.definitionHash},#{witness.originalOperationId},#{witness.authorityJson},#{witness.authorityHash},#{witness.auditId},#{witness.eventId},#{witness.schemaVersion},#{witness.schemaManifest},#{witness.createdBy},#{witness.createdAt},#{witness.classification})</insert>
<update id="advanceHead">UPDATE expert_qualification_state SET status=#{status},revision=revision+1,decision_id=#{decisionId},decision_kind=#{decisionKind},updated_at=#{now} WHERE qualification_id=#{qualificationId} AND status=#{previousStatus} AND revision=#{expected} AND decision_id &lt;=&gt; #{previousDecision}</update>
<insert id="saveOperation">INSERT INTO operation_record(operation_id,subject_id,operation_name,idempotency_key,request_sha256,state,http_status,response_ref,target_id,error_code,schema_version,schema_manifest_sha256,created_by,created_at,classification,revision,updated_at) VALUES(#{row.operationId},#{userId},#{operationName},#{row.idempotencyKey},#{row.requestHash},'COMPLETED',201,#{row.receiptJson},#{row.recordId},NULL,'1.0.0',#{row.schemaManifest},#{userId},#{row.createdAt},#{row.classification},1,#{row.createdAt})</insert>
<insert id="saveAudit">INSERT INTO audit_event(project_id,audit_id,subject_id,action,resource_ref,result,reason_code,request_id,trace_id,schema_version,schema_manifest_sha256,created_by,created_at,classification) VALUES(#{row.projectId},#{row.auditId},#{userId},#{eventType},#{payload},'SUCCESS',NULL,#{row.operationId},#{row.operationId},'1.0.0',#{row.schemaManifest},#{userId},#{row.createdAt},#{row.classification})</insert>
<insert id="saveEvent">INSERT INTO outbox_event(event_id,aggregate_id,aggregate_revision,event_type,payload,occurred_at,published_at) VALUES(#{row.eventId},#{row.recordId},1,#{eventType},#{payload},#{row.createdAt},NULL)</insert>
<select id="audit" resultType="java.lang.String" useCache="false" flushCache="true">SELECT resource_ref FROM audit_event WHERE audit_id=#{row.auditId} AND project_id &lt;=&gt; #{row.projectId} AND subject_id=#{creatorId} AND created_by=#{creatorId} AND action=#{eventType} AND result='SUCCESS' AND reason_code IS NULL AND request_id=#{row.operationId} AND trace_id=#{row.operationId} AND schema_version='1.0.0' AND schema_manifest_sha256=#{row.schemaManifest} AND created_at=#{row.createdAt} AND classification=#{row.classification}</select>
<select id="event" resultType="java.lang.String" useCache="false" flushCache="true">SELECT payload FROM outbox_event WHERE event_id=#{row.eventId} AND aggregate_id=#{row.recordId} AND aggregate_revision=1 AND event_type=#{eventType} AND occurred_at=#{row.createdAt}</select>
<insert id="saveScoreAuthorityAudit">INSERT INTO audit_event(project_id,audit_id,subject_id,action,resource_ref,result,reason_code,request_id,trace_id,schema_version,schema_manifest_sha256,created_by,created_at,classification) VALUES(#{witness.projectId},#{witness.auditId},#{userId},'expert.score_authority_recorded',#{payload},'SUCCESS',NULL,#{witness.originalOperationId},#{witness.originalOperationId},'1.0.0',#{witness.schemaManifest},#{userId},#{witness.createdAt},#{witness.classification})</insert>
<insert id="saveScoreAuthorityEvent">INSERT INTO outbox_event(event_id,aggregate_id,aggregate_revision,event_type,payload,occurred_at,published_at) VALUES(#{witness.eventId},#{witness.scoreId},1,'expert.score_authority_recorded',#{payload},#{witness.createdAt},NULL)</insert>
<select id="scoreAuthorityAudit" resultType="java.lang.String" useCache="false" flushCache="true">SELECT resource_ref FROM audit_event WHERE audit_id=#{witness.auditId} AND project_id &lt;=&gt; #{witness.projectId} AND subject_id=#{creatorId} AND created_by=#{creatorId} AND action='expert.score_authority_recorded' AND result='SUCCESS' AND reason_code IS NULL AND request_id=#{witness.originalOperationId} AND trace_id=#{witness.originalOperationId} AND schema_version='1.0.0' AND schema_manifest_sha256=#{witness.schemaManifest} AND created_at=#{witness.createdAt} AND classification=#{witness.classification}</select>
<select id="scoreAuthorityEvent" resultType="java.lang.String" useCache="false" flushCache="true">SELECT payload FROM outbox_event WHERE event_id=#{witness.eventId} AND aggregate_id=#{witness.scoreId} AND aggregate_revision=1 AND event_type='expert.score_authority_recorded' AND occurred_at=#{witness.createdAt}</select>
