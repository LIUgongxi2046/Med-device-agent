<select id="operationById" resultMap="Operation" useCache="false" flushCache="true">SELECT operation_id,request_sha256,state,http_status,response_ref,target_id,schema_version,schema_manifest_sha256 FROM operation_record WHERE operation_id=#{operationId} AND subject_id=#{creatorId} AND created_by=#{creatorId} AND operation_name=#{operationName} AND idempotency_key=#{key} AND error_code IS NULL AND revision=1 AND updated_at=created_at AND created_at=#{row.createdAt} AND classification=#{row.classification}</select>
<select id="originalScoreOperation" resultMap="Operation" useCache="false" flushCache="true">SELECT operation_id,request_sha256,state,http_status,response_ref,target_id,schema_version,schema_manifest_sha256 FROM operation_record WHERE operation_id=#{witness.originalOperationId} AND subject_id=#{creatorId} AND created_by=#{creatorId} AND operation_name='EV-02' AND target_id=#{witness.evaluationId} AND error_code IS NULL AND revision=1 AND created_at=#{witness.createdAt} AND updated_at=created_at AND classification=#{witness.classification}</select>
