        "rights_purpose": {"type": "string", "minLength": 1, "maxLength": 128},
        "rights_status": {"type": "string"},
        "lifecycle_state": {"enum": ["ACTIVE", "DISABLED", "RECYCLED", "PURGE_PENDING", "PURGED"]},
        "lifecycle_revision": {"$ref": "#/$defs/Revision"},
        "last_lifecycle_decision": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/Id"}]},
        "deletion_id": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/Id"}]},
        "deletion_status": {"type": ["string", "null"]},
        "versions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/SourceVersionSummary"}},
