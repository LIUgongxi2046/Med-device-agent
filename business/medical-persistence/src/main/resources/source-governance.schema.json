    "Receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "operation_id", "decision_id", "source_version", "parse_version", "index_version", "decision", "approval_status", "approval_revision", "gate_revision", "actor_id", "decided_at", "current_context"],
