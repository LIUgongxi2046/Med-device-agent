{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:medical:template-applicability:1.0.0",
  "$ref": "#/$defs/Page",
  "$defs": {
    "Query": {
      "type": "object", "additionalProperties": false, "required": ["document_type", "profile_revision", "page", "page_size"],
      "properties": {
        "document_type": {"$ref": "urn:medical:templates:1.0.0#/$defs/DocumentType"},
        "profile_revision": {"$ref": "urn:medical:templates:1.0.0#/$defs/Id"},
        "page": {"type": "integer", "minimum": 1, "maximum": 2147483647},
        "page_size": {"type": "integer", "minimum": 1, "maximum": 100},
        "dataset_watermark": {"$ref": "https://schemas.medical-agent.invalid/1.0.0/backend-design/interfaces.schema.yaml#/$defs/Revision"},
        "filter_sha256": {"$ref": "urn:medical:templates:1.0.0#/$defs/Hash"}
      },
      "allOf": [{"if": {"properties": {"page": {"minimum": 2}}}, "then": {"required": ["dataset_watermark", "filter_sha256"]}}]
    },
    "ConditionResult": {
      "type": "object", "additionalProperties": false,
      "required": ["scope", "target_id", "rule_revision", "engine_revision", "input_keys", "status", "unknown_input_keys"],
      "properties": {
        "scope": {"enum": ["PROFILE", "TEMPLATE", "NODE", "FIELD", "ATTACHMENT"]},
        "target_id": {"$ref": "urn:medical:templates:1.0.0#/$defs/Id"},
        "rule_revision": {"$ref": "urn:medical:templates:1.0.0#/$defs/NullableBasis"},
        "engine_revision": {"type": ["string", "null"]},
        "input_keys": {"$ref": "urn:medical:templates:1.0.0#/$defs/Keys"},
        "status": {"$ref": "urn:medical:templates:1.0.0#/$defs/Applicability"},
        "unknown_input_keys": {"$ref": "urn:medical:templates:1.0.0#/$defs/Keys"}
      }
    },
    "TemplateView": {
      "type": "object", "additionalProperties": false,
      "required": ["template", "applicability", "conditions", "missing_requirements", "dependency_authorizations_sha256"],
      "properties": {
        "template": {
          "type": "object", "additionalProperties": false,
          "required": ["tenant_id", "template_version", "status", "revision", "content", "content_sha256", "base_version", "reason", "authority_grant_id", "authority_revision", "created_by", "created_at", "dependency_refs"],
          "properties": {
            "tenant_id": {"$ref": "urn:medical:template-operations:1.0.0#/$defs/Stored/properties/tenant_id"},
            "template_version": {"$ref": "urn:medical:template-operations:1.0.0#/$defs/Stored/properties/template_version"},
            "status": {"const": "APPROVED"},
            "revision": {"allOf": [{"$ref": "urn:medical:templates:1.0.0#/$defs/Count"}, {"pattern": "^[1-9][0-9]*$"}]},
            "content": {"$ref": "urn:medical:template-operations:1.0.0#/$defs/Stored/properties/content"},
            "content_sha256": {"$ref": "urn:medical:template-operations:1.0.0#/$defs/Stored/properties/content_sha256"},
            "base_version": {"$ref": "urn:medical:template-operations:1.0.0#/$defs/Stored/properties/base_version"},
            "reason": {"$ref": "urn:medical:template-operations:1.0.0#/$defs/Stored/properties/reason"},
            "authority_grant_id": {"$ref": "urn:medical:template-operations:1.0.0#/$defs/Stored/properties/authority_grant_id"},
            "authority_revision": {"$ref": "urn:medical:template-operations:1.0.0#/$defs/Stored/properties/authority_revision"},
            "created_by": {"$ref": "urn:medical:template-operations:1.0.0#/$defs/Stored/properties/created_by"},
            "created_at": {"$ref": "urn:medical:template-operations:1.0.0#/$defs/Stored/properties/created_at"},
            "dependency_refs": {"$ref": "urn:medical:template-operations:1.0.0#/$defs/Stored/properties/dependency_refs"}
          }
        },
        "applicability": {"$ref": "urn:medical:templates:1.0.0#/$defs/Applicability"},
        "conditions": {"type": "array", "items": {"$ref": "#/$defs/ConditionResult"}},
        "missing_requirements": {"type": "array", "items": {"$ref": "https://schemas.medical-agent.invalid/1.0.0/backend-design/resource-details.schema.yaml#/$defs/Requirement"}},
        "dependency_authorizations_sha256": {"$ref": "urn:medical:templates:1.0.0#/$defs/Hash"}
      }
    },
    "Page": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "project_id", "profile_revision", "profile_sha256", "document_type", "items", "missing_requirements", "page_info"],
      "properties": {
        "schema_version": {"const": "1.0.0"},
        "project_id": {"$ref": "urn:medical:templates:1.0.0#/$defs/Id"},
        "profile_revision": {"$ref": "urn:medical:templates:1.0.0#/$defs/Id"},
        "profile_sha256": {"$ref": "urn:medical:templates:1.0.0#/$defs/Hash"},
        "document_type": {"$ref": "urn:medical:templates:1.0.0#/$defs/DocumentType"},
        "items": {"type": "array", "items": {"$ref": "#/$defs/TemplateView"}},
        "missing_requirements": {"type": "array", "items": {"$ref": "https://schemas.medical-agent.invalid/1.0.0/backend-design/resource-details.schema.yaml#/$defs/Requirement"}},
        "page_info": {"$ref": "https://schemas.medical-agent.invalid/1.0.0/backend-design/interfaces.schema.yaml#/$defs/PageInfo"}
      }
    }
  }
}
