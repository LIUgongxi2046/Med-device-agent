{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:medical:task-run-accepted-start:1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "receipt_id",
    "tenant_id",
    "project_id",
    "task_id",
    "run_id",
    "principal_id",
    "initiator_id",
    "command_id",
    "launch_id",
    "temporal_run_id",
    "workflow_acceptance_sha256",
    "reference_sha256",
    "previous_revision",
    "running_revision",
    "started_at"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "kind": {
      "const": "TASK_RUN_ACCEPTED_START"
    },
    "receipt_id": {
      "type": "string",
      "format": "uuid"
    },
    "tenant_id": {
      "type": "string",
      "format": "uuid"
    },
    "project_id": {
      "type": "string",
      "format": "uuid"
    },
    "task_id": {
      "type": "string",
      "format": "uuid"
    },
    "run_id": {
      "type": "string",
      "format": "uuid"
    },
    "principal_id": {
      "type": "string",
      "format": "uuid"
    },
    "initiator_id": {
      "type": "string",
      "format": "uuid"
    },
    "command_id": {
      "type": "string",
      "format": "uuid"
    },
    "launch_id": {
      "type": "string",
      "format": "uuid"
    },
    "temporal_run_id": {
      "type": "string",
      "format": "uuid"
    },
    "workflow_acceptance_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "reference_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "previous_revision": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,19}$"
    },
    "running_revision": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,19}$"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
