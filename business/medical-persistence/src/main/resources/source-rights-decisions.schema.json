{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Id": {"type":"string","format":"uuid","pattern":"^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
    "Hash": {"type":"string","pattern":"^[a-f0-9]{64}$"},
    "Revision": {"type":"string","pattern":"^[1-9][0-9]{0,19}$"},
    "NullableId": {"anyOf":[{"type":"null"},{"$ref":"#/$defs/Id"}]},
    "NullableTime": {"anyOf":[{"type":"null"},{"type":"string","format":"date-time","pattern":"^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$"}]},
    "Names": {"type":"array","uniqueItems":true,"maxItems":128,"items":{"type":"string","minLength":1,"maxLength":128,"pattern":"^[A-Za-z0-9][A-Za-z0-9_.:-]*$"}},
    "Classification": {"enum":["PUBLIC","INTERNAL","RESTRICTED","PERSONAL_HEALTH"]},
    "Basis": {"type":"object","additionalProperties":false,"required":["version_id","content_sha256"],"properties":{"version_id":{"$ref":"#/$defs/Id"},"content_sha256":{"$ref":"#/$defs/Hash"}}},
    "Proposal": {
      "type":"object","additionalProperties":false,
      "required":["purpose","allowed_actions","providers","regions","valid_from","valid_to","evidence_manifest"],
      "properties": {
        "purpose":{"type":"string","pattern":"^[A-Z][A-Z0-9_]{0,127}$"},
        "allowed_actions":{"type":"array","uniqueItems":true,"minItems":2,"maxItems":5,"contains":{"const":"READ"},"items":{"enum":["READ","STORE","ENTERPRISE_USE","DISTRIBUTE","EXTERNAL_PROCESS"]}},
        "providers":{"$ref":"#/$defs/Names"},"regions":{"allOf":[{"$ref":"#/$defs/Names"}],"minItems":1},
        "valid_from":{"$ref":"#/$defs/NullableTime"},"valid_to":{"$ref":"#/$defs/NullableTime"},
        "evidence_manifest": {
          "type":"object","additionalProperties":false,"required":["owner","license","environments","classifications","authorization_evidence"],
          "properties": {
            "owner":{"type":"string","minLength":1,"maxLength":512,"pattern":"\\S"},
            "license":{"type":"string","minLength":1,"maxLength":4096,"pattern":"\\S"},
            "environments":{"allOf":[{"$ref":"#/$defs/Names"}],"minItems":1},
            "classifications":{"type":"array","minItems":1,"maxItems":4,"uniqueItems":true,"items":{"$ref":"#/$defs/Classification"}},
            "authorization_evidence":{"type":"array","minItems":1,"maxItems":64,"uniqueItems":true,"items":{"$ref":"#/$defs/Basis"}}
          }
        }
      }
    },
    "Decision": {"enum":["APPROVE","RETURN","REVOKE"]},
    "PreviewInput": {
      "type":"object","additionalProperties":false,"required":["schema_version","decision","proposal"],
      "properties":{"schema_version":{"const":"1.0.0"},"decision":{"$ref":"#/$defs/Decision"},"proposal":{"anyOf":[{"type":"null"},{"$ref":"#/$defs/Proposal"}]}},
      "allOf":[{"if":{"properties":{"decision":{"const":"APPROVE"}}},"then":{"properties":{"proposal":{"$ref":"#/$defs/Proposal"}}},"else":{"properties":{"proposal":{"type":"null"}}}}]
    },
    "DecisionInput": {
      "type":"object","additionalProperties":false,"required":["schema_version","expected_revision","base_rights","decision","proposal","reviewed_manifest_sha256","reason"],
      "properties":{"schema_version":{"const":"1.0.0"},"expected_revision":{"$ref":"#/$defs/Revision"},"base_rights":{"$ref":"#/$defs/Basis"},"decision":{"$ref":"#/$defs/Decision"},"proposal":{"anyOf":[{"type":"null"},{"$ref":"#/$defs/Proposal"}]},"reviewed_manifest_sha256":{"$ref":"#/$defs/Hash"},"reason":{"type":"string","minLength":1,"maxLength":2000,"pattern":"\\S"}},
      "allOf":[{"if":{"properties":{"decision":{"const":"APPROVE"}}},"then":{"properties":{"proposal":{"$ref":"#/$defs/Proposal"}}},"else":{"properties":{"proposal":{"type":"null"}}}}]
    },
    "Evidence": {
      "type":"object","additionalProperties":false,"required":["artifact","artifact_kind","classification","media_type","size_bytes","schema_ref","schema_document_sha256"],
      "properties":{"artifact":{"$ref":"#/$defs/Basis"},"artifact_kind":{"type":"string","minLength":1,"maxLength":64},"classification":{"$ref":"#/$defs/Classification"},"media_type":{"type":"string","minLength":1,"maxLength":128},"size_bytes":{"$ref":"#/$defs/Revision"},"schema_ref":{"type":"string","minLength":1,"maxLength":2048},"schema_document_sha256":{"$ref":"#/$defs/Hash"}}
    },
    "ObjectRef": {
      "type":"object","additionalProperties":false,"required":["object_key","object_version","sha256","size_bytes","media_type"],
      "properties":{"object_key":{"type":"string","minLength":1,"maxLength":1024},"object_version":{"type":"string","minLength":1,"maxLength":256},"sha256":{"$ref":"#/$defs/Hash"},"size_bytes":{"$ref":"#/$defs/Revision"},"media_type":{"type":"string","minLength":1,"maxLength":128}}
    },
    "Proof": {
      "type":"object","additionalProperties":false,"required":["schema_version","evidence","object_ref","full_sha256","verified_at"],
      "properties":{"schema_version":{"const":"1.0.0"},"evidence":{"$ref":"#/$defs/Evidence"},"object_ref":{"$ref":"#/$defs/ObjectRef"},"full_sha256":{"$ref":"#/$defs/Hash"},"verified_at":{"type":"string","format":"date-time"}}
    },
    "Proofs": {"type":"array","maxItems":64,"items":{"$ref":"#/$defs/Proof"}},
    "Preview": {
      "type":"object","additionalProperties":false,"required":["schema_version","source_id","source_version","owner_project_id","ownership","classification","original_sha256","base_rights","rights_status","revision","decision","proposal","evidence","reviewed_manifest_sha256"],
      "properties":{"schema_version":{"const":"1.0.0"},"source_id":{"$ref":"#/$defs/Id"},"source_version":{"$ref":"#/$defs/Id"},"owner_project_id":{"$ref":"#/$defs/NullableId"},"ownership":{"enum":["ENTERPRISE","PROJECT","SESSION"]},"classification":{"$ref":"#/$defs/Classification"},"original_sha256":{"$ref":"#/$defs/Hash"},"base_rights":{"$ref":"#/$defs/Basis"},"rights_status":{"enum":["PENDING_REVIEW","APPROVED","REVOKED","EXPIRED"]},"revision":{"$ref":"#/$defs/Revision"},"decision":{"$ref":"#/$defs/Decision"},"proposal":{"anyOf":[{"type":"null"},{"$ref":"#/$defs/Proposal"}]},"evidence":{"type":"array","maxItems":64,"items":{"$ref":"#/$defs/Evidence"}},"reviewed_manifest_sha256":{"$ref":"#/$defs/Hash"}}
    },
    "Context": {"type":"object","additionalProperties":false,"required":["tenant_id","context_revision","auth_epoch","governance_epoch"],"properties":{"tenant_id":{"$ref":"#/$defs/Id"},"context_revision":{"$ref":"#/$defs/Revision"},"auth_epoch":{"type":"string","pattern":"^(?:0|[1-9][0-9]{0,19})$"},"governance_epoch":{"type":"string","pattern":"^(?:0|[1-9][0-9]{0,19})$"}}},
    "Receipt": {
      "type":"object","additionalProperties":false,"required":["schema_version","operation_id","decision_id","source_version","base_rights","rights","decision","rights_status","revision","reviewed_manifest_sha256","evidence","actor_id","decided_at","current_context"],
      "properties":{"schema_version":{"const":"1.0.0"},"operation_id":{"$ref":"#/$defs/Id"},"decision_id":{"$ref":"#/$defs/Id"},"source_version":{"$ref":"#/$defs/Id"},"base_rights":{"$ref":"#/$defs/Basis"},"rights":{"$ref":"#/$defs/Basis"},"decision":{"$ref":"#/$defs/Decision"},"rights_status":{"enum":["PENDING_REVIEW","APPROVED","REVOKED","EXPIRED"]},"revision":{"$ref":"#/$defs/Revision"},"reviewed_manifest_sha256":{"$ref":"#/$defs/Hash"},"evidence":{"type":"array","maxItems":64,"items":{"$ref":"#/$defs/Evidence"}},"actor_id":{"$ref":"#/$defs/Id"},"decided_at":{"type":"string","format":"date-time"},"current_context":{"$ref":"#/$defs/Context"}}
    }
  }
}
