{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:medical:simulation-evaluation-start:1.0.0",
  "$defs": {
    "Start": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "project_id",
        "evaluation_id",
        "sample_id",
        "agent_version_id",
        "role_version",
        "model_config_revision",
        "prompt_revision",
        "case_id",
        "enterprise_account_id",
        "retention_policy_id",
        "evaluation_definition_sha256",
        "repeat_index",
        "service_uri",
        "request_parameters",
        "maximum_input_units",
        "maximum_output_units",
        "maximum_calls",
        "parent_maximum_units"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "project_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid",
              "pattern": "^[0-9a-f-]{36}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "evaluation_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f-]{36}$"
        },
        "sample_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f-]{36}$"
        },
        "agent_version_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f-]{36}$"
        },
        "role_version": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f-]{36}$"
        },
        "model_config_revision": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f-]{36}$"
        },
        "prompt_revision": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f-]{36}$"
        },
        "case_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f-]{36}$"
        },
        "enterprise_account_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f-]{36}$"
        },
        "retention_policy_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f-]{36}$"
        },
        "evaluation_definition_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "repeat_index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 99
        },
        "service_uri": {
          "type": "string",
          "format": "uri",
          "minLength": 1,
          "maxLength": 512
        },
        "request_parameters": {
          "type": "object",
          "maxProperties": 256
        },
        "maximum_input_units": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "maximum_output_units": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "maximum_calls": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "parent_maximum_units": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    },
    "Claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "tenant_id",
        "run_id",
        "expected_revision",
        "lease_seconds"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "tenant_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f-]{36}$"
        },
        "run_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f-]{36}$"
        },
        "expected_revision": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,15}$"
        },
        "lease_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        }
      }
    },
    "Issue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "tenant_id",
        "run_id",
        "expected_revision",
        "lifetime_seconds",
        "lease_generation"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "tenant_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f-]{36}$"
        },
        "run_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f-]{36}$"
        },
        "expected_revision": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,15}$"
        },
        "lifetime_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        },
        "lease_generation": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,15}$"
        }
      }
    },
    "EnterpriseQuota": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "enterprise_account_id",
        "maximum_units",
        "maximum_calls"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "enterprise_account_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f-]{36}$"
        },
        "maximum_units": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "maximum_calls": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    },
    "Retention": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "project_id",
        "evaluation_id",
        "retention_policy_id",
        "retain_until",
        "maximum_record_bytes"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "project_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid",
              "pattern": "^[0-9a-f-]{36}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "evaluation_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f-]{36}$"
        },
        "retention_policy_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f-]{36}$"
        },
        "retain_until": {
          "type": "string",
          "format": "date-time"
        },
        "maximum_record_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    },
    "Status": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "tenant_id",
        "run_id"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "tenant_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f-]{36}$"
        },
        "run_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f-]{36}$"
        }
      }
    }
  }
}
