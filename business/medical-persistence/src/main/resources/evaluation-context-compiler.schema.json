{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:medical:evaluation-context-compiler:1.0.0",
  "$defs": {
    "PublishedSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_ref",
        "schema_sha256"
      ],
      "properties": {
        "schema_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "schema_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "ToolPackage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "kind",
        "implementation_id",
        "implementation_version",
        "implementation_class_sha256",
        "input_schema",
        "output_schema",
        "prompt_package_schema",
        "context_mode",
        "tool_mode",
        "upstream_mode"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "kind": {
          "const": "EVALUATION_CONTEXT_ASSEMBLER"
        },
        "implementation_id": {
          "const": "MEDICAL_EVALUATION_DOCUMENT_CONTEXT_V1"
        },
        "implementation_version": {
          "const": "1.0.0"
        },
        "implementation_class_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "input_schema": {
          "$ref": "#/$defs/PublishedSchema"
        },
        "output_schema": {
          "$ref": "#/$defs/PublishedSchema"
        },
        "prompt_package_schema": {
          "$ref": "#/$defs/PublishedSchema"
        },
        "context_mode": {
          "const": "DOCUMENT_ONLY"
        },
        "tool_mode": {
          "const": "NONE"
        },
        "upstream_mode": {
          "const": "NONE"
        }
      }
    },
    "PromptPackage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "system_messages"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "system_messages": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32768
          }
        }
      }
    },
    "CompilationInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document",
        "prompt_package"
      ],
      "properties": {
        "document": {
          "$ref": "urn:medical:formal-evaluation-input:1.0.0#/$defs/Document"
        },
        "prompt_package": {
          "$ref": "#/$defs/PromptPackage"
        }
      }
    }
  }
}
