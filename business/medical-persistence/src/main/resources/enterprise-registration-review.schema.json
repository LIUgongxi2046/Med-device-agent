{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:medical:enterprise-registration-review:1.0.0",
  "$defs": {
    "Id": {"type":"string","format":"uuid","pattern":"^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
    "NullableId": {"oneOf":[{"$ref":"#/$defs/Id"},{"type":"null"}]},
    "Hash": {"type":"string","pattern":"^[0-9a-f]{64}$"},
    "Time": {"type":"string","format":"date-time","pattern":"^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?(Z|\\+00:00)$"},
    "NullableTime": {"oneOf":[{"$ref":"#/$defs/Time"},{"type":"null"}]},
    "GrantInput": {
      "type":"object","additionalProperties":false,"required":["action","condition","valid_to"],
      "properties":{"action":{"enum":["member.manage","role.manage","project.create"]},"condition":{"type":"object"},"valid_to":{"$ref":"#/$defs/NullableTime"}}
    },
    "Request": {
      "type":"object","additionalProperties":false,"required":["schema_version","decision","expected_revision","reason","approval_attested","governance_grants"],
      "properties":{"schema_version":{"const":"1.0.0"},"decision":{"enum":["APPROVE","REJECT"]},"expected_revision":{"const":"1"},
        "reason":{"type":"string","minLength":1,"maxLength":4096},"approval_attested":{"const":true},
        "governance_grants":{"type":"array","maxItems":3,"items":{"$ref":"#/$defs/GrantInput"}}},
      "allOf":[{"if":{"properties":{"decision":{"const":"APPROVE"}}},"then":{"properties":{"governance_grants":{"minItems":1}}}},
        {"if":{"properties":{"decision":{"const":"REJECT"}}},"then":{"properties":{"governance_grants":{"maxItems":0}}}}]
    },
    "Grant": {
      "type":"object","additionalProperties":false,"required":["grant_id","action","condition","valid_from","valid_to","revision"],
      "properties":{"grant_id":{"$ref":"#/$defs/Id"},"action":{"enum":["member.manage","role.manage","project.create"]},
        "condition":{"type":"object"},"valid_from":{"$ref":"#/$defs/Time"},"valid_to":{"$ref":"#/$defs/NullableTime"},"revision":{"const":"1"}}
    },
    "Basis": {
      "type":"object","additionalProperties":false,"required":["version_id","content_sha256"],
      "properties":{"version_id":{"$ref":"#/$defs/Id"},"content_sha256":{"$ref":"#/$defs/Hash"}}
    },
    "Receipt": {
      "type":"object","additionalProperties":false,
      "required":["schema_version","registration_id","operation_id","decision","status","revision","registration_content_sha256","request","decided_by","decided_at","tenant_id","member_id","basis","governance_grants","content_sha256"],
      "properties":{"schema_version":{"const":"1.0.0"},"registration_id":{"$ref":"#/$defs/Id"},"operation_id":{"$ref":"#/$defs/Id"},
        "decision":{"enum":["APPROVE","REJECT"]},"status":{"enum":["APPROVED","REJECTED"]},"revision":{"const":"2"},
        "registration_content_sha256":{"$ref":"#/$defs/Hash"},"request":{"$ref":"#/$defs/Request"},"decided_by":{"$ref":"#/$defs/Id"},
        "decided_at":{"$ref":"#/$defs/Time"},"tenant_id":{"$ref":"#/$defs/NullableId"},"member_id":{"$ref":"#/$defs/NullableId"},
        "basis":{"oneOf":[{"$ref":"#/$defs/Basis"},{"type":"null"}]},"governance_grants":{"type":"array","maxItems":3,"items":{"$ref":"#/$defs/Grant"}},"content_sha256":{"$ref":"#/$defs/Hash"}}
    },
    "Detail": {
      "type":"object","additionalProperties":false,"required":["schema_version","application","review","status","revision"],
      "properties":{"schema_version":{"const":"1.0.0"},"application":{"type":"object"},"review":{"oneOf":[{"$ref":"#/$defs/Receipt"},{"type":"null"}]},
        "status":{"enum":["PENDING_REVIEW","APPROVED","REJECTED"]},"revision":{"enum":["1","2"]}}
    },
    "Page": {
      "type":"object","additionalProperties":false,"required":["schema_version","items","next_cursor"],
      "properties":{"schema_version":{"const":"1.0.0"},"items":{"type":"array","maxItems":100,"items":{"$ref":"#/$defs/Detail"}},"next_cursor":{"$ref":"#/$defs/NullableId"}}
    }
  }
}
