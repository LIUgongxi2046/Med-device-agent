{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:medical:dense-retrieval:1.0.0",
  "$defs": {
    "Configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "project_id",
        "model_revision",
        "mode",
        "dimension",
        "maximum_chunks",
        "maximum_input_bytes",
        "input_price_per_million",
        "price_basis",
        "reason"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "project_id": {
          "type": "string",
          "format": "uuid"
        },
        "model_revision": {
          "type": "string",
          "format": "uuid"
        },
        "mode": {
          "enum": [
            "DENSE",
            "HYBRID"
          ]
        },
        "dimension": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "maximum_chunks": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "maximum_input_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4194304
        },
        "input_price_per_million": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,15})(\\.[0-9]{1,8})?$"
        },
        "price_basis": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "version_id",
            "content_sha256"
          ],
          "properties": {
            "version_id": {
              "type": "string",
              "format": "uuid"
            },
            "content_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      }
    },
    "Build": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "config_revision",
        "source",
        "budget_bases"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "config_revision": {
          "type": "string",
          "format": "uuid"
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source_version",
            "parse_version",
            "snapshot_id",
            "approval_revision",
            "rights_revision",
            "purpose"
          ],
          "properties": {
            "source_version": {
              "type": "string",
              "format": "uuid"
            },
            "parse_version": {
              "type": "string",
              "format": "uuid"
            },
            "snapshot_id": {
              "type": "string",
              "format": "uuid"
            },
            "approval_revision": {
              "type": "string",
              "format": "uuid"
            },
            "rights_revision": {
              "type": "string",
              "format": "uuid"
            },
            "purpose": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]{0,127}$"
            }
          }
        },
        "budget_bases": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "version_id",
              "content_sha256"
            ],
            "properties": {
              "version_id": {
                "type": "string",
                "format": "uuid"
              },
              "content_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        }
      }
    },
    "Search": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "config_revision",
        "index_versions",
        "query",
        "limit",
        "budget_bases"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "config_revision": {
          "type": "string",
          "format": "uuid"
        },
        "index_versions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "query": {
          "type": "string",
          "minLength": 2,
          "maxLength": 500
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500
        },
        "budget_bases": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "version_id",
              "content_sha256"
            ],
            "properties": {
              "version_id": {
                "type": "string",
                "format": "uuid"
              },
              "content_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        }
      }
    }
  }
}
