{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:medical:formal-agent-publication-workflow:1.0.0",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "state",
        "operation_id",
        "release_id",
        "request_body_sha256"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "state": {
          "const": "PROCESSING"
        },
        "operation_id": {
          "type": "string",
          "format": "uuid"
        },
        "release_id": {
          "type": "string",
          "format": "uuid"
        },
        "request_body_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "state",
        "operation_id",
        "release_id",
        "request_body_sha256",
        "artifact_id",
        "manifest_sha256"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "state": {
          "const": "COMPLETED"
        },
        "operation_id": {
          "type": "string",
          "format": "uuid"
        },
        "release_id": {
          "type": "string",
          "format": "uuid"
        },
        "request_body_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "artifact_id": {
          "type": "string",
          "format": "uuid"
        },
        "manifest_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  ]
}
