{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:medical:formal-evaluation-context:1.0.0",
  "$defs": {
    "Id": {
      "type": "string",
      "format": "uuid"
    },
    "Hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "Revision": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,19}$"
    },
    "Reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "Basis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version_id",
        "content_sha256"
      ],
      "properties": {
        "version_id": {
          "$ref": "#/$defs/Id"
        },
        "content_sha256": {
          "$ref": "#/$defs/Hash"
        }
      }
    },
    "Schema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_ref",
        "schema_sha256"
      ],
      "properties": {
        "schema_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "schema_sha256": {
          "$ref": "#/$defs/Hash"
        }
      }
    },
    "Node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node_kind",
        "role",
        "prompt",
        "context_assembler",
        "input_schema",
        "output_schema"
      ],
      "properties": {
        "node_kind": {
          "type": "string",
          "pattern": "^N0[0-9]$"
        },
        "role": {
          "$ref": "#/$defs/Basis"
        },
        "prompt": {
          "$ref": "#/$defs/Basis"
        },
        "context_assembler": {
          "$ref": "#/$defs/Basis"
        },
        "input_schema": {
          "$ref": "#/$defs/Schema"
        },
        "output_schema": {
          "$ref": "#/$defs/Schema"
        }
      }
    },
    "Definition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "project_id",
        "candidate",
        "execution_policy",
        "node_bindings"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "project_id": {
          "$ref": "#/$defs/Id"
        },
        "candidate": {
          "$ref": "#/$defs/Basis"
        },
        "execution_policy": {
          "$ref": "#/$defs/Basis"
        },
        "node_bindings": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "items": {
            "$ref": "#/$defs/Node"
          }
        }
      }
    },
    "Author": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "definition",
        "reason"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "definition": {
          "$ref": "#/$defs/Definition"
        },
        "reason": {
          "$ref": "#/$defs/Reason"
        }
      }
    },
    "Decide": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "binding",
        "expected_revision",
        "decision",
        "reason"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "binding": {
          "$ref": "#/$defs/Basis"
        },
        "expected_revision": {
          "$ref": "#/$defs/Revision"
        },
        "decision": {
          "enum": [
            "APPROVE",
            "REJECT",
            "DISABLE"
          ]
        },
        "reason": {
          "$ref": "#/$defs/Reason"
        }
      }
    },
    "ExecutionStart": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "evaluation_id",
        "definition_sha256",
        "expected_evaluation_revision",
        "candidate",
        "execution_policy",
        "enterprise_budget",
        "parent_budget"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "evaluation_id": {
          "$ref": "#/$defs/Id"
        },
        "definition_sha256": {
          "$ref": "#/$defs/Hash"
        },
        "expected_evaluation_revision": {
          "$ref": "#/$defs/Revision"
        },
        "candidate": {
          "$ref": "#/$defs/Basis"
        },
        "execution_policy": {
          "$ref": "#/$defs/Basis"
        },
        "enterprise_budget": {
          "$ref": "#/$defs/Basis"
        },
        "parent_budget": {
          "$ref": "#/$defs/Basis"
        }
      }
    },
    "BoundStart": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "start",
        "context_binding"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "start": {
          "$ref": "#/$defs/ExecutionStart"
        },
        "context_binding": {
          "$ref": "#/$defs/Basis"
        }
      }
    }
  }
}
