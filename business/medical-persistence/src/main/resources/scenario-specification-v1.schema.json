        "release_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "document_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "expected_revision": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,18})$"
        }
      }
    },
    "Disable": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "publication",
        "expected_revision",
        "reason"
      ],
      "properties": {
        "schema_version": {
