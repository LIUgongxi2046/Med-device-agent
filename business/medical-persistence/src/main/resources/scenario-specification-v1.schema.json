            }
          }
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16000,
          "pattern": ".*\\S.*"
        }
      }
    },
    "Publish": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "specification",
        "review",
        "release_id",
        "document_type",
        "expected_revision"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "specification": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "version_id",
            "content_sha256"
          ],
          "properties": {
            "version_id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            },
