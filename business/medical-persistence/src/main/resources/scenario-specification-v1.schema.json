      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "project_id",
        "title",
        "capability",
        "specification",
        "applicability"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "project_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16000,
          "pattern": ".*\\S.*"
        },
