    "Review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "specification",
        "reason"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "specification": {
          "type": "object",
          "additionalProperties": false,
