{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:medical-agent:customer-connector:1.0.0",
  "title": "Customer connector configuration and execution contract",
  "description": "Application contract only; customer API semantics are supplied and approved separately. Missing inputs or exact-spec adapter produce BLOCKED, never connected.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "connector_id",
    "project_id",
    "expected_revision",
    "interface_spec",
    "account_mapping",
    "ownership_scope",
    "credential_reference_id",
    "credential_revision",
    "expires_at",
    "classification"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "connector_id": {
      "type": "string",
      "format": "uuid"
    },
    "project_id": {
      "type": "string",
      "format": "uuid"
    },
    "expected_revision": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,18})$"
    },
    "interface_spec": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "version",
            "document"
          ],
          "properties": {
            "version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "document": {
              "type": "object",
              "minProperties": 1
            }
          }
        }
      ]
    },
    "account_mapping": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "external_account_id",
              "user_id"
            ],
            "properties": {
              "external_account_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "user_id": {
                "type": "string",
                "format": "uuid"
              }
            }
          }
        }
      ]
    },
    "ownership_scope": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "project_id",
            "external_scope",
            "document_ownership_rules"
          ],
          "properties": {
            "project_id": {
              "type": "string",
              "format": "uuid"
            },
            "external_scope": {
              "type": "object",
              "minProperties": 1
            },
            "document_ownership_rules": {
              "type": "object",
              "minProperties": 1
            }
          }
        }
      ]
    },
    "credential_reference_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "credential_revision": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 128
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "classification": {
      "enum": [
        "PUBLIC",
        "INTERNAL",
        "RESTRICTED",
        "PERSONAL_HEALTH"
      ]
    }
  }
}
