{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:medical:source-processing:1.0.0",
  "$defs": {
    "Id": {"type":"string","format":"uuid","pattern":"^[0-9a-f]{8}-[0-9a-f]{4}-[45][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "Hash": {"type":"string","pattern":"^[0-9a-f]{64}$"},
    "U64": {"type":"string","pattern":"^[1-9][0-9]{0,19}$"},
    "ToolScope": {
      "type":"object","additionalProperties":false,
      "required":["schema_version","tool_id","purpose","input_data_kind","network_enabled","external_process","formats","storage_actions","maximum_source_bytes","maximum_bundle_bytes","timeout_ms","environment","region","index_config_revision"],
      "properties": {
        "schema_version":{"const":"1.0.0"},"tool_id":{"const":"source.parse"},"purpose":{"const":"SOURCE_PROCESSING"},
        "input_data_kind":{"const":"REGISTERED"},"network_enabled":{"const":false},"external_process":{"const":false},
        "formats":{"const":["DOCX","PDF","XLSX","CSV","TXT","MARKDOWN","PPTX"]},
        "storage_actions":{"const":["READ_ORIGINAL","WRITE_PARSED"]},
        "maximum_source_bytes":{"type":"integer","minimum":1,"maximum":104857600},
        "maximum_bundle_bytes":{"type":"integer","minimum":1,"maximum":268435456},
        "timeout_ms":{"type":"integer","minimum":180000,"maximum":900000},
        "environment":{"type":"string","minLength":1},"region":{"type":"string","minLength":1},
        "index_config_revision":{"oneOf":[{"$ref":"#/$defs/Id"},{"type":"null"}]}
      }
    },
    "Command": {
      "type":"object","additionalProperties":false,
      "required":["schema_version","attempt_id","run_id","source_version","parse_version","config_revision","config_sha256","worker_id","lease_generation","format","original_sha256","size_bytes","source_path","catalogue_root","scanner_release_path","scanner_release_sha256","output_directory"],
      "properties": {
        "schema_version":{"const":"1.0.0"},"attempt_id":{"$ref":"#/$defs/Id"},"run_id":{"$ref":"#/$defs/Id"},
        "source_version":{"$ref":"#/$defs/Id"},"parse_version":{"$ref":"#/$defs/Id"},"config_revision":{"$ref":"#/$defs/Id"},
        "config_sha256":{"$ref":"#/$defs/Hash"},"worker_id":{"$ref":"#/$defs/Id"},"lease_generation":{"$ref":"#/$defs/U64"},
        "format":{"enum":["DOCX","PDF","XLSX","CSV","TXT","MARKDOWN","PPTX"]},"original_sha256":{"$ref":"#/$defs/Hash"},
        "size_bytes":{"$ref":"#/$defs/U64"},"source_path":{"type":"string","minLength":1},
        "catalogue_root":{"type":"string","minLength":1},"scanner_release_path":{"type":"string","minLength":1},
        "scanner_release_sha256":{"$ref":"#/$defs/Hash"},"output_directory":{"type":"string","minLength":1}
      }
    },
    "Identity": {
      "type":"object",
      "required":["schema_version","attempt_id","run_id","source_version","parse_version","config_revision","config_sha256","worker_id","lease_generation","original_sha256","command_sha256"],
      "properties": {
        "schema_version":{"const":"1.0.0"},"attempt_id":{"$ref":"#/$defs/Id"},"run_id":{"$ref":"#/$defs/Id"},
        "source_version":{"$ref":"#/$defs/Id"},"parse_version":{"$ref":"#/$defs/Id"},"config_revision":{"$ref":"#/$defs/Id"},
        "config_sha256":{"$ref":"#/$defs/Hash"},"worker_id":{"$ref":"#/$defs/Id"},"lease_generation":{"$ref":"#/$defs/U64"},
        "original_sha256":{"$ref":"#/$defs/Hash"},"command_sha256":{"$ref":"#/$defs/Hash"}
      }
    },
    "Receipt": {
      "allOf":[{"$ref":"#/$defs/Identity"}],"type":"object","unevaluatedProperties":false,
      "required":["status","bundle_path","bundle_sha256","bundle_size_bytes","node_count","chunk_count","issue_count"],
      "properties": {
        "status":{"enum":["COMPLETE","PARTIAL_FAILED"]},"bundle_path":{"type":"string","minLength":1},
        "bundle_sha256":{"$ref":"#/$defs/Hash"},"bundle_size_bytes":{"$ref":"#/$defs/U64"},
        "node_count":{"type":"integer","minimum":1,"maximum":100000},"chunk_count":{"type":"integer","minimum":1,"maximum":100000},
        "issue_count":{"type":"integer","minimum":0,"maximum":100000}
      }
    },
    "Node": {
      "type":"object","additionalProperties":false,
      "required":["node_id","ordinal","node_kind","raw_text","quote_hash","heading_path","locator"],
      "properties": {
        "node_id":{"$ref":"#/$defs/Id"},"ordinal":{"type":"integer","minimum":0,"maximum":99999},
        "node_kind":{"const":"TEXT"},"raw_text":{"type":"string","minLength":1,"maxLength":16000000},
        "quote_hash":{"$ref":"#/$defs/Hash"},"heading_path":{"type":"array","items":{"type":"string"}},
        "locator":{"type":"object"}
      }
    },
    "Chunk": {
      "type":"object","additionalProperties":false,
      "required":["chunk_id","node_id","ordinal","raw_text","search_text","quote_hash","locator"],
      "properties": {
        "chunk_id":{"$ref":"#/$defs/Id"},"node_id":{"$ref":"#/$defs/Id"},
        "ordinal":{"type":"integer","minimum":0,"maximum":99999},"raw_text":{"type":"string","minLength":1,"maxLength":16000000},
        "search_text":{"type":"string","minLength":1,"maxLength":16000000},"quote_hash":{"$ref":"#/$defs/Hash"},"locator":{"type":"object"}
      }
    },
    "Issue": {
      "type":"object","additionalProperties":false,"required":["code","locator"],
      "properties":{"code":{"type":"string","minLength":1,"maxLength":128},"locator":{"type":["object","null"]}}
    },
    "ScanArtifact": {
      "type":"object","additionalProperties":false,"required":["name","sha256","size_bytes","content_base64"],
      "properties":{"name":{"enum":["scan.txt","signature-0.txt","signature-1.txt","signature-2.txt"]},
        "sha256":{"$ref":"#/$defs/Hash"},"size_bytes":{"$ref":"#/$defs/U64"},
        "content_base64":{"type":"string","minLength":4,"maxLength":1398104}}
    },
    "Scan": {
      "type":"object","additionalProperties":false,
      "required":["original_sha256","size_bytes","release_sha256","returncode","artifacts"],
      "properties":{"original_sha256":{"$ref":"#/$defs/Hash"},"size_bytes":{"$ref":"#/$defs/U64"},
        "release_sha256":{"$ref":"#/$defs/Hash"},"returncode":{"const":0},
        "artifacts":{"type":"array","minItems":4,"maxItems":4,"items":{"$ref":"#/$defs/ScanArtifact"}}}
    },
    "Bundle": {
      "allOf":[{"$ref":"#/$defs/Identity"}],"type":"object","unevaluatedProperties":false,
      "required":["status","format","processor_manifest","nodes","chunks","issues","scan"],
      "properties": {
        "status":{"enum":["COMPLETE","PARTIAL_FAILED"]},"format":{"enum":["DOCX","PDF","XLSX","CSV","TXT","MARKDOWN","PPTX"]},
        "processor_manifest":{"type":"object","required":["config_revision","config_sha256","scanner_release_sha256","parameters_json","parameters_sha256","network_enabled","data_kind","chunking_revision"]},
        "nodes":{"type":"array","minItems":1,"maxItems":100000,"items":{"$ref":"#/$defs/Node"}},
        "chunks":{"type":"array","minItems":1,"maxItems":100000,"items":{"$ref":"#/$defs/Chunk"}},
        "issues":{"type":"array","maxItems":100000,"items":{"$ref":"#/$defs/Issue"}},"scan":{"$ref":"#/$defs/Scan"}
      }
    }
  }
}
