{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:medical:source-completion-scan:1.0.0",
  "$ref": "#/$defs/Receipt",
  "$defs": {
    "Id": {"type": "string", "format": "uuid", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
    "Hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "Positive": {"type": "string", "pattern": "^[1-9][0-9]{0,19}$"},
    "Path": {"type": "string", "minLength": 2, "maxLength": 4096, "pattern": "^/"},
    "Command": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "event_id", "operation_id", "upload_id", "worker_id", "lease_generation", "source_path", "original_sha256", "size_bytes", "scanner_release_path", "scanner_release_sha256", "output_directory"],
      "properties": {
        "schema_version": {"const": "1.0.0"}, "event_id": {"$ref": "#/$defs/Id"},
        "operation_id": {"$ref": "#/$defs/Id"}, "upload_id": {"$ref": "#/$defs/Id"},
        "worker_id": {"$ref": "#/$defs/Id"}, "lease_generation": {"$ref": "#/$defs/Positive"},
        "source_path": {"$ref": "#/$defs/Path"}, "original_sha256": {"$ref": "#/$defs/Hash"},
        "size_bytes": {"$ref": "#/$defs/Positive"}, "scanner_release_path": {"$ref": "#/$defs/Path"},
        "scanner_release_sha256": {"$ref": "#/$defs/Hash"}, "output_directory": {"$ref": "#/$defs/Path"}
      }
    },
    "Artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "sha256", "size_bytes", "content_base64"],
      "properties": {
        "name": {"enum": ["scan.txt", "signature-0.txt", "signature-1.txt", "signature-2.txt"]},
        "sha256": {"$ref": "#/$defs/Hash"}, "size_bytes": {"$ref": "#/$defs/Positive"},
        "content_base64": {"type": "string", "minLength": 4, "maxLength": 349528, "pattern": "^[A-Za-z0-9+/]+={0,2}$"}
      }
    },
    "Receipt": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "event_id", "operation_id", "upload_id", "worker_id", "lease_generation", "original_sha256", "size_bytes", "scanner_release_sha256", "command_sha256", "status", "returncode", "format", "format_verified", "artifacts"],
      "properties": {
        "schema_version": {"const": "1.0.0"}, "event_id": {"$ref": "#/$defs/Id"},
        "operation_id": {"$ref": "#/$defs/Id"}, "upload_id": {"$ref": "#/$defs/Id"},
        "worker_id": {"$ref": "#/$defs/Id"}, "lease_generation": {"$ref": "#/$defs/Positive"},
        "original_sha256": {"$ref": "#/$defs/Hash"}, "size_bytes": {"$ref": "#/$defs/Positive"},
        "scanner_release_sha256": {"$ref": "#/$defs/Hash"}, "command_sha256": {"$ref": "#/$defs/Hash"},
        "status": {"const": "SCANNED"}, "returncode": {"const": 0},
        "format": {"enum": ["PDF", "DOCX", "XLSX", "CSV", "PPTX", "MARKDOWN", "TXT"]}, "format_verified": {"const": true},
        "artifacts": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"$ref": "#/$defs/Artifact"}}
      }
    }
  }
}
