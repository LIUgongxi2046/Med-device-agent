{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:medical:task-runtime-journal:1.0.0",
  "$defs": {
    "Id": {
      "type": "string",
      "format": "uuid"
    },
    "Hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "RunIntent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "tenant_id",
        "project_id",
        "task_id",
        "run_id",
        "principal_id",
        "initiator_id",
        "graph_id",
        "graph_sha256",
        "classification",
        "audit_id",
        "event_id",
        "created_at",
        "kind",
        "command_id",
        "command_sha256",
        "intent_id",
        "replay_manifest_id",
        "replay_sha256",
        "replay_object_version",
        "replay_receipt_sha256",
        "replay_write_id",
        "replay_intent_sha256",
        "plan_revision",
        "plan_sha256"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "tenant_id": {
          "$ref": "#/$defs/Id"
        },
        "project_id": {
          "$ref": "#/$defs/Id"
        },
        "task_id": {
          "$ref": "#/$defs/Id"
        },
        "run_id": {
          "$ref": "#/$defs/Id"
        },
        "principal_id": {
          "$ref": "#/$defs/Id"
        },
        "initiator_id": {
          "$ref": "#/$defs/Id"
        },
        "graph_id": {
          "$ref": "#/$defs/Id"
        },
        "graph_sha256": {
          "$ref": "#/$defs/Hash"
        },
        "classification": {
          "enum": [
            "PUBLIC",
            "INTERNAL",
            "RESTRICTED",
            "PERSONAL_HEALTH"
          ]
        },
        "audit_id": {
          "$ref": "#/$defs/Id"
        },
        "event_id": {
          "$ref": "#/$defs/Id"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "kind": {
          "const": "TASK_RUN_RUNTIME_INTENT"
        },
        "command_id": {
          "$ref": "#/$defs/Id"
        },
        "command_sha256": {
          "$ref": "#/$defs/Hash"
        },
        "intent_id": {
          "$ref": "#/$defs/Id"
        },
        "replay_manifest_id": {
          "$ref": "#/$defs/Id"
        },
        "replay_sha256": {
          "$ref": "#/$defs/Hash"
        },
        "replay_object_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "replay_receipt_sha256": {
          "$ref": "#/$defs/Hash"
        },
        "replay_write_id": {
          "$ref": "#/$defs/Id"
        },
        "replay_intent_sha256": {
          "$ref": "#/$defs/Hash"
        },
        "plan_revision": {
          "$ref": "#/$defs/Id"
        },
        "plan_sha256": {
          "$ref": "#/$defs/Hash"
        }
      }
    },
    "StepDispatch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "tenant_id",
        "project_id",
        "task_id",
        "run_id",
        "principal_id",
        "initiator_id",
        "graph_id",
        "graph_sha256",
        "classification",
        "audit_id",
        "event_id",
        "created_at",
        "kind",
        "step_id",
        "lease_generation",
        "command_id",
        "action_id",
        "session_id",
        "input_artifact_id",
        "input_sha256",
        "input_object_version",
        "input_receipt_sha256",
        "envelope_artifact_id",
        "envelope_sha256",
        "envelope_object_version",
        "envelope_receipt_sha256",
        "run_intent_id",
        "run_intent_sha256",
        "worker_service_uri",
        "host_arguments_sha256",
        "host_tool_version"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "tenant_id": {
          "$ref": "#/$defs/Id"
        },
        "project_id": {
          "$ref": "#/$defs/Id"
        },
        "task_id": {
          "$ref": "#/$defs/Id"
        },
        "run_id": {
          "$ref": "#/$defs/Id"
        },
        "principal_id": {
          "$ref": "#/$defs/Id"
        },
        "initiator_id": {
          "$ref": "#/$defs/Id"
        },
        "graph_id": {
          "$ref": "#/$defs/Id"
        },
        "graph_sha256": {
          "$ref": "#/$defs/Hash"
        },
        "classification": {
          "enum": [
            "PUBLIC",
            "INTERNAL",
            "RESTRICTED",
            "PERSONAL_HEALTH"
          ]
        },
        "audit_id": {
          "$ref": "#/$defs/Id"
        },
        "event_id": {
          "$ref": "#/$defs/Id"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "kind": {
          "const": "TASK_STEP_RUNTIME_ATTEMPT"
        },
        "step_id": {
          "$ref": "#/$defs/Id"
        },
        "lease_generation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "command_id": {
          "$ref": "#/$defs/Id"
        },
        "action_id": {
          "$ref": "#/$defs/Id"
        },
        "session_id": {
          "$ref": "#/$defs/Id"
        },
        "input_artifact_id": {
          "$ref": "#/$defs/Id"
        },
        "input_sha256": {
          "$ref": "#/$defs/Hash"
        },
        "input_object_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "input_receipt_sha256": {
          "$ref": "#/$defs/Hash"
        },
        "envelope_artifact_id": {
          "$ref": "#/$defs/Id"
        },
        "envelope_sha256": {
          "$ref": "#/$defs/Hash"
        },
        "envelope_object_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "envelope_receipt_sha256": {
          "$ref": "#/$defs/Hash"
        },
        "run_intent_id": {
          "$ref": "#/$defs/Id"
        },
        "run_intent_sha256": {
          "$ref": "#/$defs/Hash"
        },
        "worker_service_uri": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "host_arguments_sha256": {
          "$ref": "#/$defs/Hash"
        },
        "host_tool_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    }
  }
}
