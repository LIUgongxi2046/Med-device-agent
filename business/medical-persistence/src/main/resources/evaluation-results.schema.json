{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:medical:evaluation-results:1.0.0",
  "$defs": {
    "Basis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version_id",
        "content_sha256"
      ],
      "properties": {
        "version_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f-]{36}$"
        },
        "content_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "Dimension": {
      "enum": [
        "EVAL-01",
        "EVAL-02",
        "EVAL-03",
        "EVAL-04",
        "EVAL-05",
        "EVAL-06",
        "EVAL-07",
        "EVAL-08",
        "EVAL-09",
        "EVAL-10",
        "EVAL-11",
        "EVAL-12"
      ]
    },
    "Sample": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sample_id",
        "source_family",
        "split",
        "document_type",
        "evidence_class",
        "input_ref",
        "expected_ref",
        "expectations"
      ],
      "properties": {
        "sample_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f-]{36}$"
        },
        "source_family": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f-]{36}$"
        },
        "split": {
          "enum": [
            "DEVELOPMENT",
            "TUNING",
            "ACCEPTANCE"
          ]
        },
        "document_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "evidence_class": {
          "enum": [
            "REAL",
            "SIMULATION"
          ]
        },
        "input_ref": {
          "$ref": "#/$defs/Basis"
        },
        "expected_ref": {
          "$ref": "#/$defs/Basis"
        },
        "expectations": {
          "type": "array",
          "minItems": 0,
          "maxItems": 12,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/Expectation"
          }
        }
      }
    },
    "Variance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repeat_count",
        "policy",
        "confidence_interval_method"
      ],
      "properties": {
        "repeat_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "policy": {
          "enum": [
            "ALL_REQUIRED_RUNS"
          ]
        },
        "confidence_interval_method": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "Create": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "project_id",
        "dataset",
        "sample_manifest_artifact",
        "samples",
        "candidates",
        "rule_revision",
        "required_dimensions",
        "variance_policy",
        "authorized_use_evidence",
        "environment",
        "reason"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "project_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid",
              "pattern": "^[0-9a-f-]{36}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "dataset": {
          "$ref": "#/$defs/Basis"
        },
        "sample_manifest_artifact": {
          "$ref": "#/$defs/Basis"
        },
        "samples": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Sample"
          },
          "minItems": 0,
          "maxItems": 100,
          "uniqueItems": true
        },
        "candidates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Basis"
          },
          "minItems": 1,
          "maxItems": 10,
          "uniqueItems": true
        },
        "rule_revision": {
          "$ref": "#/$defs/Basis"
        },
        "required_dimensions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Dimension"
          },
          "minItems": 1,
          "maxItems": 12,
          "uniqueItems": true
        },
        "variance_policy": {
          "$ref": "#/$defs/Variance"
        },
        "authorized_use_evidence": {
          "$ref": "#/$defs/Basis"
        },
        "environment": {
          "enum": [
            "SIMULATION",
            "PRODUCTION"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      }
    },
    "Cell": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sample_id",
        "agent_version_id",
        "dimension",
        "repeat_index"
      ],
      "properties": {
        "sample_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f-]{36}$"
        },
        "agent_version_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f-]{36}$"
        },
        "dimension": {
          "$ref": "#/$defs/Dimension"
        },
        "repeat_index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 99
        }
      }
    },
    "Append": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "expected_revision",
        "definition_sha256",
        "cell",
        "input_ref",
        "output_ref",
        "evidence_refs",
        "numerator",
        "denominator",
        "unknown_count",
        "violation_count",
        "control_numerator",
        "control_denominator",
        "status",
        "supersedes",
        "reason"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "expected_revision": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,19}$"
        },
        "definition_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "cell": {
          "$ref": "#/$defs/Cell"
        },
        "input_ref": {
          "$ref": "#/$defs/Basis"
        },
        "output_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/Basis"
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Basis"
          },
          "minItems": 0,
          "maxItems": 100,
          "uniqueItems": true
        },
        "numerator": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]{0,17})$"
            },
            {
              "type": "null"
            }
          ]
        },
        "denominator": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]{0,17})$"
            },
            {
              "type": "null"
            }
          ]
        },
        "unknown_count": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]{0,17})$"
            },
            {
              "type": "null"
            }
          ]
        },
        "violation_count": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]{0,17})$"
            },
            {
              "type": "null"
            }
          ]
        },
        "control_numerator": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]{0,17})$"
            },
            {
              "type": "null"
            }
          ]
        },
        "control_denominator": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]{0,17})$"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "enum": [
            "SCORED",
            "UNKNOWN",
            "BLOCKED"
          ]
        },
        "supersedes": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid",
              "pattern": "^[0-9a-f-]{36}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      }
    },
    "Finalize": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "expected_revision",
        "definition_sha256"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "expected_revision": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,19}$"
        },
        "definition_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "Candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version_id",
        "content_sha256",
        "agent_id",
        "created_by",
        "dependency_manifest",
        "limits",
        "schema_version",
        "schema_manifest_sha256"
      ],
      "properties": {
        "version_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f-]{36}$"
        },
        "content_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "agent_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f-]{36}$"
        },
        "created_by": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f-]{36}$"
        },
        "dependency_manifest": {
          "type": "object"
        },
        "limits": {
          "type": "object"
        },
        "schema_version": {
          "const": "1.0.0"
        },
        "schema_manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "Definition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "tenant_id",
        "evaluation_id",
        "request",
        "candidate_snapshots",
        "authority_grant_id",
        "authority_revision",
        "created_by",
        "created_at",
        "approved_expectation_samples"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "tenant_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f-]{36}$"
        },
        "evaluation_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f-]{36}$"
        },
        "request": {
          "$ref": "#/$defs/Create"
        },
        "candidate_snapshots": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Candidate"
          },
          "minItems": 1,
          "maxItems": 10,
          "uniqueItems": true
        },
        "authority_grant_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f-]{36}$"
        },
        "authority_revision": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,19}$"
        },
        "created_by": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f-]{36}$"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "approved_expectation_samples": {
          "type": "array",
          "minItems": 0,
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-f-]{36}$"
          }
        }
      }
    },
    "Score": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "score_id",
        "evaluation_id",
        "definition_sha256",
        "rule_revision",
        "observation",
        "scorer_id",
        "authority_grant_id",
        "authority_revision",
        "created_at"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "score_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f-]{36}$"
        },
        "evaluation_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f-]{36}$"
        },
        "definition_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "rule_revision": {
          "$ref": "#/$defs/Basis"
        },
        "observation": {
          "$ref": "#/$defs/Append"
        },
        "scorer_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f-]{36}$"
        },
        "authority_grant_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f-]{36}$"
        },
        "authority_revision": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,19}$"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "CellResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cell",
        "score_id",
        "status",
        "reason",
        "value"
      ],
      "properties": {
        "cell": {
          "$ref": "#/$defs/Cell"
        },
        "score_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid",
              "pattern": "^[0-9a-f-]{36}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "enum": [
            "PASS",
            "FAIL",
            "INSUFFICIENT_EVIDENCE"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "value": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[01]\\.[0-9]{4}$"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "DimensionSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dimension",
        "expected_cells",
        "observed_cells",
        "passed_cells",
        "failed_cells",
        "insufficient_cells"
      ],
      "properties": {
        "dimension": {
          "$ref": "#/$defs/Dimension"
        },
        "expected_cells": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "observed_cells": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "passed_cells": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "failed_cells": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "insufficient_cells": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        }
      }
    },
    "Result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "evaluation_id",
        "definition_sha256",
        "score_set_sha256",
        "effective_scores",
        "cells",
        "dimensions",
        "missing_requirements",
        "verdict",
        "production_eligible"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "evaluation_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f-]{36}$"
        },
        "definition_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "score_set_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "effective_scores": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Score"
          },
          "minItems": 0,
          "maxItems": 10000,
          "uniqueItems": true
        },
        "cells": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CellResult"
          },
          "minItems": 0,
          "maxItems": 10000,
          "uniqueItems": true
        },
        "dimensions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DimensionSummary"
          },
          "minItems": 1,
          "maxItems": 12,
          "uniqueItems": true
        },
        "missing_requirements": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "minItems": 0,
          "maxItems": 100,
          "uniqueItems": true
        },
        "verdict": {
          "enum": [
            "PASS",
            "FAIL",
            "INSUFFICIENT_EVIDENCE"
          ]
        },
        "production_eligible": {
          "const": false
        }
      }
    },
    "Receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "operation_id",
        "evaluation_id",
        "definition_sha256",
        "revision",
        "status",
        "score_id",
        "result_sha256",
        "verdict",
        "production_eligible"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "operation_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f-]{36}$"
        },
        "evaluation_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f-]{36}$"
        },
        "definition_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "revision": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,19}$"
        },
        "status": {
          "enum": [
            "QUEUED",
            "RUNNING",
            "COMPLETED",
            "FAILED",
            "INSUFFICIENT_EVIDENCE"
          ]
        },
        "score_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid",
              "pattern": "^[0-9a-f-]{36}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "result_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "verdict": {
          "anyOf": [
            {
              "enum": [
                "PASS",
                "FAIL",
                "INSUFFICIENT_EVIDENCE"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "production_eligible": {
          "const": false
        }
      }
    },
    "Expectation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dimension",
        "applicable_item_ids",
        "control_item_ids"
      ],
      "properties": {
        "dimension": {
          "$ref": "#/$defs/Dimension"
        },
        "applicable_item_ids": {
          "type": "array",
          "minItems": 0,
          "maxItems": 1000,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "control_item_ids": {
          "type": "array",
          "minItems": 0,
          "maxItems": 1000,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        }
      }
    },
    "SampleManifest": {
      "type": "array",
      "minItems": 0,
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/Sample"
      }
    },
    "ExpectedItems": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "sample_id",
        "source_family",
        "document_type",
        "input_ref",
        "expectations"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "sample_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f-]{36}$"
        },
        "source_family": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f-]{36}$"
        },
        "document_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "input_ref": {
          "$ref": "#/$defs/Basis"
        },
        "expectations": {
          "type": "array",
          "minItems": 0,
          "maxItems": 12,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/Expectation"
          }
        }
      }
    }
  }
}
