          }
        },
        "manifest": {
          "$ref": "#/$defs/AgentReleaseManifest"
        },
        "manifest_sha256": {
          "$ref": "#/$defs/Hash"
        },
        "decision": {
          "const": "ACCEPT"
        },
        "accepted_by": {
          "$ref": "#/$defs/Id"
        },
        "accepted_at": {
          "type": "string",
