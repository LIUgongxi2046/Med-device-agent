    "Accept": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "candidate",
        "evaluation",
        "statistics_policy",
        "decision",
        "reason",
        "score_bindings",
        "expected_revision"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "candidate": {
          "$ref": "#/$defs/VersionRef"
        },
        "evaluation": {
          "$ref": "#/$defs/VersionRef"
        },
        "statistics_policy": {
          "$ref": "#/$defs/VersionRef"
        },
        "decision": {
          "enum": [
            "ACCEPT",
            "REJECT"
          ]
        },
        "reason": {
          "$ref": "#/$defs/Reason"
        },
        "score_bindings": {
          "type": "array",
          "minItems": 0,
          "maxItems": 50000,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/VersionRef"
          }
        },
        "expected_revision": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,19}$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "decision": {
                "const": "ACCEPT"
              }
            }
          },
          "then": {
            "properties": {
              "score_bindings": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "QualifiedScore": {
      "type": "object",
      "additionalProperties": false,
