{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:medical:task-strict-field-input:2.0.0",
  "title": "N03 fixed input; nested target is additionally validated by task-field-target TargetManifest; typed Java records close source, permission and predecessor members.",
  "$defs": {
    "Basis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version_id",
        "content_sha256"
      ],
      "properties": {
        "version_id": {
          "type": "string",
          "format": "uuid"
        },
        "content_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "node_kind",
    "tenant_id",
    "project_id",
    "task_id",
    "run_id",
    "step_id",
    "input_id",
    "graph_id",
    "graph_sha256",
    "replay_sha256",
    "plan_revision",
    "plan_sha256",
    "snapshot_id",
    "role_version",
    "execution_policy_version",
    "tool_version",
    "target_artifact_id",
    "target_object",
    "target_registration_sha256",
    "target_manifest",
    "target_input_capability",
    "target_input_decision",
    "policies",
    "fixed_sources",
    "node_permissions",
    "predecessors"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0.0"
    },
    "node_kind": {
      "const": "N03"
    },
    "tenant_id": {
      "type": "string",
      "format": "uuid"
    },
    "project_id": {
      "type": "string",
      "format": "uuid"
    },
    "task_id": {
      "type": "string",
      "format": "uuid"
    },
    "run_id": {
      "type": "string",
      "format": "uuid"
    },
    "step_id": {
      "type": "string",
      "format": "uuid"
    },
    "input_id": {
      "type": "string",
      "format": "uuid"
    },
    "graph_id": {
      "type": "string",
      "format": "uuid"
    },
    "graph_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "replay_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "plan_revision": {
      "type": "string",
      "format": "uuid"
    },
    "plan_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "snapshot_id": {
      "type": "string",
      "format": "uuid"
    },
    "role_version": {
      "$ref": "#/$defs/Basis"
    },
    "execution_policy_version": {
      "$ref": "#/$defs/Basis"
    },
    "tool_version": {
      "$ref": "#/$defs/Basis"
    },
    "target_artifact_id": {
      "type": "string",
      "format": "uuid"
    },
    "target_object": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "object_key",
        "object_version",
        "sha256",
        "size_bytes",
        "media_type"
      ],
      "properties": {
        "object_key": {
          "type": "string",
          "minLength": 1
        },
        "object_version": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "size_bytes": {
          "type": "string",
          "minLength": 1
        },
        "media_type": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "target_registration_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "target_manifest": {
      "type": "object"
    },
    "target_input_capability": {
      "$ref": "#/$defs/Basis"
    },
    "target_input_decision": {
      "$ref": "#/$defs/Basis"
    },
    "policies": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "entry_id",
          "policy",
          "source_context"
        ],
        "properties": {
          "entry_id": {
            "type": "string",
            "format": "uuid"
          },
          "policy": {
            "$ref": "#/$defs/Basis"
          },
          "source_context": {
            "anyOf": [
              {
                "$ref": "#/$defs/Basis"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    "fixed_sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "uniqueItems": true
    },
    "node_permissions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "uniqueItems": true
    },
    "predecessors": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "uniqueItems": true
    }
  }
}
