{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:medical:task-professional-package:2.0.0",
  "$defs": {
    "PromptPackage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "node_kind",
        "system_instructions",
        "input_encoding"
      ],
      "properties": {
        "schema_version": {
          "const": "2.0.0"
        },
        "node_kind": {
          "const": "N02"
        },
        "system_instructions": {
          "type": "string",
          "minLength": 1,
          "maxLength": 262144
        },
        "input_encoding": {
          "const": "TASK_NODE_INPUT_WITH_REGISTERED_PREDECESSORS_V2"
        }
      }
    },
    "ProfilePackage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "node_kind",
        "profile_name",
        "projection",
        "system_prefix",
        "files",
        "adapter_artifact"
      ],
      "properties": {
        "schema_version": {
          "const": "2.0.0"
        },
        "node_kind": {
          "const": "N02"
        },
        "profile_name": {
          "const": "medical-agent"
        },
        "projection": {
          "const": "TEXT_SYSTEM_USER_WITH_REGISTERED_PREDECESSORS_V2"
        },
        "system_prefix": {
          "type": "string",
          "maxLength": 262144
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "relative",
              "sha256",
              "size_bytes"
            ],
            "properties": {
              "relative": {
                "type": "string",
                "pattern": "^profiles/[^\\\\]+$",
                "maxLength": 1024
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "size_bytes": {
                "type": "string",
                "pattern": "^[1-9][0-9]{0,7}$"
              }
            }
          }
        },
        "adapter_artifact": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "artifact_id",
            "sha256",
            "size_bytes",
            "media_type"
          ],
          "properties": {
            "artifact_id": {
              "type": "string",
              "format": "uuid"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "size_bytes": {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,7}$"
            },
            "media_type": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          }
        }
      }
    }
  }
}
