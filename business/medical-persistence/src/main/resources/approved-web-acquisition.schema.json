{
 "$schema":"https://json-schema.org/draft/2020-12/schema",
 "$id":"urn:medical:approved-web-acquisition:1.0.0",
 "title":"ApprovedWebAcquisition",
 "description":"Exact approved query and domain acquisition; successful capture is never formal source approval.",
 "type":"object","additionalProperties":false,
 "required":["schema_version","project_id","question_id","query","domains","maximum_results","credential_reference_id","credential_revision","purpose","expires_at","classification"],
 "properties":{
  "schema_version":{"const":"1.0.0"},"project_id":{"type":"string","format":"uuid"},"question_id":{"type":"string","format":"uuid"},
  "query":{"type":"string","minLength":1,"maxLength":2000},"domains":{"type":"array","minItems":1,"maxItems":10,"uniqueItems":true,"items":{"type":"string","maxLength":253}},
  "maximum_results":{"type":"integer","minimum":1,"maximum":10},"credential_reference_id":{"type":"string","format":"uuid"},"credential_revision":{"type":"string","minLength":1,"maxLength":128},
  "purpose":{"const":"WEB_ACQUISITION"},"expires_at":{"type":"string","format":"date-time"},"classification":{"enum":["PUBLIC","INTERNAL","RESTRICTED","PERSONAL_HEALTH"]}
 }
}
