{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:medical:budgets:1.0.0",
  "$defs":{
    "Id":{"type":"string","format":"uuid","pattern":"^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
    "NullableId":{"anyOf":[{"$ref":"#/$defs/Id"},{"type":"null"}]},
    "Revision":{"type":"string","pattern":"^(0|[1-9][0-9]{0,19})$"},
    "Money":{"type":"string","pattern":"^(0|[1-9][0-9]{0,15})(\\.[0-9]{1,8})?$"},
    "Currency":{"type":"string","pattern":"^[A-Z]{3}$"},
    "Hash":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "Time":{"type":"string","format":"date-time","pattern":"^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"},
    "Reason":{"type":"string","minLength":1,"maxLength":2000},
    "Basis":{"type":"object","additionalProperties":false,"required":["version_id","content_sha256"],"properties":{"version_id":{"$ref":"#/$defs/Id"},"content_sha256":{"$ref":"#/$defs/Hash"}}},
    "Limits":{"type":"object","additionalProperties":false,"required":["amount","tokens","calls","research_rounds","revision_rounds","deadline_at"],"properties":{"amount":{"$ref":"#/$defs/Money"},"tokens":{"$ref":"#/$defs/Revision"},"calls":{"$ref":"#/$defs/Revision"},"research_rounds":{"$ref":"#/$defs/Revision"},"revision_rounds":{"$ref":"#/$defs/Revision"},"deadline_at":{"$ref":"#/$defs/Time"}}},
    "Create":{"type":"object","additionalProperties":false,"required":["schema_version","project_id","currency","limits","approval_basis","reason","approval_attested"],"properties":{"schema_version":{"const":"1.0.0"},"project_id":{"$ref":"#/$defs/NullableId"},"currency":{"$ref":"#/$defs/Currency"},"limits":{"$ref":"#/$defs/Limits"},"approval_basis":{"$ref":"#/$defs/Basis"},"reason":{"$ref":"#/$defs/Reason"},"approval_attested":{"const":true}}},
    "Decide":{"type":"object","additionalProperties":false,"required":["schema_version","expected_revision","based_on_budget_revision","currency","limits","approval_basis","reason","approval_attested"],"properties":{"schema_version":{"const":"1.0.0"},"expected_revision":{"$ref":"#/$defs/Revision"},"based_on_budget_revision":{"$ref":"#/$defs/Id"},"currency":{"$ref":"#/$defs/Currency"},"limits":{"$ref":"#/$defs/Limits"},"approval_basis":{"$ref":"#/$defs/Basis"},"reason":{"$ref":"#/$defs/Reason"},"approval_attested":{"const":true}}},
    "Approval":{"type":"object","additionalProperties":false,"required":["schema_version","tenant_id","project_id","budget_id","currency","limits","approval_basis","approver_id","reason","authority_grant_id","authority_revision","based_on_budget_revision"],"properties":{"schema_version":{"const":"1.0.0"},"tenant_id":{"$ref":"#/$defs/Id"},"project_id":{"$ref":"#/$defs/NullableId"},"budget_id":{"$ref":"#/$defs/Id"},"currency":{"$ref":"#/$defs/Currency"},"limits":{"$ref":"#/$defs/Limits"},"approval_basis":{"$ref":"#/$defs/Basis"},"approver_id":{"$ref":"#/$defs/Id"},"reason":{"$ref":"#/$defs/Reason"},"authority_grant_id":{"$ref":"#/$defs/Id"},"authority_revision":{"$ref":"#/$defs/Revision"},"based_on_budget_revision":{"$ref":"#/$defs/NullableId"}}},
    "Account":{"type":"object","additionalProperties":false,"required":["schema_version","tenant_id","project_id","budget_id","budget_revision","currency","spent","reserved","spent_tokens","reserved_tokens","spent_calls","reserved_calls","approval","content_sha256","approver_id","approved_at","created_by","created_at","updated_at","revision","allowed_actions"],"properties":{"schema_version":{"const":"1.0.0"},"tenant_id":{"$ref":"#/$defs/Id"},"project_id":{"$ref":"#/$defs/NullableId"},"budget_id":{"$ref":"#/$defs/Id"},"budget_revision":{"$ref":"#/$defs/Id"},"currency":{"$ref":"#/$defs/Currency"},"spent":{"$ref":"#/$defs/Money"},"reserved":{"$ref":"#/$defs/Money"},"spent_tokens":{"$ref":"#/$defs/Revision"},"reserved_tokens":{"$ref":"#/$defs/Revision"},"spent_calls":{"$ref":"#/$defs/Revision"},"reserved_calls":{"$ref":"#/$defs/Revision"},"approval":{"$ref":"#/$defs/Approval"},"content_sha256":{"$ref":"#/$defs/Hash"},"approver_id":{"$ref":"#/$defs/Id"},"approved_at":{"$ref":"#/$defs/Time"},"created_by":{"$ref":"#/$defs/Id"},"created_at":{"$ref":"#/$defs/Time"},"updated_at":{"$ref":"#/$defs/Time"},"revision":{"$ref":"#/$defs/Revision"},"allowed_actions":{"type":"array","uniqueItems":true,"items":{"enum":["budget.read","budget.approve"]}}}},
    "Listing":{"type":"object","additionalProperties":false,"required":["schema_version","budgets","total","next_after"],"properties":{"schema_version":{"const":"1.0.0"},"budgets":{"type":"array","maxItems":100,"items":{"$ref":"#/$defs/Account"}},"total":{"$ref":"#/$defs/Revision"},"next_after":{"$ref":"#/$defs/NullableId"}}},
    "Context":{"type":"object","additionalProperties":false,"required":["tenant_id","context_revision","auth_epoch","governance_epoch"],"properties":{"tenant_id":{"$ref":"#/$defs/Id"},"context_revision":{"$ref":"#/$defs/Revision"},"auth_epoch":{"$ref":"#/$defs/Revision"},"governance_epoch":{"$ref":"#/$defs/Revision"}}},
    "Receipt":{"type":"object","additionalProperties":false,"required":["schema_version","operation_id","decision","tenant_id","project_id","budget_id","budget_revision","revision","currency","content_sha256","current_context"],"properties":{"schema_version":{"const":"1.0.0"},"operation_id":{"$ref":"#/$defs/Id"},"decision":{"enum":["CREATE","APPROVE"]},"tenant_id":{"$ref":"#/$defs/Id"},"project_id":{"$ref":"#/$defs/NullableId"},"budget_id":{"$ref":"#/$defs/Id"},"budget_revision":{"$ref":"#/$defs/Id"},"revision":{"$ref":"#/$defs/Revision"},"currency":{"$ref":"#/$defs/Currency"},"content_sha256":{"$ref":"#/$defs/Hash"},"current_context":{"$ref":"#/$defs/Context"}}}
  }
}
