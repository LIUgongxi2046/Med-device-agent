{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:medical:source-image-locator:1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "frame_index",
    "original_sha256",
    "coordinate_system",
    "width",
    "height",
    "x0",
    "y0",
    "x1",
    "y1"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "kind": {
      "const": "IMAGE"
    },
    "frame_index": {
      "type": "integer",
      "minimum": 0,
      "maximum": 999
    },
    "original_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "coordinate_system": {
      "const": "ORIGINAL_TOP_LEFT_NORMALIZED"
    },
    "width": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100000
    },
    "height": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100000
    },
    "x0": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "y0": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "x1": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "y1": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  }
}
