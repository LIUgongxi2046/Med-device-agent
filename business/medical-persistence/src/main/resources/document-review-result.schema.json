{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:medical:document-review-result:1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "node_kind",
    "execution_kind",
    "job_type",
    "target_kind",
    "run_id",
    "step_id",
    "action_id",
    "receipt_id",
    "document_id",
    "document_revision",
    "rule_manifest_id",
    "findings_artifact_id",
    "coverage_artifact_id",
    "audit_id",
    "event_id",
    "input_sha256",
    "body_sha256",
    "baseline_sha256",
    "rules_sha256",
    "findings_sha256",
    "coverage_sha256",
    "status",
    "professional_approval",
    "coverage_complete",
    "check_ids",
    "input_watermarks",
    "output_watermarks",
    "issue_effects"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "node_kind": {
      "const": "N07"
    },
    "execution_kind": {
      "const": "SYSTEM_JOB"
    },
    "job_type": {
      "const": "CHECK_DOCUMENT"
    },
    "target_kind": {
      "const": "DOCUMENT"
    },
    "run_id": {
      "type": "string",
      "format": "uuid"
    },
    "step_id": {
      "type": "string",
      "format": "uuid"
    },
    "action_id": {
      "type": "string",
      "format": "uuid"
    },
    "receipt_id": {
      "type": "string",
      "format": "uuid"
    },
    "document_id": {
      "type": "string",
      "format": "uuid"
    },
    "document_revision": {
      "type": "string",
      "format": "uuid"
    },
    "rule_manifest_id": {
      "type": "string",
      "format": "uuid"
    },
    "findings_artifact_id": {
      "type": "string",
      "format": "uuid"
    },
    "coverage_artifact_id": {
      "type": "string",
      "format": "uuid"
    },
    "audit_id": {
      "type": "string",
      "format": "uuid"
    },
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "input_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "body_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "baseline_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "rules_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "findings_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "coverage_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "status": {
      "enum": [
        "WAITING_INPUT",
        "SUCCEEDED"
      ]
    },
    "professional_approval": {
      "const": false
    },
    "coverage_complete": {
      "type": "boolean"
    },
    "check_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "string",
        "format": "uuid"
      }
    },
    "input_watermarks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issue_watermark",
        "evidence_watermark"
      ],
      "properties": {
        "issue_watermark": {
          "type": "integer",
          "minimum": 0
        },
        "evidence_watermark": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "output_watermarks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issue_watermark",
        "evidence_watermark"
      ],
      "properties": {
        "issue_watermark": {
          "type": "integer",
          "minimum": 0
        },
        "evidence_watermark": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "issue_effects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "issue_id",
          "finding_sha256",
          "effect"
        ],
        "properties": {
          "issue_id": {
            "type": "string",
            "format": "uuid"
          },
          "finding_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "effect": {
            "enum": [
              "CREATED",
              "REOPENED",
              "UNCHANGED"
            ]
          }
        }
      }
    }
  }
}
