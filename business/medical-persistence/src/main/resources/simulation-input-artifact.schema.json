{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:medical:simulation-input-artifact:1.0.0",
  "$defs": {
    "Request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "project_id",
        "model_config_revision",
        "request_parameters"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "project_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid",
              "pattern": "^[0-9a-f-]{36}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "model_config_revision": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f-]{36}$"
        },
        "request_parameters": {
          "type": "object",
          "maxProperties": 128
        }
      }
    },
    "Receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "input_data_kind",
        "production_eligible",
        "input_ref",
        "source_binding"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "input_data_kind": {
          "const": "SIMULATION"
        },
        "production_eligible": {
          "const": false
        },
        "input_ref": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "version_id",
            "content_sha256"
          ],
          "properties": {
            "version_id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^[0-9a-f-]{36}$"
            },
            "content_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        "source_binding": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source_id",
            "source_version",
            "rights_revision",
            "case_id",
            "model_config_revision"
          ],
          "properties": {
            "source_id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^[0-9a-f-]{36}$"
            },
            "source_version": {
              "type": "string",
              "format": "uuid",
              "pattern": "^[0-9a-f-]{36}$"
            },
            "rights_revision": {
              "type": "string",
              "format": "uuid",
              "pattern": "^[0-9a-f-]{36}$"
            },
            "case_id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^[0-9a-f-]{36}$"
            },
            "model_config_revision": {
              "type": "string",
              "format": "uuid",
              "pattern": "^[0-9a-f-]{36}$"
            }
          }
        }
      }
    }
  }
}
