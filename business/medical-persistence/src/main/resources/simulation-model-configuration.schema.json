{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:medical:simulation-model-configuration:1.0.0",
  "$defs": {
    "Id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "NullableId": {
      "anyOf": [
        {
          "$ref": "#/$defs/Id"
        },
        {
          "type": "null"
        }
      ]
    },
    "Revision": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$"
    },
    "Positive": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,19}$"
    },
    "Hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "Basis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version_id",
        "content_sha256"
      ],
      "properties": {
        "version_id": {
          "$ref": "#/$defs/Id"
        },
        "content_sha256": {
          "$ref": "#/$defs/Hash"
        }
      }
    },
    "NullableBasis": {
      "anyOf": [
        {
          "$ref": "#/$defs/Basis"
        },
        {
          "type": "null"
        }
      ]
    },
    "Limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "context_window",
        "max_output_tokens",
        "max_concurrency",
        "requests_per_minute",
        "tokens_per_minute",
        "deadline_seconds",
        "temperature_enabled",
        "reasoning_efforts",
        "stop_limit"
      ],
      "properties": {
        "context_window": {
          "$ref": "#/$defs/Positive"
        },
        "max_output_tokens": {
          "$ref": "#/$defs/Positive"
        },
        "max_concurrency": {
          "$ref": "#/$defs/Positive"
        },
        "requests_per_minute": {
          "$ref": "#/$defs/Positive"
        },
        "tokens_per_minute": {
          "$ref": "#/$defs/Positive"
        },
        "deadline_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 300
        },
        "temperature_enabled": {
          "type": "boolean"
        },
        "reasoning_efforts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "none",
              "low",
              "high",
              "max"
            ]
          }
        },
        "stop_limit": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16
        }
      }
    },
    "Definition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "execution_mode",
        "simulator_id",
        "simulator_version",
        "model_id",
        "model_version",
        "case_binding",
        "limits",
        "provenance_schema_ref",
        "provenance_schema_sha256",
        "production_eligible",
        "provider_charge_amount",
        "charge_basis"
      ],
      "properties": {
        "execution_mode": {
          "const": "SIMULATION"
        },
        "simulator_id": {
          "const": "medical_model_gateway.simulation.SimulationProvider"
        },
        "simulator_version": {
          "const": "1.0.0"
        },
        "model_id": {
          "type": "string",
          "minLength": 12,
          "maxLength": 256,
          "pattern": "^SIMULATION:[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "model_version": {
          "type": "string",
          "minLength": 12,
          "maxLength": 256,
          "pattern": "^SIMULATION:[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "case_binding": {
          "$ref": "#/$defs/CaseBinding"
        },
        "limits": {
          "$ref": "#/$defs/Limits"
        },
        "provenance_schema_ref": {
          "const": "urn:medical:local-simulation-provenance:1.0.0"
        },
        "provenance_schema_sha256": {
          "const": "ba6ee6a53f72ed4f62bec2243e35853706add8bf4e24e272b441fa50ef6dbc4c"
        },
        "production_eligible": {
          "const": false
        },
        "provider_charge_amount": {
          "const": "0.00000000"
        },
        "charge_basis": {
          "const": "LOCAL_SIMULATION_NO_PROVIDER_REQUEST"
        }
      }
    },
    "PublicDefinition": {
      "$ref": "#/$defs/Definition"
    },
    "Save": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "project_id",
        "config_id",
        "expected_revision",
        "based_on_revision",
        "definition",
        "reason"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "project_id": {
          "$ref": "#/$defs/NullableId"
        },
        "config_id": {
          "$ref": "#/$defs/NullableId"
        },
        "expected_revision": {
          "$ref": "#/$defs/Revision"
        },
        "based_on_revision": {
          "$ref": "#/$defs/NullableBasis"
        },
        "definition": {
          "$ref": "#/$defs/Definition"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      }
    },
    "Fixed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "tenant_id",
        "project_id",
        "config_id",
        "model_config_revision",
        "based_on_revision",
        "definition",
        "reason",
        "authority_grant_id",
        "authority_revision",
        "created_by",
        "created_at"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "tenant_id": {
          "$ref": "#/$defs/Id"
        },
        "project_id": {
          "$ref": "#/$defs/NullableId"
        },
        "config_id": {
          "$ref": "#/$defs/Id"
        },
        "model_config_revision": {
          "$ref": "#/$defs/Id"
        },
        "based_on_revision": {
          "$ref": "#/$defs/NullableBasis"
        },
        "definition": {
          "$ref": "#/$defs/Definition"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "authority_grant_id": {
          "$ref": "#/$defs/Id"
        },
        "authority_revision": {
          "$ref": "#/$defs/Positive"
        },
        "created_by": {
          "$ref": "#/$defs/Id"
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        }
      }
    },
    "View": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "tenant_id",
        "project_id",
        "config_id",
        "model_config_revision",
        "based_on_revision",
        "definition",
        "content_sha256",
        "status",
        "current_model_revision",
        "revision",
        "created_by",
        "created_at",
        "dependency_validation",
        "allowed_actions"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "tenant_id": {
          "$ref": "#/$defs/Id"
        },
        "project_id": {
          "$ref": "#/$defs/NullableId"
        },
        "config_id": {
          "$ref": "#/$defs/Id"
        },
        "model_config_revision": {
          "$ref": "#/$defs/Id"
        },
        "based_on_revision": {
          "$ref": "#/$defs/NullableBasis"
        },
        "definition": {
          "$ref": "#/$defs/PublicDefinition"
        },
        "content_sha256": {
          "$ref": "#/$defs/Hash"
        },
        "status": {
          "const": "DRAFT"
        },
        "current_model_revision": {
          "$ref": "#/$defs/Id"
        },
        "revision": {
          "$ref": "#/$defs/Positive"
        },
        "created_by": {
          "$ref": "#/$defs/Id"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "dependency_validation": {
          "const": "DECLARED_SIMULATION_BINDING_ONLY"
        },
        "allowed_actions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "configuration.read",
              "model.configure"
            ]
          }
        }
      }
    },
    "Context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tenant_id",
        "context_revision",
        "auth_epoch",
        "governance_epoch"
      ],
      "properties": {
        "tenant_id": {
          "$ref": "#/$defs/Id"
        },
        "context_revision": {
          "$ref": "#/$defs/Revision"
        },
        "auth_epoch": {
          "$ref": "#/$defs/Revision"
        },
        "governance_epoch": {
          "$ref": "#/$defs/Revision"
        }
      }
    },
    "Receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "operation_id",
        "tenant_id",
        "project_id",
        "config_id",
        "model_config_revision",
        "content_sha256",
        "status",
        "revision",
        "current_context",
        "execution_mode",
        "production_eligible"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "operation_id": {
          "$ref": "#/$defs/Id"
        },
        "tenant_id": {
          "$ref": "#/$defs/Id"
        },
        "project_id": {
          "$ref": "#/$defs/NullableId"
        },
        "config_id": {
          "$ref": "#/$defs/Id"
        },
        "model_config_revision": {
          "$ref": "#/$defs/Id"
        },
        "content_sha256": {
          "$ref": "#/$defs/Hash"
        },
        "status": {
          "const": "DRAFT"
        },
        "revision": {
          "$ref": "#/$defs/Positive"
        },
        "current_context": {
          "$ref": "#/$defs/Context"
        },
        "execution_mode": {
          "const": "SIMULATION"
        },
        "production_eligible": {
          "const": false
        }
      }
    },
    "CaseBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "case_sha256",
        "validation"
      ],
      "properties": {
        "case_id": {
          "$ref": "#/$defs/Id"
        },
        "case_sha256": {
          "$ref": "#/$defs/Hash"
        },
        "validation": {
          "const": "DECLARED_ONLY"
        }
      }
    }
  },
  "description": "Explicit local simulator configuration. Case hash is a declared binding only; this draft never proves execution, approval or production eligibility."
}
