{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:medical:project-workspace-directory:1.0.0",
  "$defs":{
    "Cursor":{"type":"string","minLength":1,"maxLength":2048,"pattern":"^[A-Za-z0-9_-]+$"},
    "Query":{"type":"object","additionalProperties":false,"properties":{
      "limit":{"type":"integer","minimum":1,"maximum":100},
      "after":{"$ref":"#/$defs/Cursor"},
      "q":{"type":"string","minLength":1,"maxLength":256},
      "status":{"$ref":"urn:medical:projects:1.0.0#/$defs/Status"},
      "responsible_user_id":{"$ref":"urn:medical:projects:1.0.0#/$defs/Id"}
    }},
    "Filters":{"type":"object","additionalProperties":false,"required":["limit","q","status","responsible_user_id"],"properties":{
      "limit":{"type":"integer","minimum":1,"maximum":100},
      "q":{"type":["string","null"],"minLength":1,"maxLength":256},
      "status":{"anyOf":[{"$ref":"urn:medical:projects:1.0.0#/$defs/Status"},{"type":"null"}]},
      "responsible_user_id":{"$ref":"urn:medical:projects:1.0.0#/$defs/NullableId"}
    }},
    "Responsible":{"type":"object","additionalProperties":false,"required":["user_id","identity_available","display_name","username"],"properties":{
      "user_id":{"$ref":"urn:medical:projects:1.0.0#/$defs/Id"},"identity_available":{"type":"boolean"},
      "display_name":{"type":["string","null"]},"username":{"type":["string","null"]}
    }},
    "Materials":{"type":"object","additionalProperties":false,"required":["scope","registered","approved","not_approved","checked_at"],"properties":{
      "scope":{"const":"AUTHORIZED_ENTERPRISE_AND_PROJECT"},
      "registered":{"$ref":"urn:medical:projects:1.0.0#/$defs/Revision"},
      "approved":{"$ref":"urn:medical:projects:1.0.0#/$defs/Revision"},
      "not_approved":{"$ref":"urn:medical:projects:1.0.0#/$defs/Revision"},
      "checked_at":{"$ref":"urn:medical:projects:1.0.0#/$defs/Time"}
    }},
    "Entry":{"type":"object","additionalProperties":false,"required":["project","responsible","materials"],"properties":{
      "project":{"$ref":"urn:medical:projects:1.0.0#/$defs/Project"},
      "responsible":{"$ref":"#/$defs/Responsible"},"materials":{"$ref":"#/$defs/Materials"}
    }},
    "Directory":{"type":"object","additionalProperties":false,"required":["schema_version","tenant_id","current_context","query","total","items","next_after"],"properties":{
      "schema_version":{"const":"1.0.0"},"tenant_id":{"$ref":"urn:medical:projects:1.0.0#/$defs/Id"},
      "current_context":{"$ref":"urn:medical:projects:1.0.0#/$defs/Context"},"query":{"$ref":"#/$defs/Filters"},
      "total":{"$ref":"urn:medical:projects:1.0.0#/$defs/Revision"},
      "items":{"type":"array","maxItems":100,"items":{"$ref":"#/$defs/Entry"}},
      "next_after":{"anyOf":[{"$ref":"#/$defs/Cursor"},{"type":"null"}]}
    }}
  }
}
