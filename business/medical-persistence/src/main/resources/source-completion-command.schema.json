{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:medical:source-completion-command:1.0.0",
  "type":"object","additionalProperties":false,
  "required":["schema_version","operation_id","event_id","consumer_id","upload_id","source_revision","session_revision","request_sha256","schema_ref","schema_document_sha256","schema_manifest_sha256","authority_sha256","subject_id","application_session_id","context","watermarks","request","stored_parts","response"],
  "properties":{
    "schema_version":{"const":"1.0.0"},
    "operation_id":{"$ref":"#/$defs/Id"},"event_id":{"$ref":"#/$defs/Id"},"upload_id":{"$ref":"#/$defs/Id"},
    "consumer_id":{"const":"SOURCE_UPLOAD_COMPLETION"},
    "source_revision":{"$ref":"#/$defs/Positive"},"session_revision":{"$ref":"#/$defs/Positive"},
    "request_sha256":{"$ref":"#/$defs/Hash"},"schema_document_sha256":{"$ref":"#/$defs/Hash"},
    "schema_manifest_sha256":{"$ref":"#/$defs/Hash"},"authority_sha256":{"$ref":"#/$defs/Hash"},
    "schema_ref":{"const":"urn:medical:source-uploads:1.0.0#/$defs/Completion"},
    "subject_id":{"$ref":"#/$defs/Id"},"application_session_id":{"$ref":"#/$defs/Id"},
    "context":{
      "type":"object","additionalProperties":false,"required":["tenant_id","context_revision","auth_epoch","governance_epoch"],
      "properties":{"tenant_id":{"$ref":"#/$defs/Id"},"context_revision":{"$ref":"#/$defs/Positive"},
        "auth_epoch":{"$ref":"#/$defs/Unsigned"},"governance_epoch":{"$ref":"#/$defs/Unsigned"}}
    },
    "watermarks":{
      "type":"object","additionalProperties":false,"required":["auth_epoch","governance_epoch"],
      "properties":{"auth_epoch":{"$ref":"#/$defs/Unsigned"},"governance_epoch":{"$ref":"#/$defs/Unsigned"}}
    },
    "request":{"type":"object"},
    "stored_parts":{"type":"array","minItems":1,"maxItems":13,"items":{"type":"object"}},
    "response":{"type":"object"}
  },
  "$defs":{
    "Id":{"type":"string","format":"uuid","pattern":"^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
    "Hash":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "Unsigned":{"type":"string","pattern":"^(0|[1-9][0-9]{0,19})$"},
    "Positive":{"type":"string","pattern":"^[1-9][0-9]{0,19}$"}
  }
}
