{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:medical:formal-evaluation-score-binding:1.0.0",
  "$defs": {
    "Basis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version_id",
        "content_sha256"
      ],
      "properties": {
        "version_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "content_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "Evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "basis"
      ],
      "properties": {
        "kind": {
          "enum": [
            "SOURCE",
            "ARTIFACT"
          ]
        },
        "basis": {
          "$ref": "#/$defs/Basis"
        }
      }
    },
    "Author": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "project_id",
        "expert_id",
        "domain",
        "dimensions",
        "purpose",
        "valid_from",
        "valid_to",
        "evidence",
        "reason"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "project_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "expert_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "domain": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "dimensions": {
          "type": "array",
          "items": {
            "enum": [
              "EVAL-01",
              "EVAL-02",
              "EVAL-03",
              "EVAL-04",
              "EVAL-05",
              "EVAL-06",
              "EVAL-07",
              "EVAL-08",
              "EVAL-09",
              "EVAL-10",
              "EVAL-11",
              "EVAL-12"
            ]
          },
          "minItems": 1,
          "maxItems": 12,
          "uniqueItems": true
        },
        "purpose": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
        },
        "valid_from": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "valid_to": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      }
    },
    "Definition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "tenant_id",
        "qualification_id",
        "request",
        "created_by",
        "created_at"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "tenant_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "qualification_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "request": {
          "$ref": "#/$defs/Author"
        },
        "created_by": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        }
      }
    },
    "Decide": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "qualification",
        "expected_revision",
        "decision",
        "reviewed_evidence",
        "originals_reviewed",
        "scope_confirmed",
        "reason"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "qualification": {
          "$ref": "#/$defs/Basis"
        },
        "expected_revision": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,18}$"
        },
        "decision": {
          "enum": [
            "APPROVE",
            "REJECT",
            "REVOKE"
          ]
        },
        "reviewed_evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Basis"
          },
          "minItems": 0,
          "maxItems": 32,
          "uniqueItems": true
        },
        "originals_reviewed": {
          "type": "boolean"
        },
        "scope_confirmed": {
          "type": "boolean"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      }
    },
    "Decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "qualification",
        "previous_decision",
        "expected_revision",
        "resulting_revision",
        "decision",
        "request",
        "decided_by",
        "decided_at"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "qualification": {
          "$ref": "#/$defs/Basis"
        },
        "previous_decision": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "expected_revision": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,18}$"
        },
        "resulting_revision": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,18}$"
        },
        "decision": {
          "enum": [
            "APPROVE",
            "REJECT",
            "REVOKE"
          ]
        },
        "request": {
          "$ref": "#/$defs/Decide"
        },
        "decided_by": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "decided_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        }
      }
    },
    "BindScore": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "evaluation_id",
        "score_id",
        "definition_sha256",
        "score_sha256",
        "qualification",
        "domain",
        "reason"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "evaluation_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "score_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "definition_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "score_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "qualification": {
          "$ref": "#/$defs/Basis"
        },
        "domain": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      }
    },
    "BoundScore": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "request",
        "approval",
        "score",
        "bound_by",
        "bound_at"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "request": {
          "$ref": "#/$defs/BindScore"
        },
        "approval": {
          "$ref": "#/$defs/Basis"
        },
        "score": {
          "$ref": "#/$defs/Evaluation_Score"
        },
        "bound_by": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "bound_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        }
      }
    },
    "Receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "kind",
        "record",
        "qualification",
        "operation_id",
        "request_body_sha256",
        "qualification_revision",
        "created_by",
        "created_at"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "kind": {
          "enum": [
            "AUTHOR",
            "APPROVE",
            "REJECT",
            "REVOKE",
            "SCORE_BIND"
          ]
        },
        "record": {
          "$ref": "#/$defs/Basis"
        },
        "qualification": {
          "$ref": "#/$defs/Basis"
        },
        "operation_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "request_body_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "qualification_revision": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,18}$"
        },
        "created_by": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        }
      }
    },
    "Availability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "enabled",
        "unavailable_reason",
        "scope",
        "creates_professional_licence",
        "creates_scores",
        "proves_formal_execution"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "enabled": {
          "type": "boolean"
        },
        "unavailable_reason": {
          "anyOf": [
            {
              "enum": [
                "FEATURE_DISABLED"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "scope": {
          "const": "HUMAN_QUALIFICATION_GOVERNANCE"
        },
        "creates_professional_licence": {
          "const": false
        },
        "creates_scores": {
          "const": false
        },
        "proves_formal_execution": {
          "const": false
        }
      }
    },
    "Evaluation_Score": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "score_id",
        "evaluation_id",
        "definition_sha256",
        "rule_revision",
        "observation",
        "scorer_id",
        "authority_grant_id",
        "authority_revision",
        "created_at"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "score_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f-]{36}$"
        },
        "evaluation_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f-]{36}$"
        },
        "definition_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "rule_revision": {
          "$ref": "#/$defs/Evaluation_Basis"
        },
        "observation": {
          "$ref": "#/$defs/Evaluation_Append"
        },
        "scorer_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f-]{36}$"
        },
        "authority_grant_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f-]{36}$"
        },
        "authority_revision": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,19}$"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "Evaluation_Basis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version_id",
        "content_sha256"
      ],
      "properties": {
        "version_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f-]{36}$"
        },
        "content_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "Evaluation_Append": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "expected_revision",
        "definition_sha256",
        "cell",
        "input_ref",
        "output_ref",
        "evidence_refs",
        "numerator",
        "denominator",
        "unknown_count",
        "violation_count",
        "control_numerator",
        "control_denominator",
        "status",
        "supersedes",
        "reason"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "expected_revision": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,19}$"
        },
        "definition_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "cell": {
          "$ref": "#/$defs/Evaluation_Cell"
        },
        "input_ref": {
          "$ref": "#/$defs/Evaluation_Basis"
        },
        "output_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/Evaluation_Basis"
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Evaluation_Basis"
          },
          "minItems": 0,
          "maxItems": 100,
          "uniqueItems": true
        },
        "numerator": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]{0,17})$"
            },
            {
              "type": "null"
            }
          ]
        },
        "denominator": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]{0,17})$"
            },
            {
              "type": "null"
            }
          ]
        },
        "unknown_count": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]{0,17})$"
            },
            {
              "type": "null"
            }
          ]
        },
        "violation_count": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]{0,17})$"
            },
            {
              "type": "null"
            }
          ]
        },
        "control_numerator": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]{0,17})$"
            },
            {
              "type": "null"
            }
          ]
        },
        "control_denominator": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]{0,17})$"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "enum": [
            "SCORED",
            "UNKNOWN",
            "BLOCKED"
          ]
        },
        "supersedes": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid",
              "pattern": "^[0-9a-f-]{36}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      }
    },
    "Evaluation_Cell": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sample_id",
        "agent_version_id",
        "dimension",
        "repeat_index"
      ],
      "properties": {
        "sample_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f-]{36}$"
        },
        "agent_version_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f-]{36}$"
        },
        "dimension": {
          "$ref": "#/$defs/Evaluation_Dimension"
        },
        "repeat_index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 99
        }
      }
    },
    "Evaluation_Dimension": {
      "enum": [
        "EVAL-01",
        "EVAL-02",
        "EVAL-03",
        "EVAL-04",
        "EVAL-05",
        "EVAL-06",
        "EVAL-07",
        "EVAL-08",
        "EVAL-09",
        "EVAL-10",
        "EVAL-11",
        "EVAL-12"
      ]
    },
    "Read": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "qualification",
        "definition",
        "status",
        "revision",
        "decisions",
        "creates_professional_licence",
        "proves_formal_execution"
      ],
      "properties": {
        "qualification": {
          "$ref": "#/$defs/Basis"
        },
        "definition": {
          "$ref": "#/$defs/Definition"
        },
        "status": {
          "enum": [
            "DRAFT",
            "APPROVED",
            "REJECTED",
            "REVOKED"
          ]
        },
        "revision": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,18}$"
        },
        "decisions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Decision"
          },
          "minItems": 0,
          "maxItems": 2,
          "uniqueItems": true
        },
        "creates_professional_licence": {
          "const": false
        },
        "proves_formal_execution": {
          "const": false
        }
      }
    },
    "Recovery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receipt",
        "request",
        "content"
      ],
      "properties": {
        "receipt": {
          "$ref": "#/$defs/Receipt"
        },
        "request": {
          "oneOf": [
            {
              "$ref": "#/$defs/Author"
            },
            {
              "$ref": "#/$defs/Decide"
            },
            {
              "$ref": "#/$defs/BindScore"
            }
          ]
        },
        "content": {
          "oneOf": [
            {
              "$ref": "#/$defs/Definition"
            },
            {
              "$ref": "#/$defs/Decision"
            },
            {
              "$ref": "#/$defs/BoundScore"
            }
          ]
        }
      }
    },
    "FormalScoreBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "evaluation",
        "statistics_policy",
        "binding"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "evaluation": {
          "$ref": "#/$defs/Basis"
        },
        "statistics_policy": {
          "$ref": "#/$defs/Basis"
        },
        "binding": {
          "$ref": "#/$defs/BindScore"
        }
      }
    },
    "FormalReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "original_key",
        "request_body_sha256",
        "receipt"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "original_key": {
          "type": "string",
          "minLength": 16,
          "maxLength": 200
        },
        "request_body_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "receipt": {
          "$ref": "#/$defs/Receipt"
        }
      }
    },
    "FormalRecovery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "original_key",
        "request"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "original_key": {
          "type": "string",
          "minLength": 16,
          "maxLength": 200
        },
        "request": {
          "$ref": "#/$defs/FormalScoreBinding"
        }
      }
    }
  }
}
