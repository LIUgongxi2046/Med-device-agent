{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"urn:medical:source-completion-result:1.0.0",
  "oneOf":[{"$ref":"#/$defs/Success"},{"$ref":"#/$defs/Failure"}],
  "$defs":{
    "Id":{"type":"string","format":"uuid","pattern":"^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
    "Hash":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "ObjectRef":{
      "type":"object","additionalProperties":false,"required":["object_key","object_version","sha256","size_bytes","media_type"],
      "properties":{"object_key":{"type":"string","minLength":1,"maxLength":1024},
        "object_version":{"type":"string","minLength":1,"maxLength":256,"not":{"const":"null"}},
        "sha256":{"$ref":"#/$defs/Hash"},"size_bytes":{"type":"string","pattern":"^[1-9][0-9]{0,19}$"},
        "media_type":{"type":"string","minLength":1,"maxLength":128}}
    },
    "Success":{
      "type":"object","additionalProperties":false,
      "required":["schema_version","upload_id","operation_id","event_id","consumer_id","input_sha256","ownership_scope_id","original_sha256","original_object_ref","status","source_id","source_version","rights_revision","parse_version","attempt_id","run_id"],
      "properties":{"schema_version":{"const":"1.0.0"},"upload_id":{"$ref":"#/$defs/Id"},"operation_id":{"$ref":"#/$defs/Id"},
        "event_id":{"$ref":"#/$defs/Id"},"consumer_id":{"const":"SOURCE_UPLOAD_COMPLETION"},"input_sha256":{"$ref":"#/$defs/Hash"},
        "ownership_scope_id":{"$ref":"#/$defs/Id"},"original_sha256":{"$ref":"#/$defs/Hash"},"original_object_ref":{"$ref":"#/$defs/ObjectRef"},
        "status":{"enum":["REGISTERED","DUPLICATE"]},"source_id":{"$ref":"#/$defs/Id"},"source_version":{"$ref":"#/$defs/Id"},
        "rights_revision":{"$ref":"#/$defs/Id"},"parse_version":{"anyOf":[{"type":"null"},{"$ref":"#/$defs/Id"}]},
        "attempt_id":{"anyOf":[{"type":"null"},{"$ref":"#/$defs/Id"}]},"run_id":{"anyOf":[{"type":"null"},{"$ref":"#/$defs/Id"}]}},
      "allOf":[{"if":{"properties":{"status":{"const":"REGISTERED"}}},
        "then":{"properties":{"parse_version":{"$ref":"#/$defs/Id"},"attempt_id":{"$ref":"#/$defs/Id"},"run_id":{"$ref":"#/$defs/Id"}}},
        "else":{"properties":{"parse_version":{"type":"null"},"attempt_id":{"type":"null"},"run_id":{"type":"null"}}}}]
    },
    "Failure":{
      "type":"object","additionalProperties":false,
      "required":["schema_version","upload_id","operation_id","event_id","consumer_id","status","error_code","reason","exit_code","input_sha256"],
      "properties":{"schema_version":{"const":"1.0.0"},"upload_id":{"$ref":"#/$defs/Id"},"operation_id":{"$ref":"#/$defs/Id"},
        "event_id":{"$ref":"#/$defs/Id"},"consumer_id":{"const":"SOURCE_UPLOAD_COMPLETION"},"status":{"const":"FAILED"},
        "error_code":{"const":"PROCESSING_FAILED"},"reason":{"enum":["UPLOAD_EXPIRED","EXECUTION_DEADLINE","ATTEMPT_LIMIT","SOURCE_VALIDATION_FAILED"]},
        "exit_code":{"anyOf":[{"type":"null"},{"type":"integer","minimum":1,"maximum":255}]},"input_sha256":{"$ref":"#/$defs/Hash"}},
      "allOf":[{"if":{"properties":{"reason":{"const":"SOURCE_VALIDATION_FAILED"}}},
        "then":{"properties":{"exit_code":{"type":"integer"}}},"else":{"properties":{"exit_code":{"type":"null"}}}}]
    }
  }
}
