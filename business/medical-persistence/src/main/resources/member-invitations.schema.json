{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:medical:member-invitations:1.0.0",
  "$defs":{
    "Id":{"type":"string","format":"uuid","pattern":"^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
    "Hash":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "Revision":{"type":"string","pattern":"^(0|[1-9][0-9]{0,19})$"},
    "Credential":{"type":"string","pattern":"^[A-Za-z0-9_-]{43}$"},
    "RoleReference":{"type":"object","additionalProperties":false,"required":["role_id","version_id","content_sha256"],"properties":{"role_id":{"$ref":"#/$defs/Id"},"version_id":{"$ref":"#/$defs/Id"},"content_sha256":{"$ref":"#/$defs/Hash"}}},
    "Roles":{"type":"array","minItems":1,"maxItems":100,"uniqueItems":true,"items":{"$ref":"#/$defs/RoleReference"}},
    "Create":{"type":"object","additionalProperties":false,"required":["schema_version","identity_binding","roles","scope","expires_at","basis"],"properties":{"schema_version":{"const":"1.0.0"},"identity_binding":{"type":"object"},"roles":{"$ref":"#/$defs/Roles"},"scope":{"type":"object"},"expires_at":{"type":"string"},"basis":{"type":"object"}}},
    "Accept":{"type":"object","additionalProperties":false,"required":["schema_version","credential","expected_revision"],"properties":{"schema_version":{"const":"1.0.0"},"credential":{"$ref":"#/$defs/Credential"},"expected_revision":{"$ref":"#/$defs/Revision"}}},
    "RoleDefinition":{"type":"object","additionalProperties":false,"required":["schema_version","role_id","actions","condition"],"properties":{"schema_version":{"const":"1.0.0"},"role_id":{"$ref":"#/$defs/Id"},"actions":{"type":"array","uniqueItems":true,"maxItems":1000,"items":{"type":"string","pattern":"^[a-z][a-z0-9_.-]{0,63}$"}},"condition":{"type":"object"}}},
    "Authorization":{"type":"object","additionalProperties":false,"required":["role_id","role_version","action","condition","authority_id","authority_revision","valid_to"],"properties":{"role_id":{"$ref":"#/$defs/Id"},"role_version":{"$ref":"#/$defs/Id"},"action":{"type":["string","null"]},"condition":{"type":"object"},"authority_id":{"$ref":"#/$defs/Id"},"authority_revision":{"$ref":"#/$defs/Revision"},"valid_to":{"type":["string","null"]}}},
    "Authorizations":{"type":"array","maxItems":100000,"items":{"$ref":"#/$defs/Authorization"}},
    "CreationReceipt":{"type":"object","additionalProperties":false,"required":["schema_version","operation_id","invitation_id","user_id","status","revision","expires_at","credential","auth_epoch"],"properties":{"schema_version":{"const":"1.0.0"},"operation_id":{"$ref":"#/$defs/Id"},"invitation_id":{"$ref":"#/$defs/Id"},"user_id":{"$ref":"#/$defs/Id"},"status":{"const":"PENDING"},"revision":{"$ref":"#/$defs/Revision"},"expires_at":{"type":"string"},"credential":{"$ref":"#/$defs/Credential"},"auth_epoch":{"$ref":"#/$defs/Revision"}}},
    "AcceptanceReceipt":{"type":"object","additionalProperties":false,"required":["schema_version","operation_id","invitation_id","user_id","status","revision","member_id","member_revision","grants","auth_epoch"],"properties":{"schema_version":{"const":"1.0.0"},"operation_id":{"$ref":"#/$defs/Id"},"invitation_id":{"$ref":"#/$defs/Id"},"user_id":{"$ref":"#/$defs/Id"},"status":{"const":"ACCEPTED"},"revision":{"$ref":"#/$defs/Revision"},"member_id":{"$ref":"#/$defs/Id"},"member_revision":{"$ref":"#/$defs/Revision"},"grants":{"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/Id"}},"auth_epoch":{"$ref":"#/$defs/Revision"}}},
    "Encrypted":{"type":"object","additionalProperties":false,"required":["schema_version","purpose","algorithm","key_id","nonce","ciphertext"],"properties":{"schema_version":{"const":"1.0.0"},"purpose":{"const":"INVITATION_RESPONSE"},"algorithm":{"const":"AES-256-GCM"},"key_id":{"$ref":"#/$defs/Id"},"nonce":{"type":"string","pattern":"^[A-Za-z0-9_-]{16}$"},"ciphertext":{"type":"string","minLength":24,"maxLength":1000000,"pattern":"^[A-Za-z0-9_-]+$"}}}
  }
}
