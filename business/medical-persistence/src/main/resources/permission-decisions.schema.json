{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:medical:permission-decisions:1.0.0",
  "$ref": "#/$defs/Request",
  "$defs": {
    "Id": {"type":"string","format":"uuid","pattern":"^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
    "NullableId": {"anyOf":[{"$ref":"#/$defs/Id"},{"type":"null"}]},
    "Revision": {"type":"string","pattern":"^(0|[1-9][0-9]{0,19})$"},
    "Action": {"type":"string","pattern":"^[a-z][a-z0-9_.-]{0,63}$"},
    "Kind": {"enum":["ENTERPRISE","PROJECT","MEMBER","SOURCE","TASK","DOCUMENT","ARTIFACT","CONFIGURATION","TEMPLATE","RULE","BUDGET","EVALUATION","AUDIT","REPORT"]},
    "Time": {"type":"string","format":"date-time","pattern":"^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?(Z|\\+00:00)$"},
    "NullableTime": {"anyOf":[{"$ref":"#/$defs/Time"},{"type":"null"}]},
    "Ids": {"type":"array","uniqueItems":true,"maxItems":1000,"items":{"$ref":"#/$defs/Id"}},
    "NullableIds": {"anyOf":[{"$ref":"#/$defs/Ids"},{"type":"null"}]},
    "Scope": {
      "type":"object","additionalProperties":false,"required":["tenant_id","project_id","resource_kind","resource_id"],
      "properties":{"tenant_id":{"$ref":"#/$defs/Id"},"project_id":{"$ref":"#/$defs/NullableId"},"resource_kind":{"$ref":"#/$defs/Kind"},"resource_id":{"$ref":"#/$defs/NullableId"}}
    },
    "Basis": {
      "type":"object","additionalProperties":false,"required":["version_id","content_sha256"],
      "properties":{"version_id":{"$ref":"#/$defs/Id"},"content_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}}
    },
    "Delegation": {
      "type":"object","additionalProperties":false,"required":["actions","role_ids","resource_kinds","project_ids","resource_ids"],
      "properties":{
        "actions":{"type":"array","uniqueItems":true,"maxItems":1000,"items":{"$ref":"#/$defs/Action"}},
        "role_ids":{"$ref":"#/$defs/Ids"},
        "resource_kinds":{"type":"array","uniqueItems":true,"maxItems":14,"items":{"$ref":"#/$defs/Kind"}},
        "project_ids":{"$ref":"#/$defs/NullableIds"},"resource_ids":{"$ref":"#/$defs/NullableIds"}
      }
    },
    "Condition": {
      "type":"object","additionalProperties":false,"required":["schema_version","identity_modes","purposes","delegation"],
      "properties":{
        "schema_version":{"const":"1.0.0"},
        "identity_modes":{"type":"array","minItems":1,"maxItems":2,"uniqueItems":true,"items":{"enum":["local","oidc"]}},
        "purposes":{"anyOf":[{"type":"null"},{"type":"array","uniqueItems":true,"maxItems":1000,"items":{"type":"string","pattern":"^[A-Z][A-Z0-9_]{0,63}$"}}]},
        "delegation":{"$ref":"#/$defs/Delegation"}
      }
    },
    "Request": {
      "type":"object","additionalProperties":false,
      "required":["schema_version","decision","subject_id","scope","action","grant_id","condition","valid_from","valid_to","basis","expected_revision","reason"],
      "properties":{
        "schema_version":{"const":"1.0.0"},"decision":{"enum":["GRANT","REVOKE","DISABLE_MEMBER"]},
        "subject_id":{"$ref":"#/$defs/Id"},"scope":{"$ref":"#/$defs/Scope"},
        "action":{"anyOf":[{"$ref":"#/$defs/Action"},{"type":"null"}]},"grant_id":{"$ref":"#/$defs/NullableId"},
        "condition":{"anyOf":[{"$ref":"#/$defs/Condition"},{"type":"null"}]},
        "valid_from":{"$ref":"#/$defs/NullableTime"},"valid_to":{"$ref":"#/$defs/NullableTime"},
        "basis":{"$ref":"#/$defs/Basis"},"expected_revision":{"$ref":"#/$defs/Revision"},
        "reason":{"type":"string","minLength":1,"maxLength":2000,"pattern":"\\S"}
      },
      "allOf":[
        {"if":{"properties":{"decision":{"const":"GRANT"}}},"then":{"properties":{"grant_id":{"type":"null"},"action":{"$ref":"#/$defs/Action"},"condition":{"$ref":"#/$defs/Condition"},"expected_revision":{"const":"0"}}}},
        {"if":{"properties":{"decision":{"const":"REVOKE"}}},"then":{"properties":{"grant_id":{"$ref":"#/$defs/Id"},"action":{"$ref":"#/$defs/Action"},"condition":{"type":"null"},"valid_from":{"type":"null"},"valid_to":{"type":"null"}}}},
        {"if":{"properties":{"decision":{"const":"DISABLE_MEMBER"}}},"then":{"properties":{"grant_id":{"type":"null"},"action":{"type":"null"},"condition":{"type":"null"},"valid_from":{"type":"null"},"valid_to":{"type":"null"}}}}
      ]
    },
    "Context": {
      "type":"object","additionalProperties":false,"required":["tenant_id","context_revision","auth_epoch","governance_epoch"],
      "properties":{"tenant_id":{"$ref":"#/$defs/Id"},"context_revision":{"$ref":"#/$defs/Revision"},"auth_epoch":{"$ref":"#/$defs/Revision"},"governance_epoch":{"$ref":"#/$defs/Revision"}}
    },
    "Target": {
      "type":"object","additionalProperties":false,"required":["id","status","revision"],
      "properties":{"id":{"$ref":"#/$defs/Id"},"status":{"enum":["ACTIVE","REVOKED","DISABLED"]},"revision":{"$ref":"#/$defs/Revision"}}
    },
    "Receipt": {
      "type":"object","additionalProperties":false,"required":["schema_version","operation_id","decision","subject_id","scope","grant","member","revoked_grants","terminated_invitations","current_context"],
      "properties":{
        "schema_version":{"const":"1.0.0"},"operation_id":{"$ref":"#/$defs/Id"},"decision":{"enum":["GRANT","REVOKE","DISABLE_MEMBER"]},
        "subject_id":{"$ref":"#/$defs/Id"},"scope":{"$ref":"#/$defs/Scope"},
        "grant":{"anyOf":[{"$ref":"#/$defs/Target"},{"type":"null"}]},"member":{"anyOf":[{"$ref":"#/$defs/Target"},{"type":"null"}]},
        "revoked_grants":{"$ref":"#/$defs/Revision"},"terminated_invitations":{"$ref":"#/$defs/Revision"},"current_context":{"$ref":"#/$defs/Context"}
      }
    }
  }
}
