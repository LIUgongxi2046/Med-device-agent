{
 "$schema":"https://json-schema.org/draft/2020-12/schema",
 "$id":"urn:medical:connector-workspace:1.0.0",
 "$defs":{
  "Id":{"type":"string","format":"uuid"},
  "Revision":{"type":"string","pattern":"^[0-9]+$"},
  "Hash":{"type":"string","pattern":"^[a-f0-9]{64}$"},
  "Observation":{"type":"object","additionalProperties":false,"required":["operation_id","state","created_at","updated_at"],"properties":{"operation_id":{"$ref":"#/$defs/Id"},"state":{"type":"string"},"created_at":{"type":"string","format":"date-time"},"updated_at":{"type":"string","format":"date-time"},"result_sha256":{"$ref":"#/$defs/Hash"},"actual_scope":{},"external_account_id":{"type":"string"}}},
  "Configuration":{"type":"object","additionalProperties":false,"required":["schema_version","config_revision","definition_sha256","approval_state","revision","connected","definition","business_profile","blockers","cursor_revision","cursor","state","connection_status_note"],"properties":{"schema_version":{"const":"1.0.0"},"config_revision":{"$ref":"#/$defs/Id"},"definition_sha256":{"$ref":"#/$defs/Hash"},"approval_state":{"enum":["DRAFT","APPROVED","REVOKED"]},"revision":{"$ref":"#/$defs/Revision"},"connected":{"type":"boolean"},"definition":{"type":"object"},"business_profile":{"type":["object","null"]},"blockers":{"type":"array","items":{"type":"string"}},"cursor_revision":{"$ref":"#/$defs/Revision"},"cursor":{},"state":{"enum":["BLOCKED","READY_FOR_VERIFICATION","VERIFIED"]},"connection_status_note":{"type":"string"},"last_verification":{"$ref":"#/$defs/Observation"},"last_sync":{"$ref":"#/$defs/Observation"}}},
  "History":{"type":"object","additionalProperties":false,"required":["schema_version","config_revision","kind","items","complete","next_after"],"properties":{"schema_version":{"const":"1.0.0"},"config_revision":{"$ref":"#/$defs/Id"},"kind":{"enum":["DECIDE","VERIFY","SYNC"]},"items":{"type":"array","maxItems":25,"items":{"type":"object","additionalProperties":false,"required":["operation_id","state","actor_id","created_at","updated_at","request","run"],"properties":{"operation_id":{"$ref":"#/$defs/Id"},"state":{"type":"string"},"actor_id":{"$ref":"#/$defs/Id"},"created_at":{"type":"string","format":"date-time"},"updated_at":{"type":"string","format":"date-time"},"request":{"type":"object"},"run":{"anyOf":[{"$ref":"#/$defs/Run"},{"type":"null"}]}}}},"complete":{"type":"boolean"},"next_after":{"anyOf":[{"$ref":"#/$defs/Id"},{"type":"null"}]}}},
  "DecisionInput":{"type":"object","additionalProperties":false,"required":["decision","definition_sha256","expected_revision","reason"],"properties":{"decision":{"enum":["APPROVED","REVOKED"]},"definition_sha256":{"$ref":"#/$defs/Hash"},"expected_revision":{"$ref":"#/$defs/Revision"},"reason":{"type":"string","minLength":1,"maxLength":4096}}},
  "VerifyInput":{"type":"object","additionalProperties":false,"required":["definition_sha256"],"properties":{"definition_sha256":{"$ref":"#/$defs/Hash"}}},
  "SyncInput":{"type":"object","additionalProperties":false,"required":["definition_sha256","expected_cursor_revision","maximum_items"],"properties":{"definition_sha256":{"$ref":"#/$defs/Hash"},"expected_cursor_revision":{"$ref":"#/$defs/Revision"},"maximum_items":{"type":"integer","minimum":1,"maximum":25}}},
  "Run":{"type":"object","additionalProperties":false,"required":["schema_version","operation_id","config_revision","state","formal_source_approval","failure","request","result_sha256","items"],"properties":{"schema_version":{"const":"1.0.0"},"operation_id":{"$ref":"#/$defs/Id"},"config_revision":{"$ref":"#/$defs/Id"},"state":{"type":"string"},"formal_source_approval":{"const":false},"failure":{"type":["string","null"]},"request":{"type":"object"},"result_sha256":{"anyOf":[{"$ref":"#/$defs/Hash"},{"type":"null"}]},"items":{"type":"array","maxItems":26,"items":{"type":"object","additionalProperties":false,"required":["item_id","state","original_sha256","upload_id"],"properties":{"item_id":{"$ref":"#/$defs/Id"},"state":{"type":"string"},"original_sha256":{"$ref":"#/$defs/Hash"},"upload_id":{"anyOf":[{"$ref":"#/$defs/Id"},{"type":"null"}]}}}},"original_result":{"type":"object"},"originals_withheld":{"const":"OWNERSHIP_REVOCATION_REQUIRES_FILTERED_REVIEW"}}},
  "Lookup":{"type":"object","additionalProperties":false,"required":["schema_version","kind","state","record","configuration"],"properties":{"schema_version":{"const":"1.0.0"},"kind":{"enum":["CREATE","DECIDE","VERIFY","SYNC"]},"state":{"enum":["FOUND","NOT_FOUND"]},"record":{"type":["object","null"]},"configuration":{"anyOf":[{"$ref":"#/$defs/Configuration"},{"type":"null"}]}}},
  "Workspace":{"type":"object","additionalProperties":false,"required":["schema_version","current_context","identity_mode","allowed_actions","approved_credential_directory_configured","customer_protocol_adapter_configured"],"properties":{"schema_version":{"const":"1.0.0"},"current_context":{"type":"object"},"identity_mode":{"enum":["local","oidc"]},"allowed_actions":{"type":"array","uniqueItems":true,"items":{"enum":["connector.read","connector.configure","connector.approve","connector.sync"]}},"approved_credential_directory_configured":{"type":"boolean"},"customer_protocol_adapter_configured":{"type":"boolean"}}},
  "DirectoryEntry":{"type":"object","additionalProperties":false,"required":["connector_id","head_revision","created_at","updated_at","configuration"],"properties":{"connector_id":{"$ref":"#/$defs/Id"},"head_revision":{"$ref":"#/$defs/Revision"},"created_at":{"type":"string","format":"date-time"},"updated_at":{"type":"string","format":"date-time"},"configuration":{"$ref":"#/$defs/Configuration"}}},
  "Directory":{"type":"object","additionalProperties":false,"required":["schema_version","project_id","items","complete","next_after","pagination_mode"],"properties":{"schema_version":{"const":"1.0.0"},"project_id":{"$ref":"#/$defs/Id"},"items":{"type":"array","maxItems":25,"items":{"$ref":"#/$defs/DirectoryEntry"}},"complete":{"type":"boolean"},"next_after":{"anyOf":[{"$ref":"#/$defs/Id"},{"type":"null"}]},"pagination_mode":{"const":"LIVE_DIRECTORY"}}}
 }
}
