{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:medical:formal-evaluation-input:1.0.0",
  "$defs": {
    "Document": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "document_type",
        "language",
        "sections"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "document_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "language": {
          "type": "string",
          "pattern": "^[A-Za-z]{2,8}(-[A-Za-z0-9]{1,8})*$",
          "maxLength": 64
        },
        "sections": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "section_id",
              "title",
              "text"
            ],
            "properties": {
              "section_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
              },
              "title": {
                "type": "string",
                "maxLength": 256
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 65536
              }
            }
          }
        }
      }
    }
  }
}
