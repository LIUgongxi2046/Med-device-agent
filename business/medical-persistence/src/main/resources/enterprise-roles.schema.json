{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:medical:enterprise-roles:1.0.0",
  "$defs":{
    "Id":{"type":"string","format":"uuid","pattern":"^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
    "Revision":{"type":"string","pattern":"^(0|[1-9][0-9]{0,19})$"},
    "Hash":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "Time":{"type":"string","format":"date-time","pattern":"^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"},
    "NullableTime":{"anyOf":[{"$ref":"#/$defs/Time"},{"type":"null"}]},
    "Basis":{"type":"object","additionalProperties":false,"required":["version_id","content_sha256"],"properties":{"version_id":{"$ref":"#/$defs/Id"},"content_sha256":{"$ref":"#/$defs/Hash"}}},
    "Publish":{"type":"object","additionalProperties":false,"required":["schema_version","name","definition","valid_from","valid_to","approval_basis","reason","approval_attested","expected_head_revision"],"properties":{"schema_version":{"const":"1.0.0"},"name":{"type":"string","minLength":1,"maxLength":120},"definition":{"type":"object"},"valid_from":{"$ref":"#/$defs/Time"},"valid_to":{"$ref":"#/$defs/NullableTime"},"approval_basis":{"$ref":"#/$defs/Basis"},"reason":{"type":"string","minLength":1,"maxLength":2000},"approval_attested":{"const":true},"expected_head_revision":{"$ref":"#/$defs/Revision"}}},
    "Revoke":{"type":"object","additionalProperties":false,"required":["schema_version","expected_revision","reason","approval_attested"],"properties":{"schema_version":{"const":"1.0.0"},"expected_revision":{"$ref":"#/$defs/Revision"},"reason":{"type":"string","minLength":1,"maxLength":2000},"approval_attested":{"const":true}}},
    "Head":{"type":"object","additionalProperties":false,"required":["current_version","revision"],"properties":{"current_version":{"$ref":"#/$defs/Id"},"revision":{"$ref":"#/$defs/Revision"}}},
    "Role":{"type":"object","additionalProperties":false,"required":["schema_version","tenant_id","role_id","version_id","name","definition","status","revision","content_sha256","approved_by","approved_at","valid_from","valid_to","approval_basis","reason","authority_grant","authority_revision","head"],"properties":{"schema_version":{"const":"1.0.0"},"tenant_id":{"$ref":"#/$defs/Id"},"role_id":{"$ref":"#/$defs/Id"},"version_id":{"$ref":"#/$defs/Id"},"name":{"type":"string","minLength":1,"maxLength":120},"definition":{"type":"object"},"status":{"enum":["ACTIVE","REVOKED"]},"revision":{"$ref":"#/$defs/Revision"},"content_sha256":{"$ref":"#/$defs/Hash"},"approved_by":{"$ref":"#/$defs/Id"},"approved_at":{"$ref":"#/$defs/Time"},"valid_from":{"$ref":"#/$defs/Time"},"valid_to":{"$ref":"#/$defs/NullableTime"},"approval_basis":{"$ref":"#/$defs/Basis"},"reason":{"type":"string","minLength":1,"maxLength":2000},"authority_grant":{"$ref":"#/$defs/Id"},"authority_revision":{"$ref":"#/$defs/Revision"},"head":{"$ref":"#/$defs/Head"}}},
    "Listing":{"type":"object","additionalProperties":false,"required":["schema_version","roles","next_after"],"properties":{"schema_version":{"const":"1.0.0"},"roles":{"type":"array","maxItems":100,"items":{"$ref":"#/$defs/Role"}},"next_after":{"anyOf":[{"$ref":"#/$defs/Id"},{"type":"null"}]}}},
    "Context":{"type":"object","additionalProperties":false,"required":["tenant_id","context_revision","auth_epoch","governance_epoch"],"properties":{"tenant_id":{"$ref":"#/$defs/Id"},"context_revision":{"$ref":"#/$defs/Revision"},"auth_epoch":{"$ref":"#/$defs/Revision"},"governance_epoch":{"$ref":"#/$defs/Revision"}}},
    "Ids":{"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/Id"}},
    "Receipt":{"type":"object","additionalProperties":false,"required":["schema_version","operation_id","decision","role","revoked_grants","terminated_invitations","current_context"],"properties":{"schema_version":{"const":"1.0.0"},"operation_id":{"$ref":"#/$defs/Id"},"decision":{"enum":["PUBLISH","REVOKE"]},"role":{"$ref":"#/$defs/Role"},"revoked_grants":{"$ref":"#/$defs/Ids"},"terminated_invitations":{"$ref":"#/$defs/Ids"},"current_context":{"$ref":"#/$defs/Context"}}}
  }
}
