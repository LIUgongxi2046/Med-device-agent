{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:medical:document-history-feature-availability:1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "current_context",
    "features",
    "maximum_page_size"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "current_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tenant_id",
        "context_revision",
        "auth_epoch",
        "governance_epoch"
      ],
      "properties": {
        "tenant_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "context_revision": {
          "$ref": "#/$defs/Revision"
        },
        "auth_epoch": {
          "$ref": "#/$defs/Revision"
        },
        "governance_epoch": {
          "$ref": "#/$defs/Revision"
        }
      }
    },
    "features": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document_history"
      ],
      "properties": {
        "document_history": {
          "type": "boolean"
        }
      }
    },
    "maximum_page_size": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1,
      "maximum": 2147483646
    }
  },
  "$defs": {
    "Revision": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,19}$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "features": {
            "properties": {
              "document_history": {
                "const": true
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "maximum_page_size": {
            "type": "integer"
          }
        }
      },
      "else": {
        "properties": {
          "maximum_page_size": {
            "type": "null"
          }
        }
      }
    }
  ]
}
