{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:medical:embedding-request:1.0.0",
  "type":"object",
  "additionalProperties":false,
  "required":["model","input","dimensions","encoding_format"],
  "properties":{
    "model":{"type":"string","minLength":1,"maxLength":256},
    "input":{"type":"array","minItems":1,"maxItems":10000,"items":{"type":"string","minLength":1}},
    "dimensions":{"type":"integer","minimum":1,"maximum":4096},
    "encoding_format":{"const":"float"}
  }
}
