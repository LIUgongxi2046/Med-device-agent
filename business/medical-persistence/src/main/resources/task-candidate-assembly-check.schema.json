{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:medical:task-candidate-assembly-check:1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "check_id",
    "target_id",
    "target_revision",
    "report_artifact_id",
    "audit_id",
    "event_id",
    "input_sha256",
    "report_sha256",
    "report_receipt_sha256",
    "schema_version",
    "target_kind",
    "status",
    "professional_approval",
    "document_saved",
    "n07_complete",
    "blockers",
    "input_watermarks"
  ],
  "properties": {
    "check_id": {
      "type": "string",
      "format": "uuid"
    },
    "target_id": {
      "type": "string",
      "format": "uuid"
    },
    "target_revision": {
      "type": "string",
      "format": "uuid"
    },
    "report_artifact_id": {
      "type": "string",
      "format": "uuid"
    },
    "audit_id": {
      "type": "string",
      "format": "uuid"
    },
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "input_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "report_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "report_receipt_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "target_kind": {
      "const": "CANDIDATE_SET"
    },
    "status": {
      "enum": [
        "SUCCEEDED",
        "WAITING_INPUT"
      ]
    },
    "professional_approval": {
      "const": false
    },
    "document_saved": {
      "const": false
    },
    "n07_complete": {
      "const": false
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "input_watermarks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      }
    }
  }
}