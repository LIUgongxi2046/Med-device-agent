{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.medical-agent.invalid/2.0.0/document-export-command",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "2.0.0"
    },
    "tenant_id": {
      "type": "string",
      "format": "uuid"
    },
    "project_id": {
      "type": "string",
      "format": "uuid"
    },
    "document_revision": {
      "type": "string",
      "format": "uuid"
    },
    "attempt_id": {
      "type": "string",
      "format": "uuid"
    },
    "template_version": {
      "type": "string",
      "format": "uuid"
    },
    "font_manifest_revision": {
      "type": "string",
      "format": "uuid"
    },
    "body_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "template_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "body_schema_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "body_schema_ref": {
      "const": "https://schemas.medical-agent.invalid/2.0.0/document-body#/$defs/DocumentBody"
    },
    "body_path": {
      "type": "string",
      "minLength": 1
    },
    "template_path": {
      "type": "string",
      "minLength": 1
    },
    "catalogue_root": {
      "type": "string",
      "minLength": 1
    },
    "output_directory": {
      "type": "string",
      "minLength": 1
    },
    "purpose": {
      "enum": [
        "FORMAL_BODY",
        "REVIEW_PACKAGE",
        "INTERNAL_EXCHANGE"
      ]
    },
    "input_data_kind": {
      "enum": [
        "SIMULATION",
        "REGISTERED"
      ]
    },
    "format": {
      "enum": [
        "DOCX",
        "PDF",
        "MARKDOWN"
      ]
    },
    "fonts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artifact_id",
          "path",
          "sha256",
          "media_type"
        ],
        "properties": {
          "artifact_id": {
            "type": "string",
            "format": "uuid"
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "media_type": {
            "enum": [
              "image/png",
              "image/jpeg"
            ]
          }
        }
      }
    },
    "converter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revision",
        "path",
        "version",
        "timeout_seconds",
        "sha256"
      ],
      "properties": {
        "revision": {
          "type": "string",
          "format": "uuid"
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 600
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "layout_profile": {
      "type": [
        "object",
        "null"
      ]
    }
  },
  "required": [
    "schema_version",
    "tenant_id",
    "project_id",
    "document_revision",
    "attempt_id",
    "template_version",
    "font_manifest_revision",
    "body_sha256",
    "template_sha256",
    "body_schema_sha256",
    "body_schema_ref",
    "body_path",
    "template_path",
    "catalogue_root",
    "output_directory",
    "purpose",
    "input_data_kind",
    "format",
    "fonts",
    "assets",
    "converter",
    "layout_profile"
  ]
}
