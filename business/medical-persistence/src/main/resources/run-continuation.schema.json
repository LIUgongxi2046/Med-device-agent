{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:medical:run-continuation:1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "mode",
    "task_revision",
    "plan_revision",
    "snapshot_id",
    "budget_revision",
    "expected_revision",
    "input_decision_id",
    "reason"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "mode": {
      "enum": [
        "RESUME",
        "REEXECUTE_PINNED",
        "RERUN_UPDATED"
      ]
    },
    "task_revision": {
      "type": "string",
      "format": "uuid"
    },
    "plan_revision": {
      "type": "string",
      "format": "uuid"
    },
    "snapshot_id": {
      "type": "string",
      "format": "uuid"
    },
    "budget_revision": {
      "type": "string",
      "format": "uuid"
    },
    "expected_revision": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$"
    },
    "input_decision_id": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "mode": {
            "const": "RESUME"
          }
        }
      },
      "then": {
        "properties": {
          "input_decision_id": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "input_decision_id": {
            "type": "string",
            "format": "uuid"
          }
        }
      }
    }
  ]
}
