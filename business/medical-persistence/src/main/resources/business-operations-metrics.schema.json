                "known_amount": {
                  "type": "string",
                  "pattern": "^[0-9]+(\\.[0-9]+)?$"
                },
                "known_tokens": {
                  "type": "string",
                  "pattern": "^[0-9]+$"
                },
                "total_amount": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^[0-9]+(\\.[0-9]+)?$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "known_provider_calls": {
                  "type": "string",
                  "pattern": "^[0-9]+$"
                }
              },
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "unknown_count": {
                        "minimum": 1
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "total_amount": {
                        "type": "null"
                      }
                    }
                  }
                }
              ]
            }
          }
        }
      }
    }
  }
