{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:medical:document-comparison-views:1.0.0",
  "$defs": {
    "Id": {
      "type": "string",
      "format": "uuid"
    },
    "Revision": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$",
      "maxLength": 20
    },
    "Hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "NullableId": {
      "oneOf": [
        {
          "$ref": "#/$defs/Id"
        },
        {
          "type": "null"
        }
      ]
    },
    "NullableHash": {
      "oneOf": [
        {
          "$ref": "#/$defs/Hash"
        },
        {
          "type": "null"
        }
      ]
    },
    "Ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/Id"
      }
    },
    "Coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selection_sha256",
        "delivered_sha256",
        "complete",
        "next_cursor"
      ],
      "properties": {
        "selection_sha256": {
          "$ref": "#/$defs/Hash"
        },
        "delivered_sha256": {
          "$ref": "#/$defs/Hash"
        },
        "complete": {
          "type": "boolean"
        },
        "next_cursor": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      },
      "oneOf": [
        {
          "properties": {
            "complete": {
              "const": true
            },
            "next_cursor": {
              "type": "null"
            }
          }
        },
        {
          "properties": {
            "complete": {
              "const": false
            },
            "next_cursor": {
              "type": "string"
            }
          }
        }
      ]
    },
    "ArtifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "sha256",
        "schema_ref",
        "coverage"
      ],
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/Id"
        },
        "sha256": {
          "$ref": "#/$defs/Hash"
        },
        "schema_ref": {
          "type": "string",
          "minLength": 1
        },
        "coverage": {
          "$ref": "#/$defs/Coverage"
        }
      }
    },
    "Comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "comparison_id",
        "comparison_revision",
        "left_id",
        "right_revision",
        "differences",
        "affected_node_ids"
      ],
      "properties": {
        "comparison_id": {
          "$ref": "#/$defs/Id"
        },
        "comparison_revision": {
          "$ref": "#/$defs/Revision"
        },
        "left_id": {
          "$ref": "#/$defs/Id"
        },
        "right_revision": {
          "$ref": "#/$defs/Id"
        },
        "differences": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "affected_node_ids": {
          "$ref": "#/$defs/Ids"
        }
      }
    },
    "CompareRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document_id",
        "left_revision",
        "right_revision"
      ],
      "properties": {
        "document_id": {
          "$ref": "#/$defs/Id"
        },
        "left_revision": {
          "$ref": "#/$defs/Id"
        },
        "right_revision": {
          "$ref": "#/$defs/Id"
        }
      }
    },
    "CoreResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "kind",
        "algorithm_id",
        "implementation_sha256",
        "schema_sha256",
        "body_schema_sha256",
        "request",
        "left_body_sha256",
        "right_body_sha256",
        "limits",
        "input_sha256",
        "semantic_assessment",
        "record_count",
        "records",
        "affected_node_ids",
        "left_affected_section_ids",
        "right_affected_section_ids",
        "coverage"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "kind": {
          "const": "FIXED_DOCUMENT_STRUCTURE_CORE"
        },
        "algorithm_id": {
          "const": "urn:medical:fixed-structure:stable-ids-prefix-suffix:1.0.0"
        },
        "implementation_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "schema_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "body_schema_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "request": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "document_id",
            "left_revision",
            "right_revision"
          ],
          "properties": {
            "document_id": {
              "type": "string",
              "format": "uuid"
            },
            "left_revision": {
              "type": "string",
              "format": "uuid"
            },
            "right_revision": {
              "type": "string",
              "format": "uuid"
            }
          }
        },
        "left_body_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "right_body_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "maximum_nodes",
            "maximum_cells",
            "maximum_relationships",
            "maximum_input_bytes",
            "maximum_result_bytes",
            "maximum_records",
            "maximum_text_code_points",
            "maximum_work",
            "maximum_milliseconds"
          ],
          "properties": {
            "maximum_nodes": {
              "type": "integer",
              "minimum": 1
            },
            "maximum_cells": {
              "type": "integer",
              "minimum": 1
            },
            "maximum_relationships": {
              "type": "integer",
              "minimum": 1
            },
            "maximum_input_bytes": {
              "type": "integer",
              "minimum": 1
            },
            "maximum_result_bytes": {
              "type": "integer",
              "minimum": 1
            },
            "maximum_records": {
              "type": "integer",
              "minimum": 1
            },
            "maximum_text_code_points": {
              "type": "integer",
              "minimum": 1
            },
            "maximum_work": {
              "type": "integer",
              "minimum": 1
            },
            "maximum_milliseconds": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "input_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "semantic_assessment": {
          "const": "NOT_PERFORMED"
        },
        "record_count": {
          "type": "integer",
          "minimum": 0
        },
        "records": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "category",
              "identity",
              "status",
              "before_json",
              "after_json",
              "before_sha256",
              "after_sha256",
              "text_change"
            ],
            "properties": {
              "category": {
                "enum": [
                  "BODY_METADATA",
                  "NODE",
                  "FIELD",
                  "EVIDENCE",
                  "FACT",
                  "TABLE_ROW",
                  "TABLE_COLUMN",
                  "TABLE_CELL",
                  "ORDER"
                ]
              },
              "identity": {
                "type": "string"
              },
              "status": {
                "enum": [
                  "ADDED",
                  "REMOVED",
                  "CHANGED",
                  "UNCHANGED"
                ]
              },
              "before_json": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "after_json": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "before_sha256": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "after_sha256": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "text_change": {
                "anyOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "node_id",
                      "left",
                      "right"
                    ],
                    "properties": {
                      "node_id": {
                        "type": "string",
                        "format": "uuid"
                      },
                      "left": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "start",
                          "end",
                          "quote",
                          "quote_sha256"
                        ],
                        "properties": {
                          "start": {
                            "type": "integer",
                            "minimum": 0
                          },
                          "end": {
                            "type": "integer",
                            "minimum": 0
                          },
                          "quote": {
                            "type": "string"
                          },
                          "quote_sha256": {
                            "type": "string",
                            "pattern": "^[a-f0-9]{64}$"
                          }
                        }
                      },
                      "right": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "start",
                          "end",
                          "quote",
                          "quote_sha256"
                        ],
                        "properties": {
                          "start": {
                            "type": "integer",
                            "minimum": 0
                          },
                          "end": {
                            "type": "integer",
                            "minimum": 0
                          },
                          "quote": {
                            "type": "string"
                          },
                          "quote_sha256": {
                            "type": "string",
                            "pattern": "^[a-f0-9]{64}$"
                          }
                        }
                      }
                    }
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          }
        },
        "affected_node_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "left_affected_section_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "right_affected_section_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "coverage": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "selection_sha256",
            "delivered_sha256",
            "complete",
            "next_cursor"
          ],
          "properties": {
            "selection_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "delivered_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "complete": {
              "const": true
            },
            "next_cursor": {
              "type": "null"
            }
          }
        }
      }
    },
    "Read": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "current_document_revision",
        "document_head_revision",
        "left_is_current",
        "right_is_current",
        "comparison",
        "result"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "current_document_revision": {
          "$ref": "#/$defs/NullableId"
        },
        "document_head_revision": {
          "$ref": "#/$defs/Revision"
        },
        "left_is_current": {
          "type": "boolean"
        },
        "right_is_current": {
          "type": "boolean"
        },
        "comparison": {
          "$ref": "#/$defs/Comparison"
        },
        "result": {
          "$ref": "#/$defs/CoreResult"
        }
      }
    },
    "Recovery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "state",
        "request_body_sha256",
        "comparison_id",
        "comparison"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "state": {
          "enum": [
            "NOT_FOUND",
            "PROCESSING",
            "COMPLETED"
          ]
        },
        "request_body_sha256": {
          "$ref": "#/$defs/NullableHash"
        },
        "comparison_id": {
          "$ref": "#/$defs/NullableId"
        },
        "comparison": {
          "oneOf": [
            {
              "$ref": "#/$defs/Comparison"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "NOT_FOUND"
              }
            }
          },
          "then": {
            "properties": {
              "request_body_sha256": {
                "type": "null"
              },
              "comparison_id": {
                "type": "null"
              },
              "comparison": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "PROCESSING"
              }
            }
          },
          "then": {
            "properties": {
              "request_body_sha256": {
                "$ref": "#/$defs/Hash"
              },
              "comparison_id": {
                "$ref": "#/$defs/Id"
              },
              "comparison": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "COMPLETED"
              }
            }
          },
          "then": {
            "properties": {
              "request_body_sha256": {
                "$ref": "#/$defs/Hash"
              },
              "comparison_id": {
                "$ref": "#/$defs/Id"
              },
              "comparison": {
                "$ref": "#/$defs/Comparison"
              }
            }
          }
        }
      ]
    }
  }
}
