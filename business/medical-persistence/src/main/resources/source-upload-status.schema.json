{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:medical:source-upload-status:1.0.0",
  "$defs":{
    "Id":{"type":"string","format":"uuid","pattern":"^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"},
    "Hash":{"type":"string","pattern":"^[a-f0-9]{64}$"},
    "Revision":{"type":"string","pattern":"^[1-9][0-9]{0,19}$"},
    "Unsigned":{"type":"string","pattern":"^(?:0|[1-9][0-9]{0,19})$"},
    "NullableId":{"anyOf":[{"type":"null"},{"$ref":"#/$defs/Id"}]},
    "Basis":{"type":"object","additionalProperties":false,"required":["version_id","content_sha256"],"properties":{"version_id":{"$ref":"#/$defs/Id"},"content_sha256":{"$ref":"#/$defs/Hash"}}},
    "Completion":{
      "type":"object","additionalProperties":false,
      "required":["operation_id","operation_state","result_status","source_id","source_version","registered_rights_revision","parse_version","attempt_id","run_id","error_code","reason"],
      "properties":{
        "operation_id":{"$ref":"#/$defs/Id"},"operation_state":{"enum":["PROCESSING","COMPLETED","FAILED"]},
        "result_status":{"enum":[null,"REGISTERED","DUPLICATE","FAILED"]},
        "source_id":{"$ref":"#/$defs/NullableId"},"source_version":{"$ref":"#/$defs/NullableId"},
        "registered_rights_revision":{"$ref":"#/$defs/NullableId"},"parse_version":{"$ref":"#/$defs/NullableId"},
        "attempt_id":{"$ref":"#/$defs/NullableId"},"run_id":{"$ref":"#/$defs/NullableId"},
        "error_code":{"enum":[null,"PROCESSING_FAILED"]},
        "reason":{"enum":[null,"UPLOAD_EXPIRED","EXECUTION_DEADLINE","ATTEMPT_LIMIT","SOURCE_VALIDATION_FAILED"]}
      },
      "allOf":[
        {"if":{"properties":{"operation_state":{"const":"PROCESSING"}}},"then":{"properties":{"result_status":{"type":"null"},"source_id":{"type":"null"},"source_version":{"type":"null"},"registered_rights_revision":{"type":"null"},"parse_version":{"type":"null"},"attempt_id":{"type":"null"},"run_id":{"type":"null"},"error_code":{"type":"null"},"reason":{"type":"null"}}}},
        {"if":{"properties":{"operation_state":{"const":"COMPLETED"}}},"then":{"properties":{"result_status":{"enum":["REGISTERED","DUPLICATE"]},"source_id":{"$ref":"#/$defs/Id"},"source_version":{"$ref":"#/$defs/Id"},"registered_rights_revision":{"$ref":"#/$defs/Id"},"error_code":{"type":"null"},"reason":{"type":"null"}}}},
        {"if":{"properties":{"operation_state":{"const":"FAILED"}}},"then":{"properties":{"result_status":{"const":"FAILED"},"source_id":{"type":"null"},"source_version":{"type":"null"},"registered_rights_revision":{"type":"null"},"parse_version":{"type":"null"},"attempt_id":{"type":"null"},"run_id":{"type":"null"},"error_code":{"const":"PROCESSING_FAILED"},"reason":{"type":"string"}}}},
        {"if":{"properties":{"result_status":{"const":"REGISTERED"}}},"then":{"properties":{"parse_version":{"$ref":"#/$defs/Id"},"attempt_id":{"$ref":"#/$defs/Id"},"run_id":{"$ref":"#/$defs/Id"}}}},
        {"if":{"properties":{"result_status":{"const":"DUPLICATE"}}},"then":{"properties":{"parse_version":{"type":"null"},"attempt_id":{"type":"null"},"run_id":{"type":"null"}}}}
      ]
    },
    "SourceReview":{
      "type":"object","additionalProperties":false,
      "required":["parse_version","parse_status","index_version","index_mode","index_status","expected_count","verified_count","approval_revision","approval_status","upload_status","lifecycle","gate_revision","current_decision","reviewed_manifest_sha256","decided_at","review_manifest","review_manifest_sha256"],
      "properties":{
        "parse_version":{"$ref":"#/$defs/Id"},"parse_status":{"enum":["QUEUED","PROCESSING","COMPLETE","PARTIAL_FAILED","FAILED"]},
        "index_version":{"oneOf":[{"type":"null"},{"$ref":"#/$defs/Id"}]},"index_mode":{"type":["string","null"]},"index_status":{"type":["string","null"]},
        "expected_count":{"type":["string","null"],"pattern":"^(0|[1-9][0-9]*)$"},"verified_count":{"type":["string","null"],"pattern":"^(0|[1-9][0-9]*)$"},
        "approval_revision":{"oneOf":[{"type":"null"},{"$ref":"#/$defs/Id"}]},"approval_status":{"enum":["PENDING","APPROVED","DISABLED"]},
        "upload_status":{"enum":["PENDING","UPLOADING","RECEIVED","FAILED"]},"lifecycle":{"enum":["ACTIVE","RECYCLED","PURGE_PENDING","PURGED"]},
        "gate_revision":{"$ref":"#/$defs/Revision"},"current_decision":{"type":["string","null"]},
        "reviewed_manifest_sha256":{"oneOf":[{"type":"null"},{"$ref":"#/$defs/Hash"}]},"decided_at":{"type":["string","null"],"format":"date-time"},
        "review_manifest":{"type":"object"},"review_manifest_sha256":{"$ref":"#/$defs/Hash"}
      }
    },
    "Source":{
      "type":"object","additionalProperties":false,
      "required":["source_id","source_version","original_sha256","current_rights","rights_status","lifecycle","reviews"],
      "properties":{"source_id":{"$ref":"#/$defs/Id"},"source_version":{"$ref":"#/$defs/Id"},"original_sha256":{"$ref":"#/$defs/Hash"},"current_rights":{"$ref":"#/$defs/Basis"},"rights_status":{"enum":["PENDING_REVIEW","APPROVED","REVOKED","EXPIRED"]},"lifecycle":{"enum":["ACTIVE","RECYCLED","PURGE_PENDING","PURGED"]},"reviews":{"type":"array","minItems":1,"maxItems":1000,"items":{"$ref":"#/$defs/SourceReview"}}}
    },
    "Attempt":{
      "type":"object","additionalProperties":false,"required":["attempt_id","run_id","config_revision","status","revision","updated_at","failure_manifest"],
      "properties":{"attempt_id":{"$ref":"#/$defs/Id"},"run_id":{"$ref":"#/$defs/Id"},"config_revision":{"$ref":"#/$defs/Id"},"status":{"enum":["QUEUED","RUNNING","SUCCEEDED","FAILED","CANCELLED"]},"revision":{"$ref":"#/$defs/Revision"},"updated_at":{"type":"string","format":"date-time"},"failure_manifest":{"type":"object","additionalProperties":false,"required":["schema_version","issues"],"properties":{"schema_version":{"const":"1.0.0"},"issues":{"type":"array","items":{"type":"object"}}}}}
    },
    "View":{
      "type":"object","additionalProperties":false,
      "required":["schema_version","upload_id","upload_revision","received_size","upload_status","transfer_state","completion","source","attempt"],
      "properties":{"schema_version":{"const":"1.0.0"},"upload_id":{"$ref":"#/$defs/Id"},"upload_revision":{"$ref":"#/$defs/Revision"},"received_size":{"$ref":"#/$defs/Unsigned"},"upload_status":{"enum":["PENDING","UPLOADING","RECEIVED","FAILED"]},"transfer_state":{"enum":["ACTIVE","COMPLETING","COMPLETED","CANCELLED","EXPIRED","FAILED"]},"completion":{"anyOf":[{"type":"null"},{"$ref":"#/$defs/Completion"}]},"source":{"anyOf":[{"type":"null"},{"$ref":"#/$defs/Source"}]},"attempt":{"anyOf":[{"type":"null"},{"$ref":"#/$defs/Attempt"}]}},
      "allOf":[
        {"if":{"properties":{"completion":{"type":"object","properties":{"operation_state":{"const":"COMPLETED"}}}}},"then":{"properties":{"source":{"$ref":"#/$defs/Source"}}},"else":{"properties":{"source":{"type":"null"},"attempt":{"type":"null"}}}},
        {"if":{"properties":{"completion":{"type":"object","properties":{"result_status":{"const":"REGISTERED"}}}}},"then":{"properties":{"attempt":{"$ref":"#/$defs/Attempt"}}},"else":{"properties":{"attempt":{"type":"null"}}}}
      ]
    }
  }
}
