{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:medical:formal-evaluation-input-workflow:1.0.0",
  "$defs": {
    "Register": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "project_id": {
          "type": "null"
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "version_id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[1-5][a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$"
            },
            "content_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "version_id",
            "content_sha256"
          ]
        },
        "rights_revision": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[1-5][a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$"
        },
        "purpose": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
        }
      },
      "required": [
        "schema_version",
        "project_id",
        "source",
        "rights_revision",
        "purpose"
      ]
    },
    "Receipt": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "project_id": {
          "type": "null"
        },
        "artifact_kind": {
          "const": "FORMAL_EVALUATION_INPUT"
        },
        "artifact": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "version_id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[1-5][a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$"
            },
            "content_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "version_id",
            "content_sha256"
          ]
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "version_id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[1-5][a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$"
            },
            "content_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "version_id",
            "content_sha256"
          ]
        },
        "rights_revision": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[1-5][a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$"
        },
        "purpose": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
        },
        "operation_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[1-5][a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$"
        },
        "created_by": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[1-5][a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "input_schema_ref": {
          "const": "urn:medical:formal-evaluation-input:1.0.0#/$defs/Document"
        },
        "input_schema_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "schema_version",
        "project_id",
        "artifact_kind",
        "artifact",
        "source",
        "rights_revision",
        "purpose",
        "operation_id",
        "created_by",
        "created_at",
        "input_schema_ref",
        "input_schema_sha256"
      ]
    },
    "Read": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "receipt": {
          "$ref": "#/$defs/Receipt"
        },
        "document": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema_version",
            "document_type",
            "language",
            "sections"
          ],
          "properties": {
            "schema_version": {
              "const": "1.0.0"
            },
            "document_type": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "language": {
              "type": "string",
              "pattern": "^[A-Za-z]{2,8}(-[A-Za-z0-9]{1,8})*$",
              "maxLength": 64
            },
            "sections": {
              "type": "array",
              "minItems": 1,
              "maxItems": 256,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "section_id",
                  "title",
                  "text"
                ],
                "properties": {
                  "section_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128,
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
                  },
                  "title": {
                    "type": "string",
                    "maxLength": 256
                  },
                  "text": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 65536
                  }
                }
              }
            }
          }
        }
      },
      "required": [
        "receipt",
        "document"
      ]
    },
    "Availability": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "enabled": {
          "type": "boolean"
        },
        "scope": {
          "const": "ENTERPRISE"
        },
        "maximum_bytes": {
          "const": 2097152
        },
        "input_schema_ref": {
          "const": "urn:medical:formal-evaluation-input:1.0.0#/$defs/Document"
        },
        "input_schema_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "unavailable_reason": {
          "enum": [
            null,
            "FEATURE_DISABLED"
          ]
        }
      },
      "required": [
        "schema_version",
        "enabled",
        "scope",
        "maximum_bytes",
        "input_schema_ref",
        "input_schema_sha256",
        "unavailable_reason"
      ]
    }
  }
}
