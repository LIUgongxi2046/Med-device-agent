{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:medical:agent-execution-policy-feature-availability:1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "current_context",
    "features"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "current_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tenant_id",
        "context_revision",
        "auth_epoch",
        "governance_epoch"
      ],
      "properties": {
        "tenant_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "context_revision": {
          "$ref": "#/$defs/Revision"
        },
        "auth_epoch": {
          "$ref": "#/$defs/Revision"
        },
        "governance_epoch": {
          "$ref": "#/$defs/Revision"
        }
      }
    },
    "features": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_authoring",
        "model_policy_approval"
      ],
      "properties": {
        "policy_authoring": {
          "type": "boolean"
        },
        "model_policy_approval": {
          "type": "boolean"
        }
      }
    }
  },
  "$defs": {
    "Revision": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,19}$"
    }
  }
}
