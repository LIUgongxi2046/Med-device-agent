        "project_id",
        "task_id",
        "run_id",
        "step_id",
        "action_id",
        "session_id",
        "plan_revision",
        "snapshot_id",
        "input_artifact_id",
        "dependency_access_set_id",
        "input_sha256",
        "input_receipt_sha256",
        "deployment_sha256",
        "runtime_manifest_sha256",
        "prompt_sha256",
        "deployment_revision",
        "worker_service_uri",
        "compiled_prompt",
        "producer",
        "role_version",
        "model_version",
        "execution_policy_version",
        "prompt_provenance",
