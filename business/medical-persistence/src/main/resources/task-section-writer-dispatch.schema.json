        "input_artifact_id": {
          "type": "string",
          "format": "uuid"
        },
        "dependency_access_set_id": {
          "type": "string",
          "format": "uuid"
        },
        "input_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "input_receipt_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "deployment_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "runtime_manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
