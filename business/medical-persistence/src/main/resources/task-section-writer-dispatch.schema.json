        "compiled_prompt": {
          "type": "string",
          "minLength": 1
        },
        "producer": {
          "type": "object"
        },
        "role_version": {
          "type": "object"
        },
        "model_version": {
          "type": "object"
        },
        "execution_policy_version": {
          "type": "object"
        },
        "prompt_provenance": {
          "type": "object"
        },
        "schema_version": {
          "const": "1.0.0"
        },
        "execution_kind": {
          "const": "TASK"
