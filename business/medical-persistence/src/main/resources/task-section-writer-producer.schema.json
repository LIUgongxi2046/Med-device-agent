{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:medical:task-section-writer-producer:1.0.0",
  "$comment": "Bounded N04 production only. JSON never grants authority. Original 078/093 contracts remain unchanged.",
  "$defs": {
    "Id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "format": "uuid"
    },
    "Hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "Positive": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,19}$"
    },
    "Revision": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$"
    },
    "Instant": {
      "type": "string",
      "format": "date-time"
    },
    "Reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "Classification": {
      "enum": [
        "PUBLIC",
        "INTERNAL",
        "RESTRICTED",
        "PERSONAL_HEALTH"
      ]
    },
    "Key": {
      "type": "string",
      "pattern": "^[!-~]{16,128}$"
    },
    "VersionRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version_id",
        "content_sha256"
      ],
      "properties": {
        "version_id": {
          "$ref": "#/$defs/Id"
        },
        "content_sha256": {
          "$ref": "#/$defs/Hash"
        }
      }
    },
    "InputAuthor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "project_id",
        "task_id",
        "task_revision",
        "plan_revision",
        "template_version",
        "scope_snapshot",
        "release_id",
        "original_rule_id",
        "budget_revision",
        "task_input_sha256",
        "plan_sha256",
        "template_sha256",
        "source_manifest_sha256",
        "publication_approval_sha256",
        "original_rule_sha256",
        "original_approval_sha256",
        "role_version",
        "execution_policy",
        "maximum_bytes",
        "maximum_artifacts",
        "maximum_tokens",
        "maximum_calls",
        "maximum_amount",
        "currency",
        "valid_from",
        "valid_until",
        "section_ids",
        "artifact_kinds",
        "classification",
        "expected_revision",
        "reason",
        "operations",
        "enterprise_budget_basis"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "project_id": {
          "$ref": "#/$defs/Id"
        },
        "task_id": {
          "$ref": "#/$defs/Id"
        },
        "task_revision": {
          "$ref": "#/$defs/Id"
        },
        "plan_revision": {
          "$ref": "#/$defs/Id"
        },
        "template_version": {
          "$ref": "#/$defs/Id"
        },
        "scope_snapshot": {
          "$ref": "#/$defs/Id"
        },
        "release_id": {
          "$ref": "#/$defs/Id"
        },
        "original_rule_id": {
          "$ref": "#/$defs/Id"
        },
        "budget_revision": {
          "$ref": "#/$defs/Id"
        },
        "task_input_sha256": {
          "$ref": "#/$defs/Hash"
        },
        "plan_sha256": {
          "$ref": "#/$defs/Hash"
        },
        "template_sha256": {
          "$ref": "#/$defs/Hash"
        },
        "source_manifest_sha256": {
          "$ref": "#/$defs/Hash"
        },
        "publication_approval_sha256": {
          "$ref": "#/$defs/Hash"
        },
        "original_rule_sha256": {
          "$ref": "#/$defs/Hash"
        },
        "original_approval_sha256": {
          "$ref": "#/$defs/Hash"
        },
        "role_version": {
          "$ref": "#/$defs/VersionRef"
        },
        "execution_policy": {
          "$ref": "#/$defs/VersionRef"
        },
        "maximum_bytes": {
          "$ref": "#/$defs/Positive"
        },
        "maximum_artifacts": {
          "$ref": "#/$defs/Positive"
        },
        "maximum_tokens": {
          "$ref": "#/$defs/Positive"
        },
        "maximum_calls": {
          "$ref": "#/$defs/Positive"
        },
        "maximum_amount": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,15})(\\.[0-9]{1,6})?$"
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "valid_from": {
          "$ref": "#/$defs/Instant"
        },
        "valid_until": {
          "$ref": "#/$defs/Instant"
        },
        "section_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/Id"
          }
        },
        "artifact_kinds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 11,
          "uniqueItems": true,
          "items": {
            "enum": [
              "TASK_SECTION_WRITER_INPUT",
              "TASK_SECTION_WRITER_EXACT_INPUT",
              "SECTION_BODY",
              "SECTION_CANDIDATE",
              "STEP_ENVELOPE",
              "SESSION_EXPORT",
              "MODEL_RESULT",
              "PROVIDER_CAPTURE",
              "FIELD_CHECK_RESULT",
              "EVIDENCE_BUNDLE",
              "DOCUMENT_BODY"
            ]
          }
        },
        "classification": {
          "$ref": "#/$defs/Classification"
        },
        "expected_revision": {
          "const": "0"
        },
        "reason": {
          "$ref": "#/$defs/Reason"
        },
        "operations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "uniqueItems": true,
          "items": {
            "enum": [
              "NODE_PRODUCE",
              "HOST_INPUT_CONSUME",
              "HOST_PREDECESSOR_CONSUME",
              "HOST_ENVELOPE_CONSUME",
              "SUPERVISOR_PREPARE_READ",
              "MODEL_INPUT_CONSUME"
            ]
          }
        },
        "enterprise_budget_basis": {
          "$ref": "#/$defs/VersionRef"
        }
      }
    },
    "InputManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "project_id",
        "task_id",
        "task_revision",
        "plan_revision",
        "template_version",
        "scope_snapshot",
        "release_id",
        "original_rule_id",
        "budget_revision",
        "task_input_sha256",
        "plan_sha256",
        "template_sha256",
        "source_manifest_sha256",
        "publication_approval_sha256",
        "original_rule_sha256",
        "original_approval_sha256",
        "role_version",
        "execution_policy",
        "maximum_bytes",
        "maximum_artifacts",
        "maximum_tokens",
        "maximum_calls",
        "maximum_amount",
        "currency",
        "valid_from",
        "valid_until",
        "section_ids",
        "artifact_kinds",
        "classification",
        "tenant_id",
        "rule_id",
        "producer_node_kind",
        "purpose",
        "created_by",
        "created_at",
        "operations",
        "enterprise_budget_basis"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "project_id": {
          "$ref": "#/$defs/Id"
        },
        "task_id": {
          "$ref": "#/$defs/Id"
        },
        "task_revision": {
          "$ref": "#/$defs/Id"
        },
        "plan_revision": {
          "$ref": "#/$defs/Id"
        },
        "template_version": {
          "$ref": "#/$defs/Id"
        },
        "scope_snapshot": {
          "$ref": "#/$defs/Id"
        },
        "release_id": {
          "$ref": "#/$defs/Id"
        },
        "original_rule_id": {
          "$ref": "#/$defs/Id"
        },
        "budget_revision": {
          "$ref": "#/$defs/Id"
        },
        "task_input_sha256": {
          "$ref": "#/$defs/Hash"
        },
        "plan_sha256": {
          "$ref": "#/$defs/Hash"
        },
        "template_sha256": {
          "$ref": "#/$defs/Hash"
        },
        "source_manifest_sha256": {
          "$ref": "#/$defs/Hash"
        },
        "publication_approval_sha256": {
          "$ref": "#/$defs/Hash"
        },
        "original_rule_sha256": {
          "$ref": "#/$defs/Hash"
        },
        "original_approval_sha256": {
          "$ref": "#/$defs/Hash"
        },
        "role_version": {
          "$ref": "#/$defs/VersionRef"
        },
        "execution_policy": {
          "$ref": "#/$defs/VersionRef"
        },
        "maximum_bytes": {
          "$ref": "#/$defs/Positive"
        },
        "maximum_artifacts": {
          "$ref": "#/$defs/Positive"
        },
        "maximum_tokens": {
          "$ref": "#/$defs/Positive"
        },
        "maximum_calls": {
          "$ref": "#/$defs/Positive"
        },
        "maximum_amount": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,15})(\\.[0-9]{1,6})?$"
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "valid_from": {
          "$ref": "#/$defs/Instant"
        },
        "valid_until": {
          "$ref": "#/$defs/Instant"
        },
        "section_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/Id"
          }
        },
        "artifact_kinds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 11,
          "uniqueItems": true,
          "items": {
            "enum": [
              "TASK_SECTION_WRITER_INPUT",
              "TASK_SECTION_WRITER_EXACT_INPUT",
              "SECTION_BODY",
              "SECTION_CANDIDATE",
              "STEP_ENVELOPE",
              "SESSION_EXPORT",
              "MODEL_RESULT",
              "PROVIDER_CAPTURE",
              "FIELD_CHECK_RESULT",
              "EVIDENCE_BUNDLE",
              "DOCUMENT_BODY"
            ]
          }
        },
        "classification": {
          "$ref": "#/$defs/Classification"
        },
        "tenant_id": {
          "$ref": "#/$defs/Id"
        },
        "rule_id": {
          "$ref": "#/$defs/Id"
        },
        "producer_node_kind": {
          "const": "N04"
        },
        "purpose": {
          "const": "TASK_NODE_PRODUCTION"
        },
        "created_by": {
          "$ref": "#/$defs/Id"
        },
        "created_at": {
          "$ref": "#/$defs/Instant"
        },
        "operations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "uniqueItems": true,
          "items": {
            "enum": [
              "NODE_PRODUCE",
              "HOST_INPUT_CONSUME",
              "HOST_PREDECESSOR_CONSUME",
              "HOST_ENVELOPE_CONSUME",
              "SUPERVISOR_PREPARE_READ",
              "MODEL_INPUT_CONSUME"
            ]
          }
        },
        "enterprise_budget_basis": {
          "$ref": "#/$defs/VersionRef"
        }
      }
    },
    "InputDecide": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "project_id",
        "expected_revision",
        "rule_sha256",
        "decision",
        "reason"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "project_id": {
          "$ref": "#/$defs/Id"
        },
        "expected_revision": {
          "$ref": "#/$defs/Positive"
        },
        "rule_sha256": {
          "$ref": "#/$defs/Hash"
        },
        "decision": {
          "enum": [
            "APPROVE",
            "DISABLE"
          ]
        },
        "reason": {
          "$ref": "#/$defs/Reason"
        }
      }
    },
    "InputReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "tenant_id",
        "project_id",
        "task_id",
        "operation_id",
        "audit_id",
        "event_id",
        "request_sha256",
        "schema_manifest_sha256",
        "created_by",
        "created_at",
        "classification",
        "rule_id",
        "rule_sha256",
        "decision_id",
        "status",
        "revision"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "tenant_id": {
          "$ref": "#/$defs/Id"
        },
        "project_id": {
          "$ref": "#/$defs/Id"
        },
        "task_id": {
          "$ref": "#/$defs/Id"
        },
        "operation_id": {
          "$ref": "#/$defs/Id"
        },
        "audit_id": {
          "$ref": "#/$defs/Id"
        },
        "event_id": {
          "$ref": "#/$defs/Id"
        },
        "request_sha256": {
          "$ref": "#/$defs/Hash"
        },
        "schema_manifest_sha256": {
          "$ref": "#/$defs/Hash"
        },
        "created_by": {
          "$ref": "#/$defs/Id"
        },
        "created_at": {
          "$ref": "#/$defs/Instant"
        },
        "classification": {
          "$ref": "#/$defs/Classification"
        },
        "rule_id": {
          "$ref": "#/$defs/Id"
        },
        "rule_sha256": {
          "$ref": "#/$defs/Hash"
        },
        "decision_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/Id"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "enum": [
            "DRAFT",
            "APPROVED",
            "DISABLED"
          ]
        },
        "revision": {
          "$ref": "#/$defs/Positive"
        }
      }
    },
    "InputView": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "manifest",
        "rule_sha256",
        "status",
        "revision",
        "latest_decision_id",
        "allowed_actions"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "manifest": {
          "$ref": "#/$defs/InputManifest"
        },
        "rule_sha256": {
          "$ref": "#/$defs/Hash"
        },
        "status": {
          "enum": [
            "DRAFT",
            "APPROVED",
            "DISABLED"
          ]
        },
        "revision": {
          "$ref": "#/$defs/Positive"
        },
        "latest_decision_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/Id"
            },
            {
              "type": "null"
            }
          ]
        },
        "allowed_actions": {
          "type": "array",
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "enum": [
              "READ",
              "APPROVE",
              "DISABLE"
            ]
          }
        }
      }
    },
    "Recovery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "project_id",
        "original_idempotency_key"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "project_id": {
          "$ref": "#/$defs/Id"
        },
        "original_idempotency_key": {
          "$ref": "#/$defs/Key"
        }
      }
    }
  }
}
