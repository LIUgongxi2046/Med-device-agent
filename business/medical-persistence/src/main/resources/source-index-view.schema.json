{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:medical:source-index-view:1.0.0",
  "$defs":{
    "Id":{"type":"string","format":"uuid"},
    "Count":{"type":"string","pattern":"^(0|[1-9][0-9]{0,19})$"},
    "Time":{"type":"string","format":"date-time"},
    "Result":{
      "type":"object","additionalProperties":false,
      "required":["status","expected_count","verified_count","failure_code"],
      "properties":{
        "status":{"enum":["READY","FAILED"]},"expected_count":{"$ref":"#/$defs/Count"},
        "verified_count":{"$ref":"#/$defs/Count"},"failure_code":{"enum":[null,"INDEX_LIMIT"]}
      }
    },
    "Build":{
      "type":"object","additionalProperties":false,
      "required":["event_id","parse_version","index_version","mode","build_status","index_status","delivery_status","expected_count","verified_count","started_at","execution_deadline","updated_at","revision","result"],
      "properties":{
        "event_id":{"$ref":"#/$defs/Id"},"parse_version":{"$ref":"#/$defs/Id"},"index_version":{"$ref":"#/$defs/Id"},
        "mode":{"const":"FULLTEXT"},"build_status":{"enum":["BUILDING","READY","FAILED"]},
        "index_status":{"enum":["BUILDING","READY","FAILED","WITHDRAWN"]},
        "delivery_status":{"enum":["PENDING","DELIVERING","DELIVERED","FAILED"]},
        "expected_count":{"$ref":"#/$defs/Count"},"verified_count":{"$ref":"#/$defs/Count"},
        "started_at":{"$ref":"#/$defs/Time"},"execution_deadline":{"$ref":"#/$defs/Time"},
        "updated_at":{"$ref":"#/$defs/Time"},"revision":{"$ref":"#/$defs/Count"},
        "result":{"oneOf":[{"type":"null"},{"$ref":"#/$defs/Result"}]}
      }
    },
    "Listing":{
      "type":"object","additionalProperties":false,
      "required":["schema_version","source_id","source_version","project_id","total","listing_sha256","items"],
      "properties":{
        "schema_version":{"const":"1.0.0"},"source_id":{"$ref":"#/$defs/Id"},
        "source_version":{"$ref":"#/$defs/Id"},"project_id":{"$ref":"#/$defs/Id"},"total":{"$ref":"#/$defs/Count"},
        "listing_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},
        "items":{"type":"array","maxItems":1000,"items":{"$ref":"#/$defs/Build"}}
      }
    }
  }
}
