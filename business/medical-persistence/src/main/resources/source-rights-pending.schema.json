{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "tenant_id", "rights_revision", "source_version", "purpose", "allowed_actions", "providers", "regions", "valid_from", "valid_to", "evidence_manifest", "classification"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "tenant_id": {"$ref": "#/$defs/Id"}, "rights_revision": {"$ref": "#/$defs/Id"}, "source_version": {"$ref": "#/$defs/Id"},
    "purpose": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,127}$"},
    "allowed_actions": {"type": "array", "uniqueItems": true, "items": {"enum": ["READ", "STORE", "ENTERPRISE_USE", "DISTRIBUTE", "EXTERNAL_PROCESS"]}},
    "providers": {"$ref": "#/$defs/Names"}, "regions": {"$ref": "#/$defs/Names"},
    "valid_from": {"$ref": "#/$defs/NullableTime"}, "valid_to": {"$ref": "#/$defs/NullableTime"},
    "classification": {"$ref": "#/$defs/Classification"},
    "evidence_manifest": {
      "type": "object", "additionalProperties": false,
      "required": ["owner", "license", "environments", "classifications", "authorization_evidence"],
      "properties": {
        "owner": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "\\S"},
        "license": {"type": "string", "minLength": 1, "maxLength": 4096, "pattern": "\\S"},
        "environments": {"allOf": [{"$ref": "#/$defs/Names"}], "minItems": 1},
        "classifications": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/Classification"}},
        "authorization_evidence": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/ObjectRef"}}
      }
    }
  },
  "$defs": {
    "Id": {"type": "string", "format": "uuid", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
    "Names": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "\\S"}},
    "Classification": {"enum": ["PUBLIC", "INTERNAL", "RESTRICTED", "PERSONAL_HEALTH"]},
    "NullableTime": {"anyOf": [{"type": "null"}, {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$"}]},
    "ObjectRef": {
      "type": "object", "additionalProperties": false, "required": ["object_key", "object_version", "sha256", "size_bytes", "media_type"],
      "properties": {
        "object_key": {"type": "string", "minLength": 1, "maxLength": 1024},
        "object_version": {"type": "string", "minLength": 1, "maxLength": 256},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "size_bytes": {"type": "string", "pattern": "^[1-9][0-9]{0,19}$"},
        "media_type": {"type": "string", "minLength": 1, "maxLength": 128}
      }
    }
  }
}
