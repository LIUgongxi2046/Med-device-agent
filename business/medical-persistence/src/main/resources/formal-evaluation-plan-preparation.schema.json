{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:medical:formal-evaluation-plan-preparation:1.0.0",
  "$defs": {
    "Id": {
      "type": "string",
      "format": "uuid"
    },
    "Hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$(?![\\s\\S])"
    },
    "Revision": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,19}$(?![\\s\\S])"
    },
    "Basis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version_id",
        "content_sha256"
      ],
      "properties": {
        "version_id": {
          "$ref": "#/$defs/Id"
        },
        "content_sha256": {
          "$ref": "#/$defs/Hash"
        }
      }
    },
    "ExecutionStart": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "evaluation_id",
        "definition_sha256",
        "expected_evaluation_revision",
        "candidate",
        "execution_policy",
        "enterprise_budget",
        "parent_budget"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "evaluation_id": {
          "$ref": "#/$defs/Id"
        },
        "definition_sha256": {
          "$ref": "#/$defs/Hash"
        },
        "expected_evaluation_revision": {
          "$ref": "#/$defs/Revision"
        },
        "candidate": {
          "$ref": "#/$defs/Basis"
        },
        "execution_policy": {
          "$ref": "#/$defs/Basis"
        },
        "enterprise_budget": {
          "$ref": "#/$defs/Basis"
        },
        "parent_budget": {
          "$ref": "#/$defs/Basis"
        }
      }
    },
    "BoundStart": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "start",
        "context_binding"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "start": {
          "$ref": "#/$defs/ExecutionStart"
        },
        "context_binding": {
          "$ref": "#/$defs/Basis"
        }
      }
    },
    "Ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/Id"
      }
    },
    "Text": {
      "type": "string",
      "minLength": 1
    },
    "NullableId": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "Key": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]*$(?![\\s\\S])"
    },
    "Keys": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/Key"
      }
    },
    "PlanCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "template_version",
        "profile_revision",
        "requirement_node_ids",
        "sections",
        "questions",
        "pending_condition_ids"
      ],
      "properties": {
        "template_version": {
          "$ref": "#/$defs/Id"
        },
        "profile_revision": {
          "$ref": "#/$defs/Id"
        },
        "requirement_node_ids": {
          "$ref": "#/$defs/Ids"
        },
        "sections": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/PlanSection"
          }
        },
        "questions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ResearchQuestion"
          }
        },
        "pending_condition_ids": {
          "$ref": "#/$defs/Ids"
        }
      }
    },
    "PlanSection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "section_id",
        "requirement_node_ids",
        "goal",
        "owner_id",
        "method",
        "depends_on_section_ids",
        "completion_rule_ids"
      ],
      "properties": {
        "section_id": {
          "$ref": "#/$defs/Id"
        },
        "requirement_node_ids": {
          "$ref": "#/$defs/Ids"
        },
        "goal": {
          "$ref": "#/$defs/Text"
        },
        "owner_id": {
          "$ref": "#/$defs/NullableId"
        },
        "method": {
          "enum": [
            "DETERMINISTIC",
            "MODEL_ASSISTED",
            "HUMAN_PROVIDED"
          ]
        },
        "depends_on_section_ids": {
          "$ref": "#/$defs/Ids"
        },
        "completion_rule_ids": {
          "$ref": "#/$defs/Ids"
        }
      }
    },
    "ResearchQuestion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "question_key",
        "section_id",
        "question",
        "requirement_ids",
        "completion_rule_ids",
        "depends_on_question_keys"
      ],
      "properties": {
        "question_key": {
          "$ref": "#/$defs/Key"
        },
        "section_id": {
          "$ref": "#/$defs/Id"
        },
        "question": {
          "$ref": "#/$defs/Text"
        },
        "requirement_ids": {
          "$ref": "#/$defs/Ids"
        },
        "completion_rule_ids": {
          "$ref": "#/$defs/Ids"
        },
        "depends_on_question_keys": {
          "$ref": "#/$defs/Keys"
        }
      }
    },
    "KeyOriginal": {
      "type": "string",
      "minLength": 16,
      "maxLength": 128,
      "pattern": "^[!-~]+$(?![\\s\\S])"
    },
    "Request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "execution_id",
        "start",
        "sample_id",
        "repeat_index",
        "node_kind",
        "template"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "execution_id": {
          "$ref": "#/$defs/Id"
        },
        "start": {
          "$ref": "#/$defs/ExecutionStart"
        },
        "sample_id": {
          "$ref": "#/$defs/Id"
        },
        "repeat_index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 99
        },
        "node_kind": {
          "const": "N01"
        },
        "template": {
          "oneOf": [
            {
              "$ref": "#/$defs/Basis"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "Recovery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "original_key",
        "original_request"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "original_key": {
          "$ref": "#/$defs/KeyOriginal"
        },
        "original_request": {
          "$ref": "#/$defs/Request"
        }
      }
    },
    "BoundRecovery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "original_key",
        "original_request"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "original_key": {
          "$ref": "#/$defs/KeyOriginal"
        },
        "original_request": {
          "$ref": "#/$defs/BoundStart"
        }
      }
    },
    "Registration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "execution_id",
        "request_sha256",
        "expected_cells",
        "expected_nodes"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "execution_id": {
          "$ref": "#/$defs/Id"
        },
        "request_sha256": {
          "$ref": "#/$defs/Hash"
        },
        "expected_cells": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "expected_nodes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        }
      }
    },
    "Coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "expected_cells",
        "expected_nodes",
        "selected_cells",
        "professional_completed_cells",
        "complete_evaluation"
      ],
      "properties": {
        "scope": {
          "const": "SELECTED_CELL"
        },
        "expected_cells": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "expected_nodes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "selected_cells": {
          "const": 1
        },
        "professional_completed_cells": {
          "const": 0
        },
        "complete_evaluation": {
          "const": false
        }
      }
    },
    "Condition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "target_id",
        "rule_revision",
        "engine_revision",
        "input_keys",
        "status",
        "unknown_input_keys"
      ],
      "properties": {
        "scope": {
          "enum": [
            "PROFILE",
            "TEMPLATE",
            "NODE",
            "FIELD",
            "ATTACHMENT"
          ]
        },
        "target_id": {
          "$ref": "#/$defs/Id"
        },
        "rule_revision": {
          "oneOf": [
            {
              "$ref": "#/$defs/Basis"
            },
            {
              "type": "null"
            }
          ]
        },
        "engine_revision": {
          "type": [
            "string",
            "null"
          ]
        },
        "input_keys": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "status": {
          "enum": [
            "APPLICABLE",
            "NOT_APPLICABLE",
            "UNKNOWN"
          ]
        },
        "unknown_input_keys": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "Choice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "template",
        "document_type",
        "applicability",
        "eligible"
      ],
      "properties": {
        "template": {
          "$ref": "#/$defs/Basis"
        },
        "document_type": {
          "type": "string"
        },
        "applicability": {
          "enum": [
            "APPLICABLE",
            "NOT_APPLICABLE",
            "UNKNOWN"
          ]
        },
        "eligible": {
          "type": "boolean"
        }
      }
    },
    "Blocker": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "target_ids"
      ],
      "properties": {
        "code": {
          "enum": [
            "TEMPLATE_CHOICE_REQUIRED",
            "NO_COMPATIBLE_TEMPLATE",
            "APPLICABILITY_UNKNOWN",
            "OWNER_UNASSIGNED",
            "COMPLETION_RULE_MISSING",
            "METHOD_REVIEW_REQUIRED"
          ]
        },
        "target_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Id"
          }
        }
      }
    },
    "ActionSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "resource_kind",
        "resource_id",
        "project_id",
        "purpose",
        "allowed"
      ],
      "properties": {
        "action": {
          "const": "artifact.register"
        },
        "resource_kind": {
          "const": "EVALUATION"
        },
        "resource_id": {
          "$ref": "#/$defs/Id"
        },
        "project_id": {
          "$ref": "#/$defs/Id"
        },
        "purpose": {
          "const": "EVALUATION_RESULTS"
        },
        "allowed": {
          "type": "boolean"
        }
      }
    },
    "Preview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "preparation_kind",
        "execution_id",
        "evaluation_id",
        "candidate",
        "execution_policy",
        "context_binding",
        "source_snapshot",
        "profile_revision",
        "profile_sha256",
        "sample_id",
        "repeat_index",
        "document_type",
        "coverage",
        "templates",
        "selected_template",
        "selection_state",
        "plan_candidate",
        "conditions",
        "blockers",
        "action_summary",
        "runnable",
        "professional_completion"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "preparation_kind": {
          "const": "DETERMINISTIC_PLAN_DRAFT"
        },
        "execution_id": {
          "$ref": "#/$defs/Id"
        },
        "evaluation_id": {
          "$ref": "#/$defs/Id"
        },
        "candidate": {
          "$ref": "#/$defs/Basis"
        },
        "execution_policy": {
          "$ref": "#/$defs/Basis"
        },
        "context_binding": {
          "$ref": "#/$defs/Basis"
        },
        "source_snapshot": {
          "$ref": "#/$defs/Basis"
        },
        "profile_revision": {
          "$ref": "#/$defs/Id"
        },
        "profile_sha256": {
          "$ref": "#/$defs/Hash"
        },
        "sample_id": {
          "$ref": "#/$defs/Id"
        },
        "repeat_index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 99
        },
        "document_type": {
          "type": "string"
        },
        "coverage": {
          "$ref": "#/$defs/Coverage"
        },
        "templates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Choice"
          }
        },
        "selected_template": {
          "oneOf": [
            {
              "$ref": "#/$defs/Basis"
            },
            {
              "type": "null"
            }
          ]
        },
        "selection_state": {
          "enum": [
            "NO_COMPATIBLE_TEMPLATE",
            "CHOICE_REQUIRED",
            "SELECTED"
          ]
        },
        "plan_candidate": {
          "oneOf": [
            {
              "$ref": "#/$defs/PlanCandidate"
            },
            {
              "type": "null"
            }
          ]
        },
        "conditions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Condition"
          }
        },
        "blockers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Blocker"
          }
        },
        "action_summary": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ActionSummary"
          }
        },
        "runnable": {
          "const": false
        },
        "professional_completion": {
          "const": false
        }
      }
    },
    "Prepared": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "operation_id",
        "write_id",
        "attempt_id",
        "execution_id",
        "artifact_id",
        "artifact_sha256",
        "object_version",
        "receipt_sha256",
        "preview",
        "state",
        "runnable",
        "professional_completion"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "operation_id": {
          "$ref": "#/$defs/Id"
        },
        "write_id": {
          "$ref": "#/$defs/Id"
        },
        "attempt_id": {
          "$ref": "#/$defs/Id"
        },
        "execution_id": {
          "$ref": "#/$defs/Id"
        },
        "artifact_id": {
          "$ref": "#/$defs/Id"
        },
        "artifact_sha256": {
          "$ref": "#/$defs/Hash"
        },
        "object_version": {
          "type": "string",
          "minLength": 1
        },
        "receipt_sha256": {
          "$ref": "#/$defs/Hash"
        },
        "preview": {
          "$ref": "#/$defs/Preview"
        },
        "state": {
          "const": "PREPARED"
        },
        "runnable": {
          "const": false
        },
        "professional_completion": {
          "const": false
        }
      }
    },
    "PreparationIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "operation_id",
        "write_id",
        "attempt_id",
        "execution_id",
        "artifact_id",
        "artifact_sha256",
        "object_version",
        "receipt_sha256",
        "state",
        "runnable",
        "professional_completion"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "operation_id": {
          "$ref": "#/$defs/Id"
        },
        "write_id": {
          "$ref": "#/$defs/Id"
        },
        "attempt_id": {
          "$ref": "#/$defs/Id"
        },
        "execution_id": {
          "$ref": "#/$defs/Id"
        },
        "artifact_id": {
          "$ref": "#/$defs/Id"
        },
        "artifact_sha256": {
          "$ref": "#/$defs/Hash"
        },
        "object_version": {
          "type": "string",
          "minLength": 1
        },
        "receipt_sha256": {
          "$ref": "#/$defs/Hash"
        },
        "state": {
          "const": "PREPARED"
        },
        "runnable": {
          "const": false
        },
        "professional_completion": {
          "const": false
        }
      }
    },
    "Status": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "state",
        "content_available",
        "receipt"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "state": {
          "enum": [
            "NOT_FOUND",
            "PENDING",
            "PREPARED"
          ]
        },
        "content_available": {
          "const": false
        },
        "receipt": {
          "oneOf": [
            {
              "$ref": "#/$defs/PreparationIdentity"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "Availability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "features",
        "unavailable_reason"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "features": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "bound_preparation",
            "execution_recovery",
            "plan_preview",
            "plan_preparation",
            "status",
            "object_recovery"
          ],
          "properties": {
            "bound_preparation": {
              "type": "boolean"
            },
            "execution_recovery": {
              "type": "boolean"
            },
            "plan_preview": {
              "type": "boolean"
            },
            "plan_preparation": {
              "type": "boolean"
            },
            "status": {
              "type": "boolean"
            },
            "object_recovery": {
              "type": "boolean"
            }
          }
        },
        "unavailable_reason": {
          "enum": [
            null,
            "FEATURE_DISABLED",
            "DEPENDENCY_UNAVAILABLE"
          ]
        }
      }
    }
  }
}
