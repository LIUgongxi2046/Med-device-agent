{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:medical:projects:1.0.0",
  "$defs":{
    "Id":{"type":"string","format":"uuid","pattern":"^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
    "NullableId":{"anyOf":[{"$ref":"#/$defs/Id"},{"type":"null"}]},
    "Revision":{"type":"string","pattern":"^(0|[1-9][0-9]{0,19})$"},
    "NullableRevision":{"anyOf":[{"$ref":"#/$defs/Revision"},{"type":"null"}]},
    "Hash":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "Time":{"type":"string","format":"date-time","pattern":"^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"},
    "Text":{"type":"string","minLength":1,"maxLength":2000},
    "Basis":{"type":"object","additionalProperties":false,"required":["version_id","content_sha256"],"properties":{"version_id":{"$ref":"#/$defs/Id"},"content_sha256":{"$ref":"#/$defs/Hash"}}},
    "Bases":{"type":"array","maxItems":1000,"uniqueItems":true,"items":{"$ref":"#/$defs/Basis"}},
    "Attribute":{"type":"object","additionalProperties":false,"required":["key","status","value","authority_refs","reason"],"properties":{"key":{"type":"string","minLength":1,"maxLength":128},"status":{"enum":["KNOWN","UNKNOWN"]},"value":{},"authority_refs":{"$ref":"#/$defs/Bases"},"reason":{"$ref":"#/$defs/Text"}},"oneOf":[{"properties":{"status":{"const":"KNOWN"},"value":{"not":{"type":"null"}},"authority_refs":{"minItems":1}}},{"properties":{"status":{"const":"UNKNOWN"},"value":{"type":"null"},"authority_refs":{"maxItems":0}}}]},
    "Attributes":{"type":"array","maxItems":1000,"items":{"$ref":"#/$defs/Attribute"}},
    "Status":{"enum":["PENDING","ACTIVE","PAUSED","ARCHIVED"]},
    "Create":{"type":"object","additionalProperties":false,"required":["schema_version","name","responsible_user_id","attributes","creation_basis","reason","approval_attested"],"properties":{"schema_version":{"const":"1.0.0"},"name":{"type":"string","minLength":1,"maxLength":256},"responsible_user_id":{"$ref":"#/$defs/Id"},"attributes":{"$ref":"#/$defs/Attributes"},"creation_basis":{"$ref":"#/$defs/Basis"},"reason":{"$ref":"#/$defs/Text"},"approval_attested":{"const":true}}},
    "Revise":{"type":"object","additionalProperties":false,"required":["schema_version","expected_revision","based_on_profile_revision","attributes","reason","approval_attested"],"properties":{"schema_version":{"const":"1.0.0"},"expected_revision":{"$ref":"#/$defs/Revision"},"based_on_profile_revision":{"$ref":"#/$defs/Id"},"attributes":{"$ref":"#/$defs/Attributes"},"reason":{"$ref":"#/$defs/Text"},"approval_attested":{"const":true}}},
    "Decide":{"type":"object","additionalProperties":false,"required":["schema_version","decision","expected_revision","reason","approval_attested"],"properties":{"schema_version":{"const":"1.0.0"},"decision":{"enum":["ACTIVATE","PAUSE","ARCHIVE","RESTORE"]},"expected_revision":{"$ref":"#/$defs/Revision"},"reason":{"$ref":"#/$defs/Text"},"approval_attested":{"const":true}}},
    "Profile":{"type":"object","additionalProperties":false,"required":["profile_revision","attributes","authority_refs","content_sha256","created_by","created_at"],"properties":{"profile_revision":{"$ref":"#/$defs/Id"},"attributes":{"$ref":"#/$defs/Attributes"},"authority_refs":{"$ref":"#/$defs/Bases"},"content_sha256":{"$ref":"#/$defs/Hash"},"created_by":{"$ref":"#/$defs/Id"},"created_at":{"$ref":"#/$defs/Time"}}},
    "Children":{"type":"object","additionalProperties":false,"required":["tasks","active_runs","waiting_items"],"properties":{"tasks":{"$ref":"#/$defs/NullableRevision"},"active_runs":{"$ref":"#/$defs/NullableRevision"},"waiting_items":{"$ref":"#/$defs/NullableRevision"}}},
    "Project":{"type":"object","additionalProperties":false,"required":["schema_version","tenant_id","project_id","name","responsible_user_id","status","revision","profile","creation_basis","creation_reason","created_by","created_at","updated_at","children","allowed_actions"],"properties":{"schema_version":{"const":"1.0.0"},"tenant_id":{"$ref":"#/$defs/Id"},"project_id":{"$ref":"#/$defs/Id"},"name":{"type":"string","minLength":1,"maxLength":256},"responsible_user_id":{"$ref":"#/$defs/Id"},"status":{"$ref":"#/$defs/Status"},"revision":{"$ref":"#/$defs/Revision"},"profile":{"$ref":"#/$defs/Profile"},"creation_basis":{"$ref":"#/$defs/Basis"},"creation_reason":{"$ref":"#/$defs/Text"},"created_by":{"$ref":"#/$defs/Id"},"created_at":{"$ref":"#/$defs/Time"},"updated_at":{"$ref":"#/$defs/Time"},"children":{"$ref":"#/$defs/Children"},"allowed_actions":{"type":"array","uniqueItems":true,"items":{"enum":["project.read","profile.confirm","project.manage","project.task.read","task.read","run.read","work_item.read"]}}}},
    "Listing":{"type":"object","additionalProperties":false,"required":["schema_version","projects","total","next_after"],"properties":{"schema_version":{"const":"1.0.0"},"projects":{"type":"array","maxItems":100,"items":{"$ref":"#/$defs/Project"}},"total":{"$ref":"#/$defs/Revision"},"next_after":{"$ref":"#/$defs/NullableId"}}},
    "Run":{"type":"object","additionalProperties":false,"required":["run_id","status","revision"],"properties":{"run_id":{"$ref":"#/$defs/Id"},"status":{"enum":["QUEUED","RUNNING","WAITING_INPUT","CANCEL_REQUESTED"]},"revision":{"$ref":"#/$defs/Revision"}}},
    "Ids":{"type":"array","maxItems":1000,"uniqueItems":true,"items":{"$ref":"#/$defs/Id"}},
    "Impact":{"type":"object","additionalProperties":false,"required":["old_profile_revision","new_profile_revision","dependent_tasks","task_ids","active_runs","runs","complete","new_dispatch","inflight"],"properties":{"old_profile_revision":{"$ref":"#/$defs/NullableId"},"new_profile_revision":{"$ref":"#/$defs/Id"},"dependent_tasks":{"$ref":"#/$defs/NullableRevision"},"task_ids":{"anyOf":[{"$ref":"#/$defs/Ids"},{"type":"null"}]},"active_runs":{"$ref":"#/$defs/NullableRevision"},"runs":{"anyOf":[{"type":"array","maxItems":1000,"items":{"$ref":"#/$defs/Run"}},{"type":"null"}]},"complete":{"type":"boolean"},"new_dispatch":{"enum":["PENDING","DENIED","REVALIDATE"]},"inflight":{"const":"RECONCILE_ACTUAL_INVOCATIONS"}}},
    "Context":{"type":"object","additionalProperties":false,"required":["tenant_id","context_revision","auth_epoch","governance_epoch"],"properties":{"tenant_id":{"$ref":"#/$defs/Id"},"context_revision":{"$ref":"#/$defs/Revision"},"auth_epoch":{"$ref":"#/$defs/Revision"},"governance_epoch":{"$ref":"#/$defs/Revision"}}},
    "Receipt":{"type":"object","additionalProperties":false,"required":["schema_version","operation_id","decision_id","decision","tenant_id","project_id","status","revision","profile_revision","impact","current_context"],"properties":{"schema_version":{"const":"1.0.0"},"operation_id":{"$ref":"#/$defs/Id"},"decision_id":{"$ref":"#/$defs/NullableId"},"decision":{"enum":["CREATE","REVISE","ACTIVATE","PAUSE","ARCHIVE","RESTORE"]},"tenant_id":{"$ref":"#/$defs/Id"},"project_id":{"$ref":"#/$defs/Id"},"status":{"$ref":"#/$defs/Status"},"revision":{"$ref":"#/$defs/Revision"},"profile_revision":{"$ref":"#/$defs/Id"},"impact":{"$ref":"#/$defs/Impact"},"current_context":{"$ref":"#/$defs/Context"}}},
    "Waiting":{"type":"object","additionalProperties":false,"required":["waiting_item_id","project_id","run_id","target_revision","reason_code","question","requirement_refs","allowed_resolution_actions","assignee_id","status","revision","updated_at"],"properties":{"waiting_item_id":{"$ref":"#/$defs/Id"},"project_id":{"$ref":"#/$defs/NullableId"},"run_id":{"$ref":"#/$defs/Id"},"target_revision":{"$ref":"#/$defs/Id"},"reason_code":{"type":"string","minLength":1,"maxLength":64},"question":{"type":"string","minLength":1},"requirement_refs":{"type":"array"},"allowed_resolution_actions":{"type":"array"},"assignee_id":{"$ref":"#/$defs/Id"},"status":{"type":"string","minLength":1,"maxLength":24},"revision":{"$ref":"#/$defs/Revision"},"updated_at":{"$ref":"#/$defs/Time"}}},
    "WaitingListing":{"type":"object","additionalProperties":false,"required":["schema_version","items","total","next_after"],"properties":{"schema_version":{"const":"1.0.0"},"items":{"type":"array","maxItems":100,"items":{"$ref":"#/$defs/Waiting"}},"total":{"$ref":"#/$defs/Revision"},"next_after":{"$ref":"#/$defs/NullableId"}}}
  }
}
