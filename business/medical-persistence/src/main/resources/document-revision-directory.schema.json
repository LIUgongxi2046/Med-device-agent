{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:medical:document-revision-directory:1.0.0",
  "$defs": {
    "Id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "Entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document_revision",
        "body_sha256",
        "created_by",
        "created_at",
        "is_current",
        "read_url",
        "check_ids",
        "review_ids",
        "signature_ids"
      ],
      "properties": {
        "document_revision": {
          "$ref": "#/$defs/Id"
        },
        "body_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "created_by": {
          "$ref": "#/$defs/Id"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "is_current": {
          "type": "boolean"
        },
        "read_url": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "check_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/Id"
          }
        },
        "review_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/Id"
          }
        },
        "signature_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/Id"
          }
        }
      }
    },
    "Page": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "document_id",
        "current_document_revision",
        "document_head_revision",
        "items",
        "next_cursor",
        "complete"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "document_id": {
          "$ref": "#/$defs/Id"
        },
        "current_document_revision": {
          "anyOf": [
            {
              "$ref": "#/$defs/Id"
            },
            {
              "type": "null"
            }
          ]
        },
        "document_head_revision": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,19}$"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Entry"
          }
        },
        "next_cursor": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 16,
              "maxLength": 2048,
              "pattern": "^[A-Za-z0-9._~-]+$"
            }
          ]
        },
        "complete": {
          "type": "boolean"
        }
      }
    },
    "View": {
      "$ref": "#/$defs/Page"
    }
  }
}
