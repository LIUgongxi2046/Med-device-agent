{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:medical:run-token-authority:1.0.0",
  "$defs":{
    "Id":{"type":"string","format":"uuid"},
    "NullableId":{"anyOf":[{"$ref":"#/$defs/Id"},{"type":"null"}]},
    "Hash":{"type":"string","pattern":"^[a-f0-9]{64}$"},
    "Action":{"type":"string","pattern":"^[a-z][a-z0-9_.-]{0,63}$"},
    "Scope":{
      "type":"object","additionalProperties":false,"required":["tenant_id","project_id","resource_kind","resource_id"],
      "properties":{"tenant_id":{"$ref":"#/$defs/Id"},"project_id":{"$ref":"#/$defs/NullableId"},
        "resource_kind":{"type":"string","pattern":"^[A-Z][A-Z0-9_]{0,63}$"},"resource_id":{"$ref":"#/$defs/Id"}}
    },
    "Permission":{
      "type":"object","additionalProperties":false,"required":["scope","action","purpose"],
      "properties":{"scope":{"$ref":"#/$defs/Scope"},"action":{"$ref":"#/$defs/Action"},
        "purpose":{"type":"string","pattern":"^[A-Z][A-Z0-9_]{0,63}$"}}
    },
    "Service":{
      "type":"object","additionalProperties":false,"required":["service_uri","audience"],
      "properties":{"service_uri":{"type":"string","format":"uri","maxLength":512},"audience":{"type":"string","minLength":1,"maxLength":255}}
    },
    "ScopeManifest":{
      "type":"object","additionalProperties":false,
      "required":["schema_version","tenant_id","project_id","initiator_id","run_id","execution_kind","resources"],
      "properties":{"schema_version":{"const":"1.0.0"},"tenant_id":{"$ref":"#/$defs/Id"},"project_id":{"$ref":"#/$defs/NullableId"},
        "initiator_id":{"$ref":"#/$defs/Id"},"run_id":{"$ref":"#/$defs/Id"},"execution_kind":{"enum":["TASK","SYSTEM_JOB"]},
        "resources":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/Scope"}}}
    },
    "PrincipalManifest":{
      "type":"object","additionalProperties":false,
      "required":["schema_version","tenant_id","project_id","initiator_id","run_id","principal_id","scope_sha256","services","permissions"],
      "properties":{"schema_version":{"const":"1.0.0"},"tenant_id":{"$ref":"#/$defs/Id"},"project_id":{"$ref":"#/$defs/NullableId"},
        "initiator_id":{"$ref":"#/$defs/Id"},"run_id":{"$ref":"#/$defs/Id"},"principal_id":{"$ref":"#/$defs/Id"},"scope_sha256":{"$ref":"#/$defs/Hash"},
        "services":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/Service"}},
        "permissions":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/Permission"}}}
    },
    "RoleScope":{
      "type":"object","additionalProperties":false,"required":["schema_version","permissions"],
      "properties":{"schema_version":{"const":"1.0.0"},"permissions":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/Permission"}}}
    }
  }
}
