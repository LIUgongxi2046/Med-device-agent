              "$ref": "#/$defs/PolicyDecisionContent"
            }
          ]
        }
      }
    },
    "Cursor": {
      "type": "string",
      "format": "uuid"
    },
    "Query": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "kind",
        "cursor"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "kind": {
          "enum": [
            "FORMAL_CAPABILITY_AUTHOR",
            "POLICY_DRAFT",
            "POLICY"
          ]
        },
        "cursor": {
          "anyOf": [
            {
              "$ref": "#/$defs/Cursor"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "List": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "items",
        "next_cursor"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "items": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "$ref": "#/$defs/RecordView"
          }
        },
        "next_cursor": {
          "anyOf": [
            {
              "$ref": "#/$defs/Cursor"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "RuntimeNullableId": {
      "anyOf": [
        {
          "$ref": "#/$defs/Id"
        },
        {
          "type": "null"
        }
      ]
    },
    "RuntimeAction": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{0,63}$"
    },
    "RuntimeScope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tenant_id",
        "project_id",
        "resource_kind",
        "resource_id"
      ],
      "properties": {
        "tenant_id": {
          "$ref": "#/$defs/Id"
        },
        "project_id": {
          "$ref": "#/$defs/RuntimeNullableId"
        },
        "resource_kind": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
        },
        "resource_id": {
          "$ref": "#/$defs/Id"
        }
      }
    },
    "RuntimePermission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "action",
        "purpose"
      ],
      "properties": {
        "scope": {
          "$ref": "#/$defs/RuntimeScope"
        },
        "action": {
          "$ref": "#/$defs/RuntimeAction"
        },
        "purpose": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
        }
      }
    },
    "RuntimeRoleScope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "permissions"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "permissions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/RuntimePermission"
          },
          "maxItems": 128
        }
      }
    },
    "CapabilityQuery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "kind",
        "cursor"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "kind": {
          "const": "FORMAL_CAPABILITY_AUTHOR"
        },
        "cursor": {
          "anyOf": [
            {
              "$ref": "#/$defs/Cursor"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  }
}
