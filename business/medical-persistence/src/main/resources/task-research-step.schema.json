{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:medical:task-research-step:1.0.0",
  "$defs": {
    "Binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tenant_id",
        "run_id",
        "step_id",
        "action_id",
        "lease_generation",
        "input_sha256",
        "step_envelope_sha256"
      ],
      "properties": {
        "tenant_id": {
          "type": "string",
          "format": "uuid"
        },
        "run_id": {
          "type": "string",
          "format": "uuid"
        },
        "step_id": {
          "type": "string",
          "format": "uuid"
        },
        "action_id": {
          "type": "string",
          "format": "uuid"
        },
        "lease_generation": {
          "type": "integer",
          "minimum": 1
        },
        "input_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "step_envelope_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "Version": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version_id",
        "content_sha256"
      ],
      "properties": {
        "version_id": {
          "type": "string",
          "format": "uuid"
        },
        "content_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "Pin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "sha256",
        "object_version",
        "receipt_sha256"
      ],
      "properties": {
        "artifact_id": {
          "type": "string",
          "format": "uuid"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "object_version": {
          "type": "string",
          "minLength": 1
        },
        "receipt_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "Permission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resource_kind",
        "resource_id",
        "actions"
      ],
      "properties": {
        "resource_kind": {
          "enum": [
            "TASK",
            "SOURCE",
            "MODEL_CONFIG"
          ]
        },
        "resource_id": {
          "type": "string",
          "format": "uuid"
        },
        "actions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "StepEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "execution_kind",
        "node_kind",
        "tenant_id",
        "project_id",
        "task_id",
        "run_id",
        "step_id",
        "action_id",
        "session_id",
        "question_id",
        "input_artifact_id",
        "agent_release_id",
        "deployment_revision",
        "lease_generation",
        "input_sha256",
        "input_receipt_sha256",
        "runtime_manifest_sha256",
        "publication_approval_sha256",
        "deployment_sha256",
        "worker_service_uri",
        "role_version",
        "execution_policy_version",
        "action_scope",
        "prompt_sha256",
        "prompt_provenance",
        "compiled_prompt"
      ],
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "1.0.0"
        },
        "execution_kind": {
          "const": "TASK"
        },
        "node_kind": {
          "const": "N02"
        },
        "tenant_id": {
          "type": "string",
          "format": "uuid"
        },
        "project_id": {
          "type": "string",
          "format": "uuid"
        },
        "task_id": {
          "type": "string",
          "format": "uuid"
        },
        "run_id": {
          "type": "string",
          "format": "uuid"
        },
        "step_id": {
          "type": "string",
          "format": "uuid"
        },
        "action_id": {
          "type": "string",
          "format": "uuid"
        },
        "session_id": {
          "type": "string",
          "format": "uuid"
        },
        "question_id": {
          "type": "string",
          "format": "uuid"
        },
        "input_artifact_id": {
          "type": "string",
          "format": "uuid"
        },
        "agent_release_id": {
          "type": "string",
          "format": "uuid"
        },
        "deployment_revision": {
          "type": "string",
          "format": "uuid"
        },
        "lease_generation": {
          "type": "integer",
          "minimum": 1
        },
        "input_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "input_receipt_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "runtime_manifest_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "publication_approval_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "deployment_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "worker_service_uri": {
          "type": "string",
          "format": "uri"
        },
        "role_version": {
          "$ref": "#/$defs/Version"
        },
        "execution_policy_version": {
          "$ref": "#/$defs/Version"
        },
        "action_scope": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "prompt_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "compiled_prompt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2097152
        },
        "prompt_provenance": {
          "type": "object",
          "minProperties": 1
        }
      }
    },
    "File": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "size_bytes",
        "content_base64"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "size_bytes": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "content_base64": {
          "type": "string",
          "maxLength": 22369624
        }
      }
    },
    "SessionExport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "kind",
        "binding",
        "session_id",
        "runtime_manifest_sha256",
        "files",
        "observation",
        "supervision_sha256"
      ],
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "1.0.0"
        },
        "kind": {
          "const": "SESSION_EXPORT"
        },
        "binding": {
          "$ref": "#/$defs/Binding"
        },
        "session_id": {
          "type": "string",
          "format": "uuid"
        },
        "runtime_manifest_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "files": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/File"
          },
          "minItems": 1,
          "maxItems": 10000
        },
        "observation": {
          "type": "object"
        },
        "supervision_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "StepResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "execution_kind",
        "node_kind",
        "binding",
        "question_id",
        "session_id",
        "outcome",
        "evidence_bundle",
        "session_export",
        "invocation_ids",
        "source_read_receipt_ids"
      ],
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "1.0.0"
        },
        "execution_kind": {
          "const": "TASK"
        },
        "node_kind": {
          "const": "N02"
        },
        "binding": {
          "$ref": "#/$defs/Binding"
        },
        "question_id": {
          "type": "string",
          "format": "uuid"
        },
        "session_id": {
          "type": "string",
          "format": "uuid"
        },
        "outcome": {
          "enum": [
            "SUCCEEDED",
            "WAITING_INPUT",
            "FAILED"
          ]
        },
        "evidence_bundle": {
          "$ref": "#/$defs/Pin"
        },
        "session_export": {
          "$ref": "#/$defs/Pin"
        },
        "invocation_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          },
          "maxItems": 1000,
          "uniqueItems": true
        },
        "source_read_receipt_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          },
          "maxItems": 1000,
          "uniqueItems": true
        }
      }
    }
  }
}
