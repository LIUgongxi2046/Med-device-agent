{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:medical:source-exact:1.0.0",
  "$defs": {
    "Id": {"type":"string","format":"uuid"},
    "Hash": {"type":"string","pattern":"^[a-f0-9]{64}$"},
    "Revision": {"type":"string","pattern":"^(0|[1-9][0-9]*)$","maxLength":20},
    "FieldKind": {"enum":["MODEL","PTR_NUMBER","DOCUMENT_NUMBER","STANDARD_NUMBER","STANDARD_YEAR"]},
    "Field": {
      "type":"object","additionalProperties":false,
      "required":["field_kind","raw_value","alias_value","alias_reason","chunk_id","quote_hash","locator_sha256","start_codepoint","end_codepoint"],
      "properties": {
        "field_kind":{"$ref":"#/$defs/FieldKind"},
        "raw_value":{"type":"string","minLength":1,"maxLength":512},
        "alias_value":{"type":["string","null"],"minLength":1,"maxLength":512},
        "alias_reason":{"type":["string","null"],"minLength":1,"maxLength":4000},
        "chunk_id":{"$ref":"#/$defs/Id"},"quote_hash":{"$ref":"#/$defs/Hash"},"locator_sha256":{"$ref":"#/$defs/Hash"},
        "start_codepoint":{"type":"integer","minimum":0},"end_codepoint":{"type":"integer","minimum":1}
      }
    },
    "PublicationInput": {
      "type":"object","additionalProperties":false,
      "required":["schema_version","project_id","parse_version","index_version","approval_revision","binding_revision","rights_revision","expected_revision","fields","reason"],
      "properties": {
        "schema_version":{"const":"1.0.0"},"project_id":{"$ref":"#/$defs/Id"},"parse_version":{"$ref":"#/$defs/Id"},
        "index_version":{"$ref":"#/$defs/Id"},"approval_revision":{"$ref":"#/$defs/Id"},"binding_revision":{"$ref":"#/$defs/Id"},
        "rights_revision":{"$ref":"#/$defs/Id"},"expected_revision":{"$ref":"#/$defs/Revision"},
        "fields":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/Field"}},
        "reason":{"type":"string","minLength":1,"maxLength":4000}
      }
    },
    "Manifest": {
      "type":"object","additionalProperties":false,
      "required":["schema_version","tenant_id","source_version","field_revision","revision","original_sha256","request","actor_id","created_at"],
      "properties": {
        "schema_version":{"const":"1.0.0"},"tenant_id":{"$ref":"#/$defs/Id"},"source_version":{"$ref":"#/$defs/Id"},
        "field_revision":{"$ref":"#/$defs/Id"},"revision":{"$ref":"#/$defs/Revision"},"original_sha256":{"$ref":"#/$defs/Hash"},
        "request":{"$ref":"#/$defs/PublicationInput"},"actor_id":{"$ref":"#/$defs/Id"},"created_at":{"type":"string","format":"date-time"}
      }
    },
    "PublicationReceipt": {
      "type":"object","additionalProperties":false,
      "required":["schema_version","operation_id","source_version","field_revision","revision","manifest_sha256","field_count","manifest","current_context"],
      "properties": {
        "schema_version":{"const":"1.0.0"},"operation_id":{"$ref":"#/$defs/Id"},"source_version":{"$ref":"#/$defs/Id"},
        "field_revision":{"$ref":"#/$defs/Id"},"revision":{"$ref":"#/$defs/Revision"},"manifest_sha256":{"$ref":"#/$defs/Hash"},
        "field_count":{"type":"integer","minimum":1},"manifest":{"$ref":"#/$defs/Manifest"},
        "current_context":{"type":"object","additionalProperties":false,"required":["tenant_id","context_revision","auth_epoch","governance_epoch"],
          "properties":{"tenant_id":{"$ref":"#/$defs/Id"},"context_revision":{"$ref":"#/$defs/Revision"},"auth_epoch":{"$ref":"#/$defs/Revision"},"governance_epoch":{"$ref":"#/$defs/Revision"}}}
      }
    },
    "SearchInput": {
      "type":"object","additionalProperties":false,"required":["schema_version","project_id","field_kind","query","purpose"],
      "properties":{"schema_version":{"const":"1.0.0"},"project_id":{"$ref":"#/$defs/Id"},"field_kind":{"$ref":"#/$defs/FieldKind"},
        "query":{"type":"string","minLength":1,"maxLength":512},"purpose":{"const":"VERIFICATION"}}
    },
    "FieldMatch": {
      "type":"object","additionalProperties":false,"required":["ordinal","field"],
      "properties":{"ordinal":{"type":"integer","minimum":0},"field":{"$ref":"#/$defs/Field"}}
    },
    "Hit": {
      "type":"object","additionalProperties":false,
      "required":["rank","source_id","source_version","parse_version","index_version","chunk_id","approval_revision","rights_revision","binding_revision","title","excerpt","excerpt_truncated","locator","quote_hash","field_revision","field_manifest_sha256","matches"],
      "properties": {
        "rank":{"type":"integer","minimum":1},"source_id":{"$ref":"#/$defs/Id"},"source_version":{"$ref":"#/$defs/Id"},
        "parse_version":{"$ref":"#/$defs/Id"},"index_version":{"$ref":"#/$defs/Id"},"chunk_id":{"$ref":"#/$defs/Id"},
        "approval_revision":{"$ref":"#/$defs/Id"},"rights_revision":{"$ref":"#/$defs/Id"},"binding_revision":{"$ref":"#/$defs/Id"},
        "title":{"type":"string","minLength":1,"maxLength":512},"excerpt":{"type":"string","minLength":1,"maxLength":1200},
        "excerpt_truncated":{"type":"boolean"},"locator":{"type":"object","minProperties":1},"quote_hash":{"$ref":"#/$defs/Hash"},
        "field_revision":{"$ref":"#/$defs/Id"},"field_manifest_sha256":{"$ref":"#/$defs/Hash"},
        "matches":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/FieldMatch"}}
      }
    },
    "Page": {
      "type":"object","additionalProperties":false,
      "required":["schema_version","retrieval_id","project_id","field_kind","query","purpose","mode","status","created_at","selection_sha256","total","page","page_size","next_page","items"],
      "properties": {
        "schema_version":{"const":"1.0.0"},"retrieval_id":{"$ref":"#/$defs/Id"},"project_id":{"$ref":"#/$defs/Id"},
        "field_kind":{"$ref":"#/$defs/FieldKind"},"query":{"type":"string","minLength":1,"maxLength":512},"purpose":{"const":"VERIFICATION"},
        "mode":{"const":"EXACT"},"status":{"enum":["FOUND","EMPTY"]},"created_at":{"type":"string","format":"date-time"},
        "selection_sha256":{"$ref":"#/$defs/Hash"},"total":{"$ref":"#/$defs/Revision"},
        "page":{"type":"integer","minimum":1},"page_size":{"type":"integer","minimum":1,"maximum":100},
        "next_page":{"type":["integer","null"],"minimum":2},"items":{"type":"array","maxItems":100,"items":{"$ref":"#/$defs/Hit"}}
      }
    }
  }
}
