{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:medical:service-client-tls:1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "service_uri", "certificate_sha256", "trust_revision", "key_algorithm", "private_key_pkcs8", "certificate_chain"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "service_uri": {"type": "string", "format": "uri"},
    "certificate_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "trust_revision": {"type": "string", "format": "uuid"},
    "key_algorithm": {"enum": ["EC", "RSA", "Ed25519"]},
    "private_key_pkcs8": {"type": "string", "minLength": 4, "maxLength": 65536},
    "certificate_chain": {"type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": {"type": "string", "minLength": 4, "maxLength": 65536}}
  }
}
