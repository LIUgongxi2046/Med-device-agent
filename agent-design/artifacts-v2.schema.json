{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProfessionalArtifactV2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "execution_kind",
    "tenant_id",
    "project_id",
    "run_id",
    "step_id",
    "input_manifest_sha256",
    "plan_revision",
    "snapshot_id",
    "target_section_ids",
    "dependency_access_set_id",
    "content_sha256",
    "output"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0.0"
    },
    "execution_kind": {
      "enum": [
        "TASK",
        "SYSTEM_JOB"
      ]
    },
    "tenant_id": {
      "$ref": "#/$defs/Id"
    },
    "project_id": {
      "$ref": "#/$defs/NullableId"
    },
    "run_id": {
      "$ref": "#/$defs/Id"
    },
    "step_id": {
      "$ref": "#/$defs/Id"
    },
    "input_manifest_sha256": {
      "$ref": "#/$defs/Hash"
    },
    "plan_revision": {
      "$ref": "#/$defs/NullableId"
    },
    "snapshot_id": {
      "$ref": "#/$defs/NullableId"
    },
    "target_section_ids": {
      "$ref": "#/$defs/Ids"
    },
    "dependency_access_set_id": {
      "$ref": "#/$defs/Id"
    },
    "content_sha256": {
      "$ref": "#/$defs/Hash"
    },
    "output": {
      "$ref": "#/$defs/ArtifactOutput"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "execution_kind": {
            "const": "TASK"
          }
        }
      },
      "then": {
        "properties": {
          "project_id": {
            "$ref": "#/$defs/Id"
          },
          "plan_revision": {
            "$ref": "#/$defs/Id"
          },
          "snapshot_id": {
            "$ref": "#/$defs/Id"
          }
        }
      }
    }
  ],
  "$defs": {
    "Id": {
      "type": "string",
      "format": "uuid"
    },
    "NullableId": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "Ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/Id"
      }
    },
    "Text": {
      "type": "string",
      "minLength": 1
    },
    "NullableText": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "Hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "Decimal": {
      "type": "string",
      "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"
    },
    "Key": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
    },
    "Keys": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/Key"
      }
    },
    "EvidenceRef": {
      "$ref": "https://schemas.medical-agent.invalid/2.0.0/source-evidence#/$defs/EvidenceRef"
    },
    "EvidenceRefs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/EvidenceRef"
      }
    },
    "ObjectRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "object_key",
        "object_version",
        "sha256",
        "size_bytes",
        "media_type"
      ],
      "properties": {
        "object_key": {
          "$ref": "#/$defs/Text"
        },
        "object_version": {
          "$ref": "#/$defs/Text"
        },
        "sha256": {
          "$ref": "#/$defs/Hash"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "media_type": {
          "$ref": "#/$defs/Text"
        }
      }
    },
    "ArtifactOutput": {
      "oneOf": [
        {
          "$ref": "#/$defs/PlanOutput"
        },
        {
          "$ref": "#/$defs/EvidenceOutput"
        },
        {
          "$ref": "#/$defs/FieldOutput"
        },
        {
          "$ref": "#/$defs/SectionOutput"
        },
        {
          "$ref": "#/$defs/ClaimOutput"
        },
        {
          "$ref": "#/$defs/ReviewOutput"
        },
        {
          "$ref": "#/$defs/AssemblyOutput"
        },
        {
          "$ref": "#/$defs/HandoffOutput"
        }
      ]
    },
    "PlanOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_kind",
        "content"
      ],
      "properties": {
        "artifact_kind": {
          "const": "PLAN_CANDIDATE"
        },
        "content": {
          "$ref": "#/$defs/PlanCandidate"
        }
      }
    },
    "EvidenceOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_kind",
        "content"
      ],
      "properties": {
        "artifact_kind": {
          "const": "EVIDENCE_BUNDLE"
        },
        "content": {
          "$ref": "#/$defs/EvidenceBundle"
        }
      }
    },
    "FieldOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_kind",
        "content"
      ],
      "properties": {
        "artifact_kind": {
          "const": "FIELD_CHECK_RESULT"
        },
        "content": {
          "$ref": "#/$defs/FieldCheckResult"
        }
      }
    },
    "SectionOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_kind",
        "content"
      ],
      "properties": {
        "artifact_kind": {
          "const": "SECTION_CANDIDATE"
        },
        "content": {
          "$ref": "#/$defs/SectionCandidate"
        }
      }
    },
    "ClaimOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_kind",
        "content"
      ],
      "properties": {
        "artifact_kind": {
          "const": "CLAIM_RECORD"
        },
        "content": {
          "$ref": "#/$defs/ClaimRecord"
        }
      }
    },
    "ReviewOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_kind",
        "content"
      ],
      "properties": {
        "artifact_kind": {
          "const": "REVIEW_FINDINGS"
        },
        "content": {
          "$ref": "#/$defs/ReviewFindings"
        }
      }
    },
    "AssemblyOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_kind",
        "content"
      ],
      "properties": {
        "artifact_kind": {
          "const": "ASSEMBLY_MANIFEST"
        },
        "content": {
          "$ref": "#/$defs/AssemblyManifest"
        }
      }
    },
    "HandoffOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_kind",
        "content"
      ],
      "properties": {
        "artifact_kind": {
          "const": "HANDOFF_RECORD"
        },
        "content": {
          "$ref": "#/$defs/HandoffRecord"
        }
      }
    },
    "PlanCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "template_version",
        "profile_revision",
        "requirement_node_ids",
        "sections",
        "questions",
        "pending_condition_ids"
      ],
      "properties": {
        "template_version": {
          "$ref": "#/$defs/Id"
        },
        "profile_revision": {
          "$ref": "#/$defs/Id"
        },
        "requirement_node_ids": {
          "$ref": "#/$defs/Ids"
        },
        "sections": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/PlanSection"
          }
        },
        "questions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ResearchQuestion"
          }
        },
        "pending_condition_ids": {
          "$ref": "#/$defs/Ids"
        }
      }
    },
    "PlanSection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "section_id",
        "requirement_node_ids",
        "goal",
        "owner_id",
        "method",
        "depends_on_section_ids",
        "completion_rule_ids"
      ],
      "properties": {
        "section_id": {
          "$ref": "#/$defs/Id"
        },
        "requirement_node_ids": {
          "$ref": "#/$defs/Ids"
        },
        "goal": {
          "$ref": "#/$defs/Text"
        },
        "owner_id": {
          "$ref": "#/$defs/NullableId"
        },
        "method": {
          "enum": [
            "DETERMINISTIC",
            "MODEL_ASSISTED",
            "HUMAN_PROVIDED"
          ]
        },
        "depends_on_section_ids": {
          "$ref": "#/$defs/Ids"
        },
        "completion_rule_ids": {
          "$ref": "#/$defs/Ids"
        }
      }
    },
    "ResearchQuestion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "question_key",
        "section_id",
        "question",
        "requirement_ids",
        "completion_rule_ids",
        "depends_on_question_keys"
      ],
      "properties": {
        "question_key": {
          "$ref": "#/$defs/Key"
        },
        "section_id": {
          "$ref": "#/$defs/Id"
        },
        "question": {
          "$ref": "#/$defs/Text"
        },
        "requirement_ids": {
          "$ref": "#/$defs/Ids"
        },
        "completion_rule_ids": {
          "$ref": "#/$defs/Ids"
        },
        "depends_on_question_keys": {
          "$ref": "#/$defs/Keys"
        }
      }
    },
    "EvidenceLink": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_ref",
        "relation"
      ],
      "properties": {
        "evidence_ref": {
          "$ref": "#/$defs/EvidenceRef"
        },
        "relation": {
          "enum": [
            "SUPPORT",
            "CONFLICT",
            "BACKGROUND"
          ]
        }
      }
    },
    "EvidenceBundle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "retrieval_ids",
        "question_coverage",
        "selected_refs",
        "conflict_refs",
        "missing_requirement_ids",
        "read_receipt_ids"
      ],
      "properties": {
        "retrieval_ids": {
          "$ref": "#/$defs/Ids"
        },
        "question_coverage": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/QuestionCoverage"
          }
        },
        "selected_refs": {
          "$ref": "#/$defs/EvidenceRefs"
        },
        "conflict_refs": {
          "$ref": "#/$defs/EvidenceRefs"
        },
        "missing_requirement_ids": {
          "$ref": "#/$defs/Ids"
        },
        "read_receipt_ids": {
          "$ref": "#/$defs/Ids"
        }
      }
    },
    "QuestionCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "question_id",
        "status",
        "evidence_links",
        "completion_check_ids",
        "missing_requirement_ids"
      ],
      "properties": {
        "question_id": {
          "$ref": "#/$defs/Id"
        },
        "status": {
          "enum": [
            "VERIFIED",
            "INSUFFICIENT",
            "CONFLICT"
          ]
        },
        "evidence_links": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EvidenceLink"
          }
        },
        "completion_check_ids": {
          "$ref": "#/$defs/Ids"
        },
        "missing_requirement_ids": {
          "$ref": "#/$defs/Ids"
        }
      }
    },
    "FieldValue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value_kind",
        "raw_text",
        "decimal_value",
        "precision",
        "unit",
        "selected_ids",
        "object_ref"
      ],
      "properties": {
        "value_kind": {
          "enum": [
            "TEXT",
            "LONG_TEXT",
            "DATE",
            "DECIMAL",
            "ENUM",
            "MULTISELECT",
            "RELATION",
            "TABLE",
            "IMAGE",
            "FORMULA",
            "FILE",
            "EMPTY"
          ]
        },
        "raw_text": {
          "$ref": "#/$defs/NullableText"
        },
        "decimal_value": {
          "anyOf": [
            {
              "$ref": "#/$defs/Decimal"
            },
            {
              "type": "null"
            }
          ]
        },
        "precision": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "unit": {
          "$ref": "#/$defs/NullableText"
        },
        "selected_ids": {
          "$ref": "#/$defs/Ids"
        },
        "object_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ObjectRef"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "value_kind": {
                "const": "DECIMAL"
              }
            }
          },
          "then": {
            "properties": {
              "raw_text": {
                "$ref": "#/$defs/Text"
              },
              "decimal_value": {
                "$ref": "#/$defs/Decimal"
              },
              "precision": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      ]
    },
    "FieldCheckResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_artifact_id",
        "rule_revision",
        "entries",
        "method_coverage",
        "missing_requirement_ids"
      ],
      "properties": {
        "target_artifact_id": {
          "$ref": "#/$defs/Id"
        },
        "rule_revision": {
          "$ref": "#/$defs/Id"
        },
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FieldComparison"
          }
        },
        "method_coverage": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MethodCoverage"
          }
        },
        "missing_requirement_ids": {
          "$ref": "#/$defs/Ids"
        }
      }
    },
    "FieldComparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field_id",
        "row_id",
        "model_ids",
        "condition_ids",
        "source_value",
        "candidate_value",
        "comparison_rule_id",
        "conversion_rule_id",
        "result",
        "evidence_refs"
      ],
      "properties": {
        "field_id": {
          "$ref": "#/$defs/Id"
        },
        "row_id": {
          "$ref": "#/$defs/NullableId"
        },
        "model_ids": {
          "$ref": "#/$defs/Ids"
        },
        "condition_ids": {
          "$ref": "#/$defs/Ids"
        },
        "source_value": {
          "$ref": "#/$defs/FieldValue"
        },
        "candidate_value": {
          "$ref": "#/$defs/FieldValue"
        },
        "comparison_rule_id": {
          "$ref": "#/$defs/Id"
        },
        "conversion_rule_id": {
          "$ref": "#/$defs/NullableId"
        },
        "result": {
          "enum": [
            "MATCH",
            "CONFLICT",
            "MISSING",
            "UNKNOWN_CONDITION",
            "NOT_APPLICABLE"
          ]
        },
        "evidence_refs": {
          "$ref": "#/$defs/EvidenceRefs"
        }
      }
    },
    "MethodCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "indicator_id",
        "model_id",
        "condition_id",
        "method_ids",
        "evidence_refs",
        "result"
      ],
      "properties": {
        "indicator_id": {
          "$ref": "#/$defs/Id"
        },
        "model_id": {
          "$ref": "#/$defs/Id"
        },
        "condition_id": {
          "$ref": "#/$defs/Id"
        },
        "method_ids": {
          "$ref": "#/$defs/Ids"
        },
        "evidence_refs": {
          "$ref": "#/$defs/EvidenceRefs"
        },
        "result": {
          "enum": [
            "COMPLETE",
            "INCOMPLETE",
            "UNKNOWN_CONDITION"
          ]
        }
      }
    },
    "TextAnchor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "node_id",
        "start",
        "end",
        "text_sha256"
      ],
      "properties": {
        "kind": {
          "const": "TEXT"
        },
        "node_id": {
          "$ref": "#/$defs/Id"
        },
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "minimum": 1
        },
        "text_sha256": {
          "$ref": "#/$defs/Hash"
        }
      }
    },
    "StructuredAnchor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "node_id",
        "row_id",
        "field_id",
        "content_sha256"
      ],
      "properties": {
        "kind": {
          "const": "STRUCTURED"
        },
        "node_id": {
          "$ref": "#/$defs/Id"
        },
        "row_id": {
          "$ref": "#/$defs/NullableId"
        },
        "field_id": {
          "$ref": "#/$defs/NullableId"
        },
        "content_sha256": {
          "$ref": "#/$defs/Hash"
        }
      }
    },
    "Anchor": {
      "oneOf": [
        {
          "$ref": "#/$defs/TextAnchor"
        },
        {
          "$ref": "#/$defs/StructuredAnchor"
        }
      ]
    },
    "ClaimRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_id",
        "anchor",
        "claim_kind",
        "evidence_links"
      ],
      "properties": {
        "claim_id": {
          "$ref": "#/$defs/Id"
        },
        "anchor": {
          "$ref": "#/$defs/Anchor"
        },
        "claim_kind": {
          "enum": [
            "PRODUCT_FACT",
            "REGULATORY_REQUIREMENT",
            "METHOD_REQUIREMENT",
            "STUDY_RESULT",
            "TRANSITION"
          ]
        },
        "evidence_links": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EvidenceLink"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "claim_kind": {
                "enum": [
                  "PRODUCT_FACT",
                  "REGULATORY_REQUIREMENT",
                  "METHOD_REQUIREMENT",
                  "STUDY_RESULT"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "evidence_links": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "NodeManifestItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node_id",
        "parent_id",
        "section_id",
        "kind",
        "field_id",
        "row_id",
        "content_sha256"
      ],
      "properties": {
        "node_id": {
          "$ref": "#/$defs/Id"
        },
        "parent_id": {
          "$ref": "#/$defs/NullableId"
        },
        "section_id": {
          "$ref": "#/$defs/Id"
        },
        "kind": {
          "enum": [
            "ROOT",
            "SECTION",
            "PARAGRAPH",
            "TEXT",
            "TABLE",
            "ROW",
            "CELL",
            "IMAGE",
            "FORMULA",
            "LIST",
            "ITEM",
            "ATTACHMENT"
          ]
        },
        "field_id": {
          "$ref": "#/$defs/NullableId"
        },
        "row_id": {
          "$ref": "#/$defs/NullableId"
        },
        "content_sha256": {
          "$ref": "#/$defs/Hash"
        }
      }
    },
    "FieldAssignment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field_id",
        "row_id",
        "node_id",
        "fact_version",
        "value",
        "evidence_refs"
      ],
      "properties": {
        "field_id": {
          "$ref": "#/$defs/Id"
        },
        "row_id": {
          "$ref": "#/$defs/NullableId"
        },
        "node_id": {
          "$ref": "#/$defs/Id"
        },
        "fact_version": {
          "$ref": "#/$defs/NullableId"
        },
        "value": {
          "$ref": "#/$defs/FieldValue"
        },
        "evidence_refs": {
          "$ref": "#/$defs/EvidenceRefs"
        }
      }
    },
    "AttachmentBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requirement_id",
        "node_id",
        "source_version",
        "evidence_refs"
      ],
      "properties": {
        "requirement_id": {
          "$ref": "#/$defs/Id"
        },
        "node_id": {
          "$ref": "#/$defs/Id"
        },
        "source_version": {
          "$ref": "#/$defs/Id"
        },
        "evidence_refs": {
          "$ref": "#/$defs/EvidenceRefs"
        }
      }
    },
    "IssueProposal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issue_key",
        "code",
        "severity_code",
        "rule_id",
        "anchor",
        "claim_ids",
        "message",
        "evidence_refs"
      ],
      "properties": {
        "issue_key": {
          "$ref": "#/$defs/Key"
        },
        "code": {
          "$ref": "#/$defs/Text"
        },
        "severity_code": {
          "$ref": "#/$defs/Text"
        },
        "rule_id": {
          "$ref": "#/$defs/Id"
        },
        "anchor": {
          "$ref": "#/$defs/Anchor"
        },
        "claim_ids": {
          "$ref": "#/$defs/Ids"
        },
        "message": {
          "$ref": "#/$defs/Text"
        },
        "evidence_refs": {
          "$ref": "#/$defs/EvidenceRefs"
        }
      }
    },
    "SectionDraft": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "body_schema_revision",
        "body_json",
        "claim_records",
        "field_assignments",
        "attachment_bindings",
        "issue_proposals"
      ],
      "properties": {
        "body_schema_revision": {
          "$ref": "#/$defs/Id"
        },
        "body_json": {
          "$ref": "#/$defs/Text"
