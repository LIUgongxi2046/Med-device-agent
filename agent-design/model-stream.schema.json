{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EnterpriseModelProtocol",
  "oneOf": [{"$ref": "#/$defs/StreamRequest"}, {"$ref": "#/$defs/StreamEvent"}, {"$ref": "#/$defs/ModelResult"}, {"$ref": "#/$defs/InvocationStatus"}, {"$ref": "#/$defs/CancelRequest"}],
  "$defs": {
    "Id": {"type": "string", "format": "uuid"},
    "Text": {"type": "string", "minLength": 1},
    "NullableText": {"type": ["string", "null"], "minLength": 1},
    "Hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "TokenCount": {"type": ["integer", "null"], "minimum": 0},
    "StreamRequest": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "run_id", "step_id", "action_id", "context_manifest_id", "model_config_revision", "request_parameters", "lease_generation"],
      "properties": {
        "schema_version": {"const": "1.0.0"}, "run_id": {"$ref": "#/$defs/Id"}, "step_id": {"$ref": "#/$defs/Id"},
        "action_id": {"$ref": "#/$defs/Id"}, "context_manifest_id": {"$ref": "#/$defs/Id"}, "model_config_revision": {"$ref": "#/$defs/Id"},
        "request_parameters": {"$ref": "#/$defs/RequestParameters"}, "lease_generation": {"type": "integer", "minimum": 1}
      }
    },
    "RequestParameters": {
      "type": "object", "additionalProperties": false,
      "required": ["max_output_tokens", "temperature", "reasoning_effort", "stop", "purpose"],
      "properties": {
        "max_output_tokens": {"type": "integer", "minimum": 1},
        "temperature": {"type": ["number", "null"]}, "reasoning_effort": {"$ref": "#/$defs/NullableText"},
        "stop": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/Text"}},
        "purpose": {"enum": ["TASK", "COMPACTION", "VERIFICATION", "EVALUATION"]}
      }
    },
    "CancelRequest": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "run_id", "step_id", "action_id", "invocation_id", "reason_code", "lease_generation"],
      "properties": {
        "schema_version": {"const": "1.0.0"}, "run_id": {"$ref": "#/$defs/Id"}, "step_id": {"$ref": "#/$defs/Id"},
        "action_id": {"$ref": "#/$defs/Id"}, "invocation_id": {"$ref": "#/$defs/Id"},
        "reason_code": {"enum": ["RUN_CANCEL_REQUESTED", "DEADLINE_EXCEEDED", "AUTH_REVOKED", "PROTOCOL_ERROR"]},
        "lease_generation": {"type": "integer", "minimum": 1}
      }
    },
    "InvocationStatus": {
      "type": "object", "additionalProperties": false,
      "required": ["invocation_id", "origin_action_id", "context_manifest_id", "model_config_revision", "execution_status", "settlement_status", "provider_request_id", "result_artifact_id", "result_sha256", "failure_code"],
      "properties": {
        "invocation_id": {"$ref": "#/$defs/Id"}, "origin_action_id": {"$ref": "#/$defs/Id"},
        "context_manifest_id": {"$ref": "#/$defs/Id"}, "model_config_revision": {"$ref": "#/$defs/Id"},
        "execution_status": {"enum": ["RESERVED", "DISPATCHING", "IN_FLIGHT", "SUCCEEDED", "FAILED", "CANCEL_REQUESTED", "CANCELLED", "UNKNOWN"]},
        "settlement_status": {"enum": ["PENDING", "SETTLED", "DISPUTED"]},
        "provider_request_id": {"$ref": "#/$defs/NullableText"},
        "result_artifact_id": {"type": ["string", "null"], "format": "uuid"},
        "result_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
        "failure_code": {"$ref": "#/$defs/NullableText"}
      }
    },
    "Failure": {
      "type": "object", "additionalProperties": false,
      "required": ["code", "message", "provider_status", "provider_request_id"],
      "properties": {"code": {"$ref": "#/$defs/Text"}, "message": {"$ref": "#/$defs/Text"}, "provider_status": {"type": ["integer", "null"], "minimum": 100, "maximum": 599}, "provider_request_id": {"$ref": "#/$defs/NullableText"}}
    },
    "TextBlock": {
      "type": "object", "additionalProperties": false, "required": ["type", "text"],
      "properties": {"type": {"const": "text"}, "text": {"type": "string"}}
    },
    "ToolBlock": {
      "type": "object", "additionalProperties": false, "required": ["type", "id", "name", "arguments"],
      "properties": {"type": {"const": "tool-call"}, "id": {"$ref": "#/$defs/Text"}, "name": {"$ref": "#/$defs/Text"}, "arguments": {"$ref": "#/$defs/Text"}}
    },
    "Block": {"oneOf": [{"$ref": "#/$defs/TextBlock"}, {"$ref": "#/$defs/ToolBlock"}]},
    "Usage": {
      "type": "object", "additionalProperties": false,
      "required": ["uncached_input_tokens", "cache_read_tokens", "cache_write_tokens", "output_tokens", "total_tokens", "reasoning_tokens", "source_receipt_id"],
      "properties": {
        "uncached_input_tokens": {"$ref": "#/$defs/TokenCount"}, "cache_read_tokens": {"$ref": "#/$defs/TokenCount"}, "cache_write_tokens": {"$ref": "#/$defs/TokenCount"},
        "output_tokens": {"$ref": "#/$defs/TokenCount"}, "total_tokens": {"$ref": "#/$defs/TokenCount"}, "reasoning_tokens": {"$ref": "#/$defs/TokenCount"},
        "source_receipt_id": {"$ref": "#/$defs/Id"}
      }
    },
    "FinishReason": {
      "type": "object", "additionalProperties": false, "required": ["kind", "failure"],
      "properties": {"kind": {"enum": ["stop", "tool-calls", "max-tokens", "aborted", "error"]}, "failure": {"anyOf": [{"$ref": "#/$defs/Failure"}, {"type": "null"}]}},
      "allOf": [{"if": {"properties": {"kind": {"enum": ["aborted", "error"]}}}, "then": {"properties": {"failure": {"$ref": "#/$defs/Failure"}}}, "else": {"properties": {"failure": {"type": "null"}}}}]
    },
    "Accepted": {
      "type": "object", "additionalProperties": false, "required": ["type", "execution_status"],
      "properties": {"type": {"const": "accepted"}, "execution_status": {"enum": ["RESERVED", "DISPATCHING", "IN_FLIGHT"]}}
    },
    "BlockStart": {
      "type": "object", "additionalProperties": false, "required": ["type", "index", "block_type"],
      "properties": {"type": {"const": "block_start"}, "index": {"type": "integer", "minimum": 0}, "block_type": {"enum": ["text", "tool-call"]}}
    },
    "TextDelta": {
      "type": "object", "additionalProperties": false, "required": ["type", "index", "text"],
      "properties": {"type": {"const": "text_delta"}, "index": {"type": "integer", "minimum": 0}, "text": {"$ref": "#/$defs/Text"}}
    },
    "ToolDelta": {
      "type": "object", "additionalProperties": false, "required": ["type", "index", "call_id", "name", "arguments_delta"],
      "properties": {"type": {"const": "tool_call_delta"}, "index": {"type": "integer", "minimum": 0}, "call_id": {"$ref": "#/$defs/Text"}, "name": {"$ref": "#/$defs/NullableText"}, "arguments_delta": {"type": "string"}}
    },
    "BlockEnd": {
      "type": "object", "additionalProperties": false, "required": ["type", "index", "block"],
      "properties": {"type": {"const": "block_end"}, "index": {"type": "integer", "minimum": 0}, "block": {"$ref": "#/$defs/Block"}}
    },
    "UsageEvent": {
      "type": "object", "additionalProperties": false, "required": ["type", "usage"],
      "properties": {"type": {"const": "usage"}, "usage": {"$ref": "#/$defs/Usage"}}
    },
    "FinishEvent": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "reason", "execution_status", "settlement_status", "result_artifact_id", "result_sha256", "replay_state_id"],
      "properties": {
        "type": {"const": "finish"}, "reason": {"$ref": "#/$defs/FinishReason"},
        "execution_status": {"enum": ["SUCCEEDED", "FAILED", "CANCELLED"]}, "settlement_status": {"enum": ["PENDING", "SETTLED", "DISPUTED"]},
        "result_artifact_id": {"$ref": "#/$defs/Id"}, "result_sha256": {"$ref": "#/$defs/Hash"}, "replay_state_id": {"type": ["string", "null"], "format": "uuid"}
      },
      "allOf": [
        {"if": {"properties": {"reason": {"properties": {"kind": {"enum": ["stop", "tool-calls", "max-tokens"]}}}}}, "then": {"properties": {"execution_status": {"const": "SUCCEEDED"}}}},
        {"if": {"properties": {"reason": {"properties": {"kind": {"const": "error"}}}}}, "then": {"properties": {"execution_status": {"const": "FAILED"}}}},
        {"if": {"properties": {"reason": {"properties": {"kind": {"const": "aborted"}}}}}, "then": {"properties": {"execution_status": {"const": "CANCELLED"}}}}
      ]
    },
    "ErrorEvent": {
      "type": "object", "additionalProperties": false, "required": ["type", "failure", "execution_status", "settlement_status"],
      "properties": {"type": {"const": "error"}, "failure": {"$ref": "#/$defs/Failure"}, "execution_status": {"enum": ["FAILED", "UNKNOWN", "CANCEL_REQUESTED"]}, "settlement_status": {"enum": ["PENDING", "SETTLED", "DISPUTED"]}}
    },
    "StreamEvent": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "invocation_id", "run_id", "step_id", "action_id", "context_manifest_id", "model_config_revision", "sequence", "emitted_at", "payload"],
      "properties": {
        "schema_version": {"const": "1.0.0"}, "invocation_id": {"$ref": "#/$defs/Id"}, "run_id": {"$ref": "#/$defs/Id"}, "step_id": {"$ref": "#/$defs/Id"},
        "action_id": {"$ref": "#/$defs/Id"}, "context_manifest_id": {"$ref": "#/$defs/Id"}, "model_config_revision": {"$ref": "#/$defs/Id"},
        "sequence": {"type": "integer", "minimum": 0}, "emitted_at": {"type": "string", "format": "date-time"},
        "payload": {"oneOf": [{"$ref": "#/$defs/Accepted"}, {"$ref": "#/$defs/BlockStart"}, {"$ref": "#/$defs/TextDelta"}, {"$ref": "#/$defs/ToolDelta"}, {"$ref": "#/$defs/BlockEnd"}, {"$ref": "#/$defs/UsageEvent"}, {"$ref": "#/$defs/FinishEvent"}, {"$ref": "#/$defs/ErrorEvent"}]}
      }
    },
    "ModelResult": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "invocation_id", "context_manifest_id", "model_config_revision", "provider_request_id", "blocks", "usage", "reason", "replay_state_id"],
      "properties": {
        "schema_version": {"const": "1.0.0"}, "invocation_id": {"$ref": "#/$defs/Id"}, "context_manifest_id": {"$ref": "#/$defs/Id"}, "model_config_revision": {"$ref": "#/$defs/Id"},
        "provider_request_id": {"$ref": "#/$defs/NullableText"}, "blocks": {"type": "array", "items": {"$ref": "#/$defs/Block"}},
        "usage": {"anyOf": [{"$ref": "#/$defs/Usage"}, {"type": "null"}]}, "reason": {"$ref": "#/$defs/FinishReason"}, "replay_state_id": {"type": ["string", "null"], "format": "uuid"}
      }
    }
  }
}
