{
  "$defs": {
    "AssistantMessage": {
      "additionalProperties": false,
      "properties": {
        "role": {
          "const": "assistant",
          "title": "Role",
          "type": "string"
        },
        "content": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Content"
        },
        "tool_calls": {
          "items": {
            "$ref": "#/$defs/ToolCall"
          },
          "title": "Tool Calls",
          "type": "array"
        }
      },
      "required": [
        "role",
        "content",
        "tool_calls"
      ],
      "title": "AssistantMessage",
      "type": "object"
    },
    "ExactInput": {
      "additionalProperties": false,
      "properties": {
        "messages": {
          "items": {
            "discriminator": {
              "mapping": {
                "assistant": "#/$defs/AssistantMessage",
                "system": "#/$defs/PlainMessage",
                "tool": "#/$defs/ToolMessage",
                "user": "#/$defs/PlainMessage"
              },
              "propertyName": "role"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/PlainMessage"
              },
              {
                "$ref": "#/$defs/AssistantMessage"
              },
              {
                "$ref": "#/$defs/ToolMessage"
              }
            ]
          },
          "minItems": 1,
          "title": "Messages",
          "type": "array"
        },
        "tools": {
          "items": {
            "$ref": "#/$defs/ToolDefinition"
          },
          "title": "Tools",
          "type": "array"
        }
      },
      "required": [
        "messages",
        "tools"
      ],
      "title": "ExactInput",
      "type": "object"
    },
    "Failure": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "provider_status": {
          "anyOf": [
            {
              "maximum": 599,
              "minimum": 100,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Provider Status"
        },
        "provider_request_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Provider Request Id"
        }
      },
      "required": [
        "code",
        "message",
        "provider_status",
        "provider_request_id"
      ],
      "title": "Failure",
      "type": "object"
    },
    "FinishReason": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "stop",
            "tool-calls",
            "max-tokens",
            "aborted",
            "error"
          ],
          "title": "Kind",
          "type": "string"
        },
        "failure": {
          "anyOf": [
            {
              "$ref": "#/$defs/Failure"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "kind",
        "failure"
      ],
      "title": "FinishReason",
      "type": "object"
    },
    "FunctionCall": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "arguments": {
          "minLength": 1,
          "title": "Arguments",
          "type": "string"
        }
      },
      "required": [
        "name",
        "arguments"
      ],
      "title": "FunctionCall",
      "type": "object"
    },
    "FunctionDefinition": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "pattern": "^[A-Za-z0-9_-]{1,128}$",
          "title": "Name",
          "type": "string"
        },
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "parameters": {
          "additionalProperties": true,
          "title": "Parameters",
          "type": "object"
        }
      },
      "required": [
        "name",
        "description",
        "parameters"
      ],
      "title": "FunctionDefinition",
      "type": "object"
    },
    "ModelResult": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "invocation_id": {
          "title": "Invocation Id",
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "context_manifest_id": {
          "title": "Context Manifest Id",
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "model_config_revision": {
          "title": "Model Config Revision",
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "provider_request_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Provider Request Id"
        },
        "blocks": {
          "items": {
            "discriminator": {
              "mapping": {
                "text": "#/$defs/TextBlock",
                "tool-call": "#/$defs/ToolBlock"
              },
              "propertyName": "type"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/TextBlock"
              },
              {
                "$ref": "#/$defs/ToolBlock"
              }
            ]
          },
          "title": "Blocks",
          "type": "array"
        },
        "usage": {
          "anyOf": [
            {
              "$ref": "#/$defs/Usage"
            },
            {
              "type": "null"
            }
          ]
        },
        "reason": {
          "$ref": "#/$defs/FinishReason"
        },
        "replay_state_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            },
            {
              "type": "null"
            }
          ],
          "title": "Replay State Id"
        }
      },
      "required": [
        "schema_version",
        "invocation_id",
        "context_manifest_id",
        "model_config_revision",
        "provider_request_id",
        "blocks",
        "usage",
        "reason",
        "replay_state_id"
      ],
      "title": "ModelResult",
      "type": "object"
    },
    "PlainMessage": {
      "additionalProperties": false,
      "properties": {
        "role": {
          "enum": [
            "system",
            "user"
          ],
          "title": "Role",
          "type": "string"
        },
        "content": {
          "minLength": 1,
          "title": "Content",
          "type": "string"
        }
      },
      "required": [
        "role",
        "content"
      ],
      "title": "PlainMessage",
      "type": "object"
    },
    "TextBlock": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "text",
          "title": "Type",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "type",
        "text"
      ],
      "title": "TextBlock",
      "type": "object"
    },
    "ToolBlock": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "tool-call",
          "title": "Type",
          "type": "string"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "arguments": {
          "minLength": 1,
          "title": "Arguments",
          "type": "string"
        }
      },
      "required": [
        "type",
        "id",
        "name",
        "arguments"
      ],
      "title": "ToolBlock",
      "type": "object"
    },
    "ToolCall": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "type": {
          "const": "function",
          "title": "Type",
          "type": "string"
        },
        "function": {
          "$ref": "#/$defs/FunctionCall"
        }
      },
      "required": [
        "id",
        "type",
        "function"
      ],
      "title": "ToolCall",
      "type": "object"
    },
    "ToolDefinition": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "function",
          "title": "Type",
          "type": "string"
        },
        "function": {
          "$ref": "#/$defs/FunctionDefinition"
        }
      },
      "required": [
        "type",
        "function"
      ],
      "title": "ToolDefinition",
      "type": "object"
    },
    "ToolMessage": {
      "additionalProperties": false,
      "properties": {
        "role": {
          "const": "tool",
          "title": "Role",
          "type": "string"
        },
        "content": {
          "title": "Content",
          "type": "string"
        },
        "tool_call_id": {
          "minLength": 1,
          "title": "Tool Call Id",
          "type": "string"
        }
      },
      "required": [
        "role",
        "content",
        "tool_call_id"
      ],
      "title": "ToolMessage",
      "type": "object"
    },
    "Usage": {
      "additionalProperties": false,
      "properties": {
        "uncached_input_tokens": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Uncached Input Tokens"
        },
        "cache_read_tokens": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Cache Read Tokens"
        },
        "cache_write_tokens": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Cache Write Tokens"
        },
        "output_tokens": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Output Tokens"
        },
        "total_tokens": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Total Tokens"
        },
        "reasoning_tokens": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reasoning Tokens"
        },
        "source_receipt_id": {
          "title": "Source Receipt Id",
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        }
      },
      "required": [
        "uncached_input_tokens",
        "cache_read_tokens",
        "cache_write_tokens",
        "output_tokens",
        "total_tokens",
        "reasoning_tokens",
        "source_receipt_id"
      ],
      "title": "Usage",
      "type": "object"
    }
  },
  "anyOf": [
    {
      "$ref": "#/$defs/ExactInput"
    },
    {
      "$ref": "#/$defs/ModelResult"
    }
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:medical:simulation-byte-measurement:1.0.0",
  "description": "Count bytes of RFC8785 UTF-8 canonical JSON, without BOM, newline or Unicode normalization. These are local simulation units, never provider tokens."
}
